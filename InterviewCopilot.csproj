<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <Product>Replysis AI</Product>
    <ApplicationIcon>Assets\replysis.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.cs is the entry point instead of the one generated from
         App.xaml, so the updater's hooks can run before any app code. The
         ApplicationDefinition below is downgraded to a Page to stop the build
         generating a competing Main. -->
    <StartupObject>InterviewCopilot.Program</StartupObject>
    <!-- Must stay equal to Identity/@Version in
         InterviewCopilotPackager\Package.appxmanifest. The in-app update check
         compares this against the latest windows-v* release tag, so if the two
         drift the app reports the wrong installed version. -->
    <Version>1.0.17.0</Version>
    <AssemblyVersion>1.0.17.0</AssemblyVersion>
    <FileVersion>1.0.17.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="speechmatics_engine.py" />
  </ItemGroup>

  <!--
    The test projects live under tests/ and build against this one. Without
    this they are also swallowed BY it: the default glob picks up their .cs
    files and their obj/ folders, and the generated assembly attributes then
    collide with this project's own. The app must not compile its own tests.
  -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Page Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\replysis-icon-1024.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="speechmatics_engine.py">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="requirements.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- The self-contained speech engine, built by tools\build-engine.ps1.
         Without this the app shipped only the .py script and needed Python plus
         PyAudio already installed on the machine, so transcription could not
         work on a customer's PC at all. Ships under engine\ next to the app;
         if the folder is absent the app still falls back to a system Python. -->
    <Content Include="engine-dist\speechmatics_engine\**\*">
      <Link>engine\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="System.Speech" Version="9.0.3" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\intro.mp4">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="latest.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="volume.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
