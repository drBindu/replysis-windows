<Window x:Class="InterviewCopilot.UpdateRequiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replysis AI"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" Topmost="True">
    <Border Background="#0B1320" BorderBrush="#26354A" BorderThickness="1"
            CornerRadius="18" Padding="26">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.62" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Width="34" Height="34" Margin="0,0,12,0"
                       Source="pack://siteoforigin:,,,/Assets/replysis-icon-1024.png"
                       Stretch="Uniform" SnapsToDevicePixels="True"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Replysis AI" Foreground="#F4F7FB" FontSize="16"
                               FontWeight="SemiBold" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="VersionLine" Foreground="#93A4BA" FontSize="11"
                               FontFamily="Segoe UI" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Update required" Foreground="#FFFFFF" FontSize="22"
                       FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,22,0,0"/>

            <TextBlock x:Name="BodyText" Foreground="#C3D0E0" FontSize="13"
                       FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="This version can no longer connect to Replysis. Installing the update takes about a minute and keeps your sessions and settings."/>

            <!-- The bar only appears once an install is actually running. An
                 empty progress bar sitting under a button reads as a hang. -->
            <StackPanel x:Name="ProgressArea" Visibility="Collapsed" Margin="0,18,0,0">
                <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="1"
                             Background="#101D2D" BorderThickness="0" Foreground="#34E08A"/>
                <TextBlock x:Name="ProgressText" Foreground="#93A4BA" FontSize="11"
                           FontFamily="Segoe UI" Margin="0,8,0,0" Text="Downloading"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#FF6B73" FontSize="12"
                       FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,14,0,0"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="StoreBtn" Content="Open Microsoft Store" Margin="0,0,10,0"
                        Style="{StaticResource PremiumSecondaryButton}"
                        Visibility="Collapsed" Click="StoreBtn_Click"/>
                <Button x:Name="QuitBtn" Content="Close" Margin="0,0,10,0"
                        Style="{StaticResource PremiumSecondaryButton}" Click="QuitBtn_Click"/>
                <Button x:Name="UpdateBtn" Content="Update now"
                        Style="{StaticResource PremiumPrimaryButton}" Click="UpdateBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
