<Window x:Class="InterviewCopilot.AnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Overlay"
        Height="560" Width="560"
        MinHeight="560" MinWidth="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">

    <Grid>
        <Border x:Name="MainBorder"
                BorderBrush="#66FFFFFF"
                BorderThickness="1.5"
                CornerRadius="18"
                Opacity="0">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F0030712" Offset="0"/>
                    <GradientStop Color="#F0050F1E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="18,12,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <DockPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Left"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="MiniMicIndicator"
                                 Width="9" Height="9"
                                 Fill="#EF4444"
                                 Margin="0,0,7,0">
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="MiniMicGlow"
                                                  Color="#EF4444"
                                                  BlurRadius="10"
                                                  ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="MicStatusLabel"
                                   Text="READY"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center"
                                   Opacity="0.9"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            Foreground="#888888"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="HideOverlay_Click"
                            HorizontalAlignment="Right"
                            Cursor="Hand"
                            FontSize="13"
                            Padding="6,2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#AAFF0000"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock DockPanel.Dock="Left"
                               Text="Interview Copilot"
                               Foreground="#33FFFFFF"
                               FontSize="10"
                               FontFamily="Segoe UI"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </DockPanel>

                <!-- DIVIDER -->
                <Border Grid.Row="1"
                        Height="1"
                        VerticalAlignment="Center"
                        Background="#22FFFFFF"
                        Margin="0,2,0,2"/>

                <!-- AI ANSWER -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <TextBlock x:Name="AnswerTextBlock"
                               Text="Answer will appear here..."
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"
                               TextAlignment="Left"
                               VerticalAlignment="Top"
                               LineHeight="28"
                               MaxWidth="522"
                               Padding="0,4,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="5"
                                              ShadowDepth="1"
                                              Opacity="0.55"
                                              Color="Black"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </ScrollViewer>

                <!-- INTERVIEWER STRIP -->
                <Border Grid.Row="4"
                        Background="#1AFFFFFF"
                        CornerRadius="10"
                        BorderBrush="#2AFFFFFF"
                        BorderThickness="1"
                        Padding="12,7">
                    <DockPanel>
                        <Border DockPanel.Dock="Left"
                                Background="#0D2540"
                                CornerRadius="4"
                                Padding="7,3"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="INTERVIEWER"
                                       Foreground="#38BDF8"
                                       FontWeight="Bold"
                                       FontSize="9"
                                       FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock x:Name="QuestionTextBlock"
                                   Text="Waiting for audio..."
                                   Foreground="#CBD5E1"
                                   FontSize="13"
                                   FontFamily="Segoe UI"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   FontStyle="Italic"
                                   MaxWidth="420"/>
                    </DockPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
