<Window x:Class="InterviewCopilot.AnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replysis AI"
        Width="640"
        SizeToContent="Height"
        MinWidth="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Border x:Name="MainBorder"
                BorderThickness="1"
                CornerRadius="16"
                Opacity="0">
            <Border.BorderBrush>
                <SolidColorBrush Color="White" Opacity="0.10"/>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="48" ShadowDepth="16" Opacity="0.80" Color="#000000"/>
            </Border.Effect>
            <Border.Background>
                <!-- #030712 → #050f1e topLeading→bottomTrailing — exact Mac gradient -->
                <SolidColorBrush Color="#090B12"/>
            </Border.Background>

            <StackPanel x:Name="ContentStack">

                <!-- ══ STATUS BAR ══ (always visible) -->
                <Grid x:Name="DragHandle"
                      MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                      MouseMove="DragHandle_MouseMove"
                      MouseLeftButtonUp="DragHandle_MouseLeftButtonUp"
                      Cursor="SizeAll"
                       Margin="18,13,18,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mic indicator dot -->
                    <Ellipse Grid.Column="0"
                             x:Name="MiniMicIndicator"
                             Width="8" Height="8"
                             Fill="#f85149"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="MiniMicGlow"
                                              Color="#f85149"
                                              BlurRadius="7"
                                              ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Status text -->
                    <TextBlock Grid.Column="1"
                               x:Name="MicStatusLabel"
                               Text="Ready"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="Bold"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>

                    <!-- Idle hint, hidden while listening or thinking -->
                    <TextBlock Grid.Column="2"
                               x:Name="IdleHintLabel"
                               Text="Ctrl+Alt+Space to listen"
                               Margin="8,0,0,0"
                               FontSize="10"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="White" Opacity="0.75"/>
                        </TextBlock.Foreground>
                    </TextBlock>

                    <!-- Spacer -->
                    <Grid Grid.Column="3"/>

                    <!-- The same screen action and surface palette as the main toolbar. -->
                    <Button Grid.Column="4"
                            x:Name="AnalyzeBtn"
                            Style="{StaticResource ScreenActionButton}"
                            Click="AnalyzeBtn_Click"
                            ToolTip="Read the screen and answer from it. Same as F8."
                             Margin="0,0,10,0"
                            Cursor="Hand"
                            Focusable="False"
                            IsTabStop="False"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ScreenSurface" CornerRadius="6"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="AnalyzeBd"
                                        Width="14" Height="14" BorderThickness="0" Margin="0,0,6,0">
                                    <Border.Background>
                                         <SolidColorBrush Color="Transparent" Opacity="0.16"/>
                                    </Border.Background>
                                        <Path x:Name="AnalyzeBtnIcon" Width="14" Height="14"
                                              Data="M1,5 V1 H5 M9,1 H13 V5 M13,9 V13 H9 M5,13 H1 V9 M4,7 H10"
                                              Stroke="#F4F7FC" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              VerticalAlignment="Center"/>
                                </Border>
                                        <TextBlock x:Name="AnalyzeBtnLabel"
                                                   Text="Read screen"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI"
                                                   VerticalAlignment="Center"/>
                                    <TextBlock Text="F8" Foreground="#AAB7C9" FontSize="9" FontWeight="SemiBold"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                  </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ScreenSurface" Property="Background" Value="{DynamicResource ScreenActionHoverSurface}"/>
                                        <Setter TargetName="ScreenSurface" Property="BorderBrush" Value="{DynamicResource GlassButtonHoverStroke}"/>
                                        <Setter TargetName="AnalyzeBd" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="Transparent" Opacity="0.32"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ScreenSurface" Property="Background" Value="{DynamicResource GlassButtonPressedSurface}"/>
                                        <Setter TargetName="ScreenSurface" Property="BorderBrush" Value="{DynamicResource ScreenActionStroke}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ScreenSurface" Property="Background" Value="{DynamicResource GlassButtonDisabledSurface}"/>
                                        <Setter TargetName="ScreenSurface" Property="BorderBrush" Value="{DynamicResource ActionGraphiteStroke}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Close button: white 45% opacity -->
                    <Button Grid.Column="6"
                            Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Width="30" Height="34" Padding="6,3"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False"
                            IsTabStop="False"
                            VerticalAlignment="Center"
                            Click="HideOverlay_Click">
                        <Button.Foreground>
                            <SolidColorBrush Color="White" Opacity="0.70"/>
                        </Button.Foreground>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBd"
                                        Background="{DynamicResource ActionGraphiteSurface}"
                                        BorderBrush="{DynamicResource ActionGraphiteStroke}" BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBd" Property="Background" Value="{DynamicResource GlassButtonDangerHoverSurface}"/>
                                        <Setter TargetName="CloseBd" Property="BorderBrush" Value="{DynamicResource GlassButtonDangerStroke}"/>
                                        <Setter Property="Foreground" Value="#f85149"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ══ TRANSCRIPT DIVIDER + ROW ══ (collapsed when no question) -->
                <Border x:Name="TranscriptDivider"
                        Height="1"
                        Visibility="Collapsed">
                    <Border.Background>
                        <SolidColorBrush Color="White" Opacity="0.10"/>
                    </Border.Background>
                </Border>

                <Grid x:Name="TranscriptRow"
                      Margin="16,10,16,10"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- THEM badge -->
                    <Border Grid.Column="0"
                             Background="#1E3858"
                             CornerRadius="6"
                            Padding="6,3"
                            Margin="0,0,9,0"
                            VerticalAlignment="Top">
                        <TextBlock Text="THEM"
                                    Foreground="#C8E4FF"
                                   FontWeight="Bold"
                                   FontSize="8"
                                   FontFamily="Segoe UI"/>
                    </Border>

                    <!-- Let the compact window's SizeToContent height follow the
                         interviewer transcript. The former three-line cap clipped
                         long questions while the normal window kept showing them.
                         Capped at eight lines, though: with no cap a long rambling
                         turn grew the overlay past the bottom of the screen. Past
                         eight lines it scrolls, and the code keeps the newest words
                         in view. The scrollbar is hidden so the overlay keeps its
                         look; the wheel still scrolls. -->
                    <ScrollViewer Grid.Column="1"
                                  x:Name="TranscriptScroll"
                                  MaxHeight="152"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="QuestionTextBlock"
                               Text="Listening..."
                               FontSize="13"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               LineHeight="19">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="#C8DCEE"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                    </ScrollViewer>
                </Grid>

                <!-- ══ ANSWER DIVIDER + AREA ══ (collapsed when no answer) -->
                <Border x:Name="AnswerDivider"
                        Height="1"
                        Visibility="Collapsed">
                    <Border.Background>
                        <SolidColorBrush Color="White" Opacity="0.10"/>
                    </Border.Background>
                </Border>

                <ScrollViewer x:Name="AnswerScroller"
                              Visibility="Collapsed"
                              MaxHeight="340"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="18,16,18,16">

                        <!-- The words actually spoken. Everything here is sized
                             and weighted to be read off a screen at a glance. -->
                        <TextBlock x:Name="AnswerTextBlock"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   LineHeight="27">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1"
                                                  Opacity="0.60" Color="#000000"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Follow-up material. Glanced at, not read out, so it is
                             quieter than the answer above and clearly separated. -->
                        <Border x:Name="MoreDivider"
                                Height="1"
                                Margin="0,16,0,0"
                                Visibility="Collapsed">
                            <Border.Background>
                                <SolidColorBrush Color="White" Opacity="0.10"/>
                            </Border.Background>
                        </Border>

                        <TextBlock x:Name="MoreLabel"
                                   Text="MORE TO SAY"
                                   Foreground="#94A3B8"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   Margin="0,12,0,6"
                                   Visibility="Collapsed"/>

                        <TextBlock x:Name="MoreTextBlock"
                                   Foreground="#CBD5E1"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   FontFamily="Segoe UI"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   LineHeight="21"
                                   Visibility="Collapsed"/>

                    </StackPanel>
                </ScrollViewer>

            </StackPanel>
        </Border>
    </Grid>
</Window>
