<Window x:Class="InterviewCopilot.AnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replysis AI"
        Width="640"
        SizeToContent="Height"
        MinWidth="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Border x:Name="MainBorder"
                BorderThickness="1"
                CornerRadius="16"
                Opacity="0">
            <Border.BorderBrush>
                <SolidColorBrush Color="White" Opacity="0.10"/>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="48" ShadowDepth="16" Opacity="0.80" Color="#000000"/>
            </Border.Effect>
            <Border.Background>
                <!-- #030712 → #050f1e topLeading→bottomTrailing — exact Mac gradient -->
                <SolidColorBrush Color="#090B12"/>
            </Border.Background>

            <StackPanel x:Name="ContentStack">

                <!-- ══ STATUS BAR ══ (always visible) -->
                <Grid x:Name="DragHandle"
                      MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                      MouseMove="DragHandle_MouseMove"
                      MouseLeftButtonUp="DragHandle_MouseLeftButtonUp"
                      Cursor="SizeAll"
                       Margin="18,13,18,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mic indicator dot -->
                    <Ellipse Grid.Column="0"
                             x:Name="MiniMicIndicator"
                             Width="8" Height="8"
                             Fill="#f85149"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="MiniMicGlow"
                                              Color="#f85149"
                                              BlurRadius="7"
                                              ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Status text -->
                    <TextBlock Grid.Column="1"
                               x:Name="MicStatusLabel"
                               Text="Ready"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="Bold"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>

                    <!-- Idle hint, hidden while listening or thinking -->
                    <TextBlock Grid.Column="2"
                               x:Name="IdleHintLabel"
                               Text=" · press Space to listen"
                               FontSize="10"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="White" Opacity="0.75"/>
                        </TextBlock.Foreground>
                    </TextBlock>

                    <!-- Spacer -->
                    <Grid Grid.Column="3"/>

                    <!-- The same switch as the main window's pill. Compact used to
                         carry a one-shot Analyze while the main window carried a
                         watch toggle, so the two windows disagreed about what the
                         one screen control does. F8 still takes a single shot from
                         anywhere, which is what that button was for. -->
                    <Button Grid.Column="4"
                            x:Name="AnalyzeBtn"
                            Click="AnalyzeBtn_Click"
                             Margin="0,0,10,0"
                            Cursor="Hand"
                            Focusable="False"
                            IsTabStop="False"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="AnalyzeBd"
                                         CornerRadius="7"
                                        Padding="8,4">
                                    <Border.Background>
                                         <SolidColorBrush Color="#34E08A" Opacity="0.16"/>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="AnalyzeBtnIcon"
                                                   Text="&#xE7F4;"
                                                   Foreground="#84E7B6"
                                                   FontSize="10"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Margin="0,0,5,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AnalyzeBtnLabel"
                                                   Text="Watch"
                                                   Foreground="#AEEFCF"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="AnalyzeBd" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#34E08A" Opacity="0.32"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Close button: white 45% opacity -->
                    <Button Grid.Column="6"
                            Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Padding="6,3"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False"
                            IsTabStop="False"
                            VerticalAlignment="Center"
                            Click="HideOverlay_Click">
                        <Button.Foreground>
                            <SolidColorBrush Color="White" Opacity="0.70"/>
                        </Button.Foreground>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBd"
                                        Background="Transparent"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBd" Property="Background" Value="#0d1a2e"/>
                                        <Setter Property="Foreground" Value="#f85149"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ══ TRANSCRIPT DIVIDER + ROW ══ (collapsed when no question) -->
                <Border x:Name="TranscriptDivider"
                        Height="1"
                        Visibility="Collapsed">
                    <Border.Background>
                        <SolidColorBrush Color="White" Opacity="0.10"/>
                    </Border.Background>
                </Border>

                <Grid x:Name="TranscriptRow"
                      Margin="16,10,16,10"
                      MaxHeight="76"
                      ClipToBounds="True"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- THEM badge -->
                    <Border Grid.Column="0"
                             Background="#1E3858"
                             CornerRadius="6"
                            Padding="6,3"
                            Margin="0,0,9,0"
                            VerticalAlignment="Top">
                        <TextBlock Text="THEM"
                                    Foreground="#C8E4FF"
                                   FontWeight="Bold"
                                   FontSize="8"
                                   FontFamily="Segoe UI"/>
                    </Border>

                    <!-- Transcript text: 13pt, capped at 3 lines via grid MaxHeight -->
                    <TextBlock Grid.Column="1"
                               x:Name="QuestionTextBlock"
                               Text="Listening..."
                               FontSize="13"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               LineHeight="19">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="#C8DCEE"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                </Grid>

                <!-- ══ ANSWER DIVIDER + AREA ══ (collapsed when no answer) -->
                <Border x:Name="AnswerDivider"
                        Height="1"
                        Visibility="Collapsed">
                    <Border.Background>
                        <SolidColorBrush Color="White" Opacity="0.10"/>
                    </Border.Background>
                </Border>

                <ScrollViewer x:Name="AnswerScroller"
                              Visibility="Collapsed"
                              MaxHeight="340"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <TextBlock x:Name="AnswerTextBlock"
                               Foreground="White"
                                FontSize="16"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                                Margin="18,16,18,16"
                                LineHeight="27">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="1"
                                              Opacity="0.60" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </ScrollViewer>

            </StackPanel>
        </Border>
    </Grid>
</Window>
