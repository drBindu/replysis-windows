<Window x:Class="InterviewCopilot.CreditsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replysis AI Credits"
        Width="420" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Border Background="#0B1320" BorderBrush="#26354A" BorderThickness="1"
            CornerRadius="18" Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.62" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CREDITS" Foreground="#34E08A" FontSize="10"
                               FontWeight="Bold" FontFamily="Segoe UI"/>
                    <TextBlock Text="Usage and plan" Foreground="#FFFFFF" FontSize="21"
                               FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Click="CloseBtn_Click" Width="32" Height="32"
                        Background="Transparent" BorderThickness="0" Foreground="#8FA0B5"
                        FontSize="18" Cursor="Hand" Content="&#x2715;"/>
            </Grid>

            <Border Grid.Row="1" Margin="0,20,0,14" Background="#101D2D"
                    BorderBrush="#25415A" BorderThickness="1" CornerRadius="14" Padding="17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="24" Background="#143523"
                            BorderBrush="#2E8A52" BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock Text="&#x26A1;" FontSize="20" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="CreditsAmountText" Text="100 credits" Foreground="#FFFFFF"
                                   FontSize="22" FontWeight="Bold" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="PlanText" Text="Guest plan" Foreground="#88A0B8"
                                   FontSize="12" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="2,0,2,18">
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="AI answer" Foreground="#9EADBE" FontSize="12.5" FontFamily="Segoe UI"/>
                    <TextBlock Grid.Column="1" Text="5 credits" Foreground="#FFFFFF" FontSize="12.5"
                               FontWeight="SemiBold" FontFamily="Segoe UI"/>
                </Grid>
                <Border Height="1" Background="#1B2A3E"/>
                <Grid Margin="0,10,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Allowance" Foreground="#9EADBE" FontSize="12.5" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="AllowanceText" Grid.Column="1" Text="100 each month"
                               Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                </Grid>
                <Border Height="1" Background="#1B2A3E"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Next refresh" Foreground="#9EADBE" FontSize="12.5" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="ResetText" Grid.Column="1" Foreground="#FFFFFF" FontSize="12.5"
                               FontWeight="SemiBold" FontFamily="Segoe UI"/>
                </Grid>
                <TextBlock x:Name="DeviceNoteText" Margin="0,15,0,0" TextWrapping="Wrap"
                           Text="Your guest balance stays linked to this Windows device, including after restarting or reinstalling the app."
                           Foreground="#72859B" FontSize="11.5" LineHeight="18" FontFamily="Segoe UI"/>
            </StackPanel>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="CloseBtn_Click" Height="43" Content="Close"
                        Foreground="#C9D4E2" Background="#111E2F" BorderBrush="#2A3B52"
                        BorderThickness="1" FontSize="12.5" FontWeight="SemiBold"
                        FontFamily="Segoe UI" Cursor="Hand"/>
                <Button Grid.Column="2" Click="PricingBtn_Click" Height="43" Content="View pricing"
                        Foreground="#07140C" Background="#34E08A" BorderThickness="0"
                        FontSize="12.5" FontWeight="Bold" FontFamily="Segoe UI" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>
