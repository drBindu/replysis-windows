<Window x:Class="InterviewCopilot.CreditsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replysis AI Answers"
        Width="420" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Border x:Name="RootGlass" Background="#12151C" BorderBrush="#2A2F3A" BorderThickness="1"
            CornerRadius="20" Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.62" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ANSWERS" Foreground="#4ADE80" FontSize="10"
                               FontWeight="Bold" FontFamily="Segoe UI"/>
                    <TextBlock Text="Usage and plan" Foreground="#FFFFFF" FontSize="21"
                               FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Click="CloseBtn_Click"
                        Style="{StaticResource PremiumIconButton}"
                        FontFamily="Segoe MDL2 Assets" FontSize="11"
                        ToolTip="Close" Content="&#xE711;"/>
            </Grid>

            <Border Grid.Row="1" Margin="0,20,0,14" Background="#0D1117"
                    BorderBrush="#2A2F3A" BorderThickness="1" CornerRadius="16" Padding="17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="15" Background="#0F2A1A"
                            BorderBrush="#1A6B3A" BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock Text="&#x26A1;" FontSize="20" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="CreditsAmountText" Text="5 answers" Foreground="#FFFFFF"
                                   FontSize="22" FontWeight="Bold" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="PlanText" Text="Guest plan" Foreground="#6B7280"
                                   FontSize="12" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="2,0,2,18">
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="AI answer or screen read" Foreground="#94A3B8" FontSize="12.5" FontFamily="Segoe UI"/>
                    <TextBlock Grid.Column="1" Text="1 answer" Foreground="#FFFFFF" FontSize="12.5"
                               FontWeight="SemiBold" FontFamily="Segoe UI"/>
                </Grid>
                <Border Height="1" Background="#1E232D"/>
                <Grid Margin="0,10,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Allowance" Foreground="#94A3B8" FontSize="12.5" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="AllowanceText" Grid.Column="1" Text="5 answers, one time"
                               Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                </Grid>
                <Border Height="1" Background="#1E232D"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Next refresh" Foreground="#94A3B8" FontSize="12.5" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="ResetText" Grid.Column="1" Foreground="#FFFFFF" FontSize="12.5"
                               FontWeight="SemiBold" FontFamily="Segoe UI"/>
                </Grid>
                <TextBlock x:Name="DeviceNoteText" Margin="0,15,0,0" TextWrapping="Wrap"
                           Text="Your guest balance stays linked to this Windows device, including after restarting or reinstalling the app."
                           Foreground="#6B7280" FontSize="11.5" LineHeight="18" FontFamily="Segoe UI"/>
            </StackPanel>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="CloseBtn_Click"
                        Style="{StaticResource PremiumSecondaryButton}" Content="Close"/>
                <Button Grid.Column="2" Click="PricingBtn_Click"
                        Style="{StaticResource PremiumPrimaryButton}" Content="View pricing"/>
            </Grid>
        </Grid>
    </Border>
</Window>
