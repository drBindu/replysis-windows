<Window x:Class="InterviewCopilot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="460" Height="560" MinWidth="420" MinHeight="460"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="InvisibleRadio" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#93A4BA"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Border Background="#08091A" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="22,18,22,14">
                <TextBlock Text="Settings" Foreground="#F4F7FB" FontSize="18"
                           FontWeight="SemiBold" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <Button Content="Done" Click="SaveBtn_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#38BDF8" FontSize="15" FontWeight="SemiBold"
                        FontFamily="Segoe UI" Cursor="Hand" Padding="0"/>
            </Grid>
            <Border Grid.Row="1" Background="#25FFFFFF"/>

            <!-- CONTENT -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="22,20,14,20">
                <StackPanel>

                <!-- ── AI MODEL ──────────────────────────────────────── -->
                <TextBlock Text="AI MODEL" Style="{StaticResource SectionLabel}"/>

                <!-- Groq card -->
                <RadioButton x:Name="ModelGroqRadio" GroupName="ModelGroup"
                             Style="{StaticResource InvisibleRadio}"
                             Margin="0,0,0,8" Cursor="Hand"
                             Checked="ModelRadio_Checked">
                    <Border x:Name="GroqCard" CornerRadius="10" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                    BorderBrush="#38BDF8" BorderThickness="2"
                                    Margin="0,0,12,0" VerticalAlignment="Center"
                                    Background="Transparent">
                                <Ellipse x:Name="GroqDot" Width="10" Height="10"
                                         Fill="#38BDF8" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Groq (Llama — Fast &amp; Free)"
                                           Foreground="White" FontSize="13"
                                           FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                <TextBlock Text="Fast responses, completely free, great for practice"
                                           Foreground="#6b7280" FontSize="11"
                                           FontFamily="Segoe UI" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </RadioButton>

                <!-- OpenAI card -->
                <RadioButton x:Name="ModelOpenAiRadio" GroupName="ModelGroup"
                             Style="{StaticResource InvisibleRadio}"
                             Margin="0,0,0,24" Cursor="Hand"
                             Checked="ModelRadio_Checked">
                    <Border x:Name="OpenAiCard" CornerRadius="10" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                    BorderBrush="#38BDF8" BorderThickness="2"
                                    Margin="0,0,12,0" VerticalAlignment="Center"
                                    Background="Transparent">
                                <Ellipse x:Name="OpenAiDot" Width="10" Height="10"
                                         Fill="#38BDF8" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="OpenAI (GPT-4o — More Accurate)"
                                           Foreground="White" FontSize="13"
                                           FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                <TextBlock Text="Higher accuracy for real interviews, uses your credits"
                                           Foreground="#6b7280" FontSize="11"
                                           FontFamily="Segoe UI" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </RadioButton>

                <Border Height="1" Background="#25FFFFFF" Margin="0,0,0,20"/>

                <TextBlock Text="PRIVACY" Style="{StaticResource SectionLabel}"/>
                <CheckBox x:Name="CloudSyncCheckBox" Margin="2,0,0,20"
                          Foreground="#CBD5E1" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="Back up session history to my account" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Sends interview questions, answers, and a short resume snippet to CoopilotX so they appear on your other signed-in devices."
                                   Foreground="#6b7280" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </CheckBox>

                <!-- ── AUDIO CAPTURE ──────────────────────────────── -->
                <TextBlock Text="AUDIO CAPTURE" Style="{StaticResource SectionLabel}"/>

                <!-- System only -->
                <RadioButton x:Name="MicSystemRadio" GroupName="MicMode"
                             Style="{StaticResource InvisibleRadio}"
                             Margin="0,0,0,8" Cursor="Hand"
                             Checked="MicRadio_Checked">
                    <Border x:Name="MicSystemCard" CornerRadius="10" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                    BorderBrush="#38BDF8" BorderThickness="2"
                                    Margin="0,0,12,0" VerticalAlignment="Top"
                                    Background="Transparent">
                                <Ellipse x:Name="MicSystemDot" Width="10" Height="10"
                                         Fill="#38BDF8" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="System audio only"
                                           Foreground="White" FontSize="13"
                                           FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                <TextBlock Text="Uses system audio only. Your microphone is not accessed in this mode."
                                           Foreground="#6b7280" FontSize="11"
                                           FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </RadioButton>

                <!-- System + voice -->
                <RadioButton x:Name="MicBothRadio" GroupName="MicMode"
                             Style="{StaticResource InvisibleRadio}"
                             Margin="0,0,0,24" Cursor="Hand"
                             Checked="MicRadio_Checked">
                    <Border x:Name="MicBothCard" CornerRadius="10" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                    BorderBrush="#38BDF8" BorderThickness="2"
                                    Margin="0,0,12,0" VerticalAlignment="Top"
                                    Background="Transparent">
                                <Ellipse x:Name="MicBothDot" Width="10" Height="10"
                                         Fill="#38BDF8" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="System audio + my voice"
                                           Foreground="White" FontSize="13"
                                           FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                <TextBlock Text="Includes your microphone only while you are actively listening."
                                           Foreground="#6b7280" FontSize="11"
                                           FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </RadioButton>

                <Border Height="1" Background="#25FFFFFF" Margin="0,0,0,20"/>

                <!-- ── ABOUT ──────────────────────────────────────── -->
                <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}"/>
                <StackPanel Margin="2,0,0,0">
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="Version"  Foreground="#6b7280" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="VersionLabel" Foreground="#94a3b8" FontSize="12" FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="Backend"  Foreground="#6b7280" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock Text="https://coopilotxai.com" Foreground="#94a3b8" FontSize="12" FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="Account"  Foreground="#6b7280" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="AccountLabel" Foreground="#94a3b8" FontSize="12" FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Credits"  Foreground="#6b7280" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="CreditsAboutLabel" Foreground="#4ade80" FontSize="12" FontFamily="Segoe UI" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Button x:Name="SignInSettingsBtn" Content="Sign in for more credits"
                            Click="SignInSettingsBtn_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#38BDF8" FontSize="12" FontFamily="Segoe UI"
                            HorizontalAlignment="Left" Cursor="Hand" Padding="0,0,0,6"
                            Visibility="Collapsed"/>
                    <Button Content="Check for Updates…"
                            Click="CheckUpdatesBtn_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#38BDF8" FontSize="12" FontFamily="Segoe UI"
                            HorizontalAlignment="Left" Cursor="Hand" Padding="0"/>
                </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <StackPanel Grid.Row="3">
                <Border Height="1" Background="#25FFFFFF"/>
            <TextBlock Text="Config saved locally · coopilotxai.com"
                       Foreground="#64748B" FontSize="10" FontFamily="Segoe UI"
                       Margin="22,10,22,14"/>

            <!-- Hidden fields — preserve config round-trip -->
            </StackPanel>

            <ComboBox x:Name="ModelCombo"          Visibility="Collapsed"/>
            <ComboBox x:Name="AudioDeviceCombo"    Visibility="Collapsed"/>
            <TextBox  x:Name="ApiKeyBox"            Visibility="Collapsed"/>
            <TextBox  x:Name="SpeechmaticsKeyBox"  Visibility="Collapsed"/>
            <TextBox  x:Name="BackendUrlBox"        Visibility="Collapsed"/>
            <TextBox  x:Name="CoopilotEmailBox"     Visibility="Collapsed"/>
            <Slider   x:Name="TempSlider"           Visibility="Collapsed" Value="0.2"/>
            <TextBlock x:Name="TempLabel"           Visibility="Collapsed"/>
            <Slider   x:Name="MainOpacitySlider"    Visibility="Collapsed" Value="50" Minimum="1" Maximum="100" ValueChanged="MainOpacitySlider_ValueChanged"/>
            <TextBlock x:Name="MainOpacityLabel"    Visibility="Collapsed"/>
            <Slider   x:Name="OverlayOpacitySlider" Visibility="Collapsed" Value="50" Minimum="1" Maximum="100" ValueChanged="OverlayOpacitySlider_ValueChanged"/>
            <TextBlock x:Name="OverlayOpacityLabel" Visibility="Collapsed"/>

        </Grid>
    </Border>
</Window>
