<Window x:Class="InterviewCopilot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="460" Height="560" MinWidth="420" MinHeight="460"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="InvisibleRadio" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#93A9C4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Premium pill toggle switch, replaces plain system checkboxes -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24">
                            <Border x:Name="Track" CornerRadius="12" BorderThickness="1"
                                    Background="#22FFFFFF" BorderBrush="#28FFFFFF"/>
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#F8FAFC"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4" Color="#000000"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#25B978" Offset="0"/>
                                            <GradientStop Color="#1E9E63" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#A5B4FC"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card wrapper for a privacy/toggle row (icon + title + description + switch) -->
        <Style x:Key="ToggleCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootGlass" Background="#0B1220" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="22,18,22,14">
                <TextBlock Text="Settings" Foreground="#FFFFFF" FontSize="18"
                           FontWeight="SemiBold" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <Button Content="Done" Click="SaveBtn_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"
                        FontFamily="Segoe UI" Cursor="Hand" Padding="0"/>
            </Grid>
            <Border Grid.Row="1" Background="#18FFFFFF"/>

            <!-- CONTENT -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="22,20,14,20">
                <StackPanel>

                <!-- ── AI MODEL ──────────────────────────────────────── -->
                <!-- AI MODEL section removed 2026-09-11. It offered Fast and Accurate (GPT-4o),
                     but the backend picks the model itself and ignores this choice, and the
                     OpenAI account behind GPT-4o has been inactive since 2026-08-22. A setting
                     that changes nothing is not a setting. ModelIndex stays in the config so
                     older saved files still load. -->

                <TextBlock Text="PRIVACY" Style="{StaticResource SectionLabel}"/>

                <Border Style="{StaticResource ToggleCard}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#A5B4FC" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Stealth mode" Foreground="White" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"/>
                            <TextBlock Text="Hides the app from screen sharing, the taskbar and Alt-Tab. Test it in your meeting app first."
                                       Foreground="#7E90A8" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" x:Name="StealthCheckBox"
                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCard}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                   Foreground="#A5B4FC" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Answer from the shared screen" Foreground="White" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"/>
                            <TextBlock Text="Questions about your screen are answered from it. Questions about you are answered as usual. Press F8 to read the screen any time."
                                       Foreground="#7E90A8" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" x:Name="WatchScreenCheckBox"
                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCard}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#A5B4FC" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Back up session history" Foreground="White" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"/>
                            <TextBlock Text="Syncs questions, answers and a short part of your resume to your other signed-in devices."
                                       Foreground="#7E90A8" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" x:Name="CloudSyncCheckBox"
                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- ── LISTENING ──────────────────────────────────────
                     This was a choice between "Real interview" and "Practice",
                     and before that between "System audio only" and "System
                     audio + my voice". Both framings asked the user to pick a
                     mode, and picking the wrong one failed silently: a real
                     interview set to Practice hears the candidate instead of
                     the interviewer, the app looks perfectly normal, and no
                     answer ever arrives.

                     The two modes differed only in which audio source was
                     open. Listening to both removes the question. What is left
                     here is not a mode - it is one switch for anyone who does
                     not want their microphone opened at all. -->
                <TextBlock Text="LISTENING" Style="{StaticResource SectionLabel}"/>

                <Border Background="#0E1A2A" BorderBrush="#243449" BorderThickness="1"
                        CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Works for interviews and practice"
                                   Foreground="White" FontSize="13" FontWeight="Bold"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="Listens to your computer's sound and your microphone together."
                                   Foreground="#7E90A8" FontSize="11" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1"
                        CornerRadius="10" Padding="14,12" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Use my microphone"
                                       Foreground="White" FontSize="13" FontWeight="Bold"
                                       FontFamily="Segoe UI"/>
                            <TextBlock Text="Needed for practice. When off, only your computer's sound is heard."
                                       Foreground="#7E90A8" FontSize="11" FontWeight="SemiBold"
                                       FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="MicCaptureCheckBox"
                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <TextBlock Text="Microphone" Foreground="#7E90A8"
                           FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="2,0,0,6"/>
                <ComboBox x:Name="AudioDeviceCombo" Style="{StaticResource DarkComboBox}"
                          Margin="0,0,0,16"/>

                <TextBlock Text="Interview language" Foreground="#7E90A8"
                           FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="2,0,0,6"/>
                <ComboBox x:Name="LanguageCombo" Style="{StaticResource DarkComboBox}"
                          Margin="0,0,0,4"/>
                <TextBlock Text="Must match the language spoken in the interview. Other languages come out as garbled words."
                           Foreground="#6B7280" FontSize="10.5" FontWeight="SemiBold"
                           FontFamily="Segoe UI" TextWrapping="Wrap" Margin="2,0,0,20"/>

                <Border Height="1" Background="#18FFFFFF" Margin="0,0,0,20"/>

                <!-- ── ABOUT ──────────────────────────────────────── -->
                <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}"/>
                <StackPanel Margin="2,0,0,0">
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="Version"  Foreground="#7E90A8" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="VersionLabel" Foreground="#EAF1F8" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="Backend"  Foreground="#7E90A8" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock Text="Replysis AI Cloud" Foreground="#EAF1F8" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="Account"  Foreground="#7E90A8" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="AccountLabel" Foreground="#EAF1F8" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Credits"  Foreground="#7E90A8" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="CreditsAboutLabel" Foreground="#FFFFFF" FontSize="12" FontFamily="Segoe UI" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Button x:Name="SignInSettingsBtn" Content="Sign in for more credits"
                            Click="SignInSettingsBtn_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#FFFFFF" FontSize="12" FontFamily="Segoe UI"
                            HorizontalAlignment="Left" Cursor="Hand" Padding="0,0,0,6"
                            Visibility="Collapsed"/>
                    <Button Content="Check for Updates..."
                            Click="CheckUpdatesBtn_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#FFFFFF" FontSize="12" FontFamily="Segoe UI"
                            HorizontalAlignment="Left" Cursor="Hand" Padding="0"/>
                </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <StackPanel Grid.Row="3">
                <Border Height="1" Background="#18FFFFFF"/>
            <TextBlock Text="Settings are saved on this device"
                       Foreground="#7E90A8" FontSize="10" FontFamily="Segoe UI"
                       Margin="22,10,22,14"/>

            <!-- Hidden fields — preserve config round-trip -->
            </StackPanel>

            <ComboBox x:Name="ModelCombo"          Visibility="Collapsed"/>
            <TextBox  x:Name="BackendUrlBox"        Visibility="Collapsed"/>
            <TextBox  x:Name="CoopilotEmailBox"     Visibility="Collapsed"/>
            <Slider   x:Name="TempSlider"           Visibility="Collapsed" Value="0.2"/>
            <TextBlock x:Name="TempLabel"           Visibility="Collapsed"/>
            <Slider   x:Name="MainOpacitySlider"    Visibility="Collapsed" Value="50" Minimum="1" Maximum="100" ValueChanged="MainOpacitySlider_ValueChanged"/>
            <TextBlock x:Name="MainOpacityLabel"    Visibility="Collapsed"/>
            <Slider   x:Name="OverlayOpacitySlider" Visibility="Collapsed" Value="50" Minimum="1" Maximum="100" ValueChanged="OverlayOpacitySlider_ValueChanged"/>
            <TextBlock x:Name="OverlayOpacityLabel" Visibility="Collapsed"/>

        </Grid>
    </Border>
</Window>
