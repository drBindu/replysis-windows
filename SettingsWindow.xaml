<Window x:Class="InterviewCopilot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="460" Height="560" MinWidth="420" MinHeight="460"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="InvisibleRadio" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B4B4BA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Premium pill toggle switch, replaces plain system checkboxes -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24">
                            <Border x:Name="Track" CornerRadius="12" BorderThickness="1"
                                    Background="#22FFFFFF" BorderBrush="#28FFFFFF"/>
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#F8FAFC"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4" Color="#000000"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#6366F1" Offset="0"/>
                                            <GradientStop Color="#2563EB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#A5B4FC"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card wrapper for a privacy/toggle row (icon + title + description + switch) -->
        <Style x:Key="ToggleCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border Background="#0E1016" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="22,18,22,14">
                <TextBlock Text="Settings" Foreground="#FFFFFF" FontSize="18"
                           FontWeight="SemiBold" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <Button Content="Done" Click="SaveBtn_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"
                        FontFamily="Segoe UI" Cursor="Hand" Padding="0"/>
            </Grid>
            <Border Grid.Row="1" Background="#18FFFFFF"/>

            <!-- CONTENT -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="22,20,14,20">
                <StackPanel>

                <!-- ── AI MODEL ──────────────────────────────────────── -->
                <TextBlock Text="AI MODEL" Style="{StaticResource SectionLabel}"/>

                <!-- Groq card -->
                <RadioButton x:Name="ModelGroqRadio" GroupName="ModelGroup"
                             Style="{StaticResource InvisibleRadio}"
                             Margin="0,0,0,8" Cursor="Hand"
                             Checked="ModelRadio_Checked">
                    <Border x:Name="GroqCard" CornerRadius="10" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                    BorderBrush="#FFFFFF" BorderThickness="2"
                                    Margin="0,0,12,0" VerticalAlignment="Center"
                                    Background="Transparent">
                                <Ellipse x:Name="GroqDot" Width="10" Height="10"
                                         Fill="#FFFFFF" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Groq (Llama, Fast and Free)"
                                           Foreground="White" FontSize="13"
                                           FontWeight="Bold" FontFamily="Segoe UI"/>
                                <TextBlock Text="Fast responses, completely free, great for practice"
                                           Foreground="#9A9AA0" FontSize="11" FontWeight="SemiBold"
                                           FontFamily="Segoe UI" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </RadioButton>

                <!-- OpenAI card -->
                <RadioButton x:Name="ModelOpenAiRadio" GroupName="ModelGroup"
                             Style="{StaticResource InvisibleRadio}"
                             Margin="0,0,0,24" Cursor="Hand"
                             Checked="ModelRadio_Checked">
                    <Border x:Name="OpenAiCard" CornerRadius="10" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                    BorderBrush="#FFFFFF" BorderThickness="2"
                                    Margin="0,0,12,0" VerticalAlignment="Center"
                                    Background="Transparent">
                                <Ellipse x:Name="OpenAiDot" Width="10" Height="10"
                                         Fill="#FFFFFF" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="OpenAI (GPT-4o, More Accurate)"
                                           Foreground="White" FontSize="13"
                                           FontWeight="Bold" FontFamily="Segoe UI"/>
                                <TextBlock Text="Higher accuracy for real interviews, uses your credits"
                                           Foreground="#9A9AA0" FontSize="11" FontWeight="SemiBold"
                                           FontFamily="Segoe UI" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </RadioButton>

                <Border Height="1" Background="#18FFFFFF" Margin="0,0,0,20"/>

                <TextBlock Text="PRIVACY" Style="{StaticResource SectionLabel}"/>

                <Border Style="{StaticResource ToggleCard}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#A5B4FC" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Stealth mode" Foreground="White" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"/>
                            <TextBlock Text="Hides the window from OBS, Teams, Zoom and other recorders, and from the taskbar and Alt-Tab."
                                       Foreground="#9A9AA0" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" x:Name="StealthCheckBox"
                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCard}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#A5B4FC" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Back up session history" Foreground="White" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"/>
                            <TextBlock Text="Sends interview questions, answers, and a short resume snippet securely so they appear on your other signed-in devices."
                                       Foreground="#9A9AA0" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" x:Name="CloudSyncCheckBox"
                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- ── AUDIO CAPTURE ──────────────────────────────── -->
                <TextBlock Text="AUDIO CAPTURE" Style="{StaticResource SectionLabel}"/>

                <Border x:Name="AutoModeAudioNotice" Visibility="Collapsed"
                        Background="#102A1D" BorderBrush="#2C7B50" BorderThickness="1"
                        CornerRadius="9" Padding="12,9" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="7" Height="7" Fill="#34E08A" Margin="0,5,9,0"
                                 VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="AutoModeAudioNoticeTitle" Text="AUTO MODE ACTIVE" Foreground="#B8F5D3"
                                       FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="AutoModeAudioNoticeBody"
                                       Text="System audio only is temporarily active. Your saved manual audio choice returns when Auto is turned off."
                                       Foreground="#8FCBAB" FontSize="10.5" FontWeight="SemiBold"
                                       FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- System only -->
                <RadioButton x:Name="MicSystemRadio" GroupName="MicMode"
                             Style="{StaticResource InvisibleRadio}"
                             Margin="0,0,0,8" Cursor="Hand"
                             Checked="MicRadio_Checked">
                    <Border x:Name="MicSystemCard" CornerRadius="10" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                    BorderBrush="#FFFFFF" BorderThickness="2"
                                    Margin="0,0,12,0" VerticalAlignment="Top"
                                    Background="Transparent">
                                <Ellipse x:Name="MicSystemDot" Width="10" Height="10"
                                         Fill="#FFFFFF" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="System audio only"
                                           Foreground="White" FontSize="13"
                                           FontWeight="Bold" FontFamily="Segoe UI"/>
                                <TextBlock Text="Uses system audio only. Your microphone is not accessed in this mode."
                                           Foreground="#9A9AA0" FontSize="11" FontWeight="SemiBold"
                                           FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </RadioButton>

                <!-- System + voice -->
                <RadioButton x:Name="MicBothRadio" GroupName="MicMode"
                             Style="{StaticResource InvisibleRadio}"
                             Margin="0,0,0,24" Cursor="Hand"
                             Checked="MicRadio_Checked">
                    <Border x:Name="MicBothCard" CornerRadius="10" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                    BorderBrush="#FFFFFF" BorderThickness="2"
                                    Margin="0,0,12,0" VerticalAlignment="Top"
                                    Background="Transparent">
                                <Ellipse x:Name="MicBothDot" Width="10" Height="10"
                                         Fill="#FFFFFF" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="System audio + my voice"
                                           Foreground="White" FontSize="13"
                                           FontWeight="Bold" FontFamily="Segoe UI"/>
                                <TextBlock Text="Includes your microphone only while you are actively listening."
                                           Foreground="#9A9AA0" FontSize="11" FontWeight="SemiBold"
                                           FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </RadioButton>

                <TextBlock Text="Microphone" Foreground="#9A9AA0"
                           FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="2,0,0,6"/>
                <ComboBox x:Name="AudioDeviceCombo" Style="{StaticResource DarkComboBox}"
                          Margin="0,0,0,16"/>

                <TextBlock Text="Interview language" Foreground="#9A9AA0"
                           FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="2,0,0,6"/>
                <ComboBox x:Name="LanguageCombo" Style="{StaticResource DarkComboBox}"
                          Margin="0,0,0,4"/>
                <TextBlock Text="Must match the language spoken in the interview. Other languages come out as garbled words."
                           Foreground="#6B7280" FontSize="10.5" FontWeight="SemiBold"
                           FontFamily="Segoe UI" TextWrapping="Wrap" Margin="2,0,0,20"/>

                <Border Height="1" Background="#18FFFFFF" Margin="0,0,0,20"/>

                <!-- ── ABOUT ──────────────────────────────────────── -->
                <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}"/>
                <StackPanel Margin="2,0,0,0">
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="Version"  Foreground="#9A9AA0" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="VersionLabel" Foreground="#E0E0E4" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="Backend"  Foreground="#9A9AA0" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock Text="Replysis AI Cloud" Foreground="#E0E0E4" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="Account"  Foreground="#9A9AA0" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="AccountLabel" Foreground="#E0E0E4" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Credits"  Foreground="#9A9AA0" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="CreditsAboutLabel" Foreground="#FFFFFF" FontSize="12" FontFamily="Segoe UI" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Button x:Name="SignInSettingsBtn" Content="Sign in for more credits"
                            Click="SignInSettingsBtn_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#FFFFFF" FontSize="12" FontFamily="Segoe UI"
                            HorizontalAlignment="Left" Cursor="Hand" Padding="0,0,0,6"
                            Visibility="Collapsed"/>
                    <Button Content="Check for Updates…"
                            Click="CheckUpdatesBtn_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#FFFFFF" FontSize="12" FontFamily="Segoe UI"
                            HorizontalAlignment="Left" Cursor="Hand" Padding="0"/>
                </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <StackPanel Grid.Row="3">
                <Border Height="1" Background="#18FFFFFF"/>
            <TextBlock Text="Config saved locally · Replysis AI"
                       Foreground="#9A9AA0" FontSize="10" FontFamily="Segoe UI"
                       Margin="22,10,22,14"/>

            <!-- Hidden fields — preserve config round-trip -->
            </StackPanel>

            <ComboBox x:Name="ModelCombo"          Visibility="Collapsed"/>
            <TextBox  x:Name="BackendUrlBox"        Visibility="Collapsed"/>
            <TextBox  x:Name="CoopilotEmailBox"     Visibility="Collapsed"/>
            <Slider   x:Name="TempSlider"           Visibility="Collapsed" Value="0.2"/>
            <TextBlock x:Name="TempLabel"           Visibility="Collapsed"/>
            <Slider   x:Name="MainOpacitySlider"    Visibility="Collapsed" Value="50" Minimum="1" Maximum="100" ValueChanged="MainOpacitySlider_ValueChanged"/>
            <TextBlock x:Name="MainOpacityLabel"    Visibility="Collapsed"/>
            <Slider   x:Name="OverlayOpacitySlider" Visibility="Collapsed" Value="50" Minimum="1" Maximum="100" ValueChanged="OverlayOpacitySlider_ValueChanged"/>
            <TextBlock x:Name="OverlayOpacityLabel" Visibility="Collapsed"/>

        </Grid>
    </Border>
</Window>
