<UserControl x:Class="InterviewCopilot.SessionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <!--
        Sessions, hosted inside the main window instead of floating in one of
        its own.

        It was a second top-level window: a second taskbar entry, a second thing
        to lose behind other apps, and - the reason that actually decided it -
        a second window that has to be hidden from screen capture. Stealth
        covers every window today, but the fewer windows exist, the less there
        is to protect, and this app is used while a screen is being shared.

        Living here also removes the sizing problem a separate window had: it
        can never be larger than the app it belongs to, because it is drawn
        inside it.
    -->

    <UserControl.Resources>
            <!-- ═══ palette, shared with MainWindow ═══ -->
            <SolidColorBrush x:Key="Surface"      Color="#0B1220"/>
            <SolidColorBrush x:Key="SurfaceRaise" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceSunk"  Color="#28000000"/>
            <SolidColorBrush x:Key="Line"         Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="LineStrong"   Color="#3AFFFFFF"/>
            <SolidColorBrush x:Key="TextHi"       Color="#EAF1F8"/>
            <SolidColorBrush x:Key="TextMid"      Color="#C6D4E8"/>
            <SolidColorBrush x:Key="TextLow"      Color="#7E90A8"/>
            <SolidColorBrush x:Key="Accent"       Color="#34E08A"/>
            <SolidColorBrush x:Key="AccentSoft"   Color="#5EA9F5"/>
    
            <Style x:Key="GhostBtn" TargetType="Button">
                <Setter Property="Background" Value="#172942"/>
                <Setter Property="Foreground" Value="#CFE2FA"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#55FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
    
            <Style x:Key="DangerBtn" TargetType="Button">
                <Setter Property="Background" Value="#2A1620"/>
                <Setter Property="Foreground" Value="#F8A3AC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#5E2733"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4DF87171"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#8A3A48"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
    
            <!-- A session row. The accent rail on the left is the brand green when
                 selected and a quiet line otherwise, so the selected row is
                 identifiable at a glance without the harsh white bar this used
                 to draw on every row equally. -->
            <Style x:Key="SessionItemStyle" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,7"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBd" Background="{StaticResource SurfaceRaise}"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="10" Padding="13,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="11"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Rail" Grid.Column="0" Background="#30FFFFFF"
                                            CornerRadius="2" VerticalAlignment="Stretch"/>
                                    <ContentPresenter Grid.Column="2"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background" Value="#1EFFFFFF"/>
                                    <Setter TargetName="ItemBd" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                                    <Setter TargetName="Rail" Property="Background" Value="#66FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background" Value="#2634E08A"/>
                                    <Setter TargetName="ItemBd" Property="BorderBrush" Value="#2F6E58"/>
                                    <Setter TargetName="Rail" Property="Background" Value="{StaticResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </UserControl.Resources>

    <!--
        Fills the content area rather than floating in the middle of it.

        As a centred card with its own rounded border, shadow and title bar, it
        read as a second window drawn inside the first - the exact thing moving
        it here was meant to stop. A view that replaces the content, keeping the
        app's own toolbar above it, is what makes this feel like part of the app
        rather than something on top of it.
    -->
    <Grid Background="Transparent">
        <Grid>
        <Border x:Name="SessionsCard" Background="#0AFFFFFF" CornerRadius="0"
                    BorderThickness="0">
                

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── HEADER ── -->
                    <Border Grid.Row="0" Background="#10FFFFFF" CornerRadius="0"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            >
                        <Grid Margin="20,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#2634E08A" CornerRadius="8" Width="30" Height="30"
                                        Margin="0,0,12,0" BorderBrush="#2F6E58" BorderThickness="1">
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Interview Sessions" Foreground="{StaticResource TextHi}"
                                               FontSize="13.5" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="SubtitleLabel" Text="Loading..."
                                               Foreground="{StaticResource TextLow}" FontSize="10.5"
                                               FontFamily="Segoe UI" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="2" Click="CloseBtn_Click"
                                    ToolTip="Back to the interview screen  &#183;  Esc"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" VerticalAlignment="Center"
                                    FocusVisualStyle="{StaticResource KeyboardFocus}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CBd" Background="#14FFFFFF" CornerRadius="8"
                                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                Padding="12,7">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="CIcon" Text="&#xE72B;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           Foreground="{StaticResource TextMid}"
                                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="CText" Text="Back to interview"
                                                           FontFamily="Segoe UI" FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMid}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CBd" Property="Background" Value="#2634E08A"/>
                                                <Setter TargetName="CBd" Property="BorderBrush" Value="#4D34E08A"/>
                                                <Setter TargetName="CIcon" Property="Foreground" Value="{StaticResource Accent}"/>
                                                <Setter TargetName="CText" Property="Foreground" Value="#EAF1F8"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CBd" Property="Background" Value="#1A34E08A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ── BODY ── -->
                    <Grid Grid.Row="1" Margin="16,14,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="316"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: sessions list -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="SESSIONS" Foreground="{StaticResource TextLow}"
                                       FontSize="9.5" FontWeight="Bold" FontFamily="Segoe UI"
                                       Margin="4,0,0,8"/>

                            <Border Grid.Row="1" Background="{StaticResource SurfaceSunk}" CornerRadius="12"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <Grid>
                                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center"
                                                HorizontalAlignment="Center" Visibility="Collapsed">
                                        <Border Background="#14FFFFFF" CornerRadius="14" Width="52" Height="52"
                                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                HorizontalAlignment="Center" Margin="0,0,0,14">
                                            <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="20" Foreground="{StaticResource TextLow}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="No sessions yet" Foreground="{StaticResource TextMid}"
                                                   FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Sessions are saved automatically" Foreground="{StaticResource TextLow}"
                                                   FontSize="10.5" FontFamily="Segoe UI"
                                                   HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <ListBox x:Name="SessionsList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemContainerStyle="{StaticResource SessionItemStyle}"
                                             SelectionChanged="SessionsList_SelectionChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             Padding="9">
                                        <ListBox.Template>
                                            <ControlTemplate TargetType="ListBox">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              Padding="{TemplateBinding Padding}">
                                                    <ItemsPresenter/>
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ListBox.Template>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,1,0,1">
                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                               Foreground="{StaticResource TextHi}" FontSize="12.5"
                                                               FontWeight="SemiBold" FontFamily="Segoe UI"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding DisplayDate}"
                                                               Foreground="{StaticResource TextLow}" FontSize="10.5"
                                                               FontFamily="Segoe UI" Margin="0,0,0,6"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#1E5EA9F5" Padding="7,2"
                                                                BorderBrush="#24405F" BorderThickness="1"
                                                                Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding DisplayStats}"
                                                                       Foreground="#9BD9FF" FontSize="9.5"
                                                                       FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayModel}"
                                                                   Foreground="{StaticResource TextLow}" FontSize="9.5"
                                                                   FontFamily="Segoe UI" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Button x:Name="DeleteBtn" Grid.Row="2"
                                    Style="{StaticResource DangerBtn}"
                                    Click="DeleteBtn_Click"
                                    Padding="14,9" Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Delete session" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- RIGHT: transcript -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" x:Name="DetailHeader"
                                    Background="{StaticResource SurfaceRaise}" CornerRadius="12"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    Padding="16,12" Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock x:Name="DetailTitle" Text="" Foreground="{StaticResource TextHi}"
                                                   FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="DetailMeta" Text="" Foreground="{StaticResource TextLow}"
                                                   FontSize="10.5" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                                        <!-- What was actually asked, at a glance. The report used to be
                                             a bare Q&amp;A list with no way to see the shape of the session. -->
                                        <ItemsControl x:Name="SessionStats" Margin="0,9,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button x:Name="CopyTranscriptBtn"
                                                Style="{StaticResource GhostBtn}"
                                                Click="CopyTranscriptBtn_Click"
                                                Padding="12,7" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Copy text" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ExportBtn"
                                                Style="{StaticResource GhostBtn}"
                                                Click="ExportBtn_Click"
                                                Padding="12,7">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Export .txt" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource SurfaceSunk}" CornerRadius="12"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <Grid>
                                    <StackPanel x:Name="NoSelectionState"
                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Background="#14FFFFFF" CornerRadius="16" Width="58" Height="58"
                                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                HorizontalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22" Foreground="{StaticResource TextLow}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Select a session"
                                                   Foreground="{StaticResource TextMid}" FontSize="13"
                                                   FontWeight="SemiBold" FontFamily="Segoe UI"
                                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                        <TextBlock Text="Its full transcript will appear here"
                                                   Foreground="{StaticResource TextLow}" FontSize="11"
                                                   FontFamily="Segoe UI" HorizontalAlignment="Center"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <ScrollViewer x:Name="TranscriptScroll"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="22,18"
                                                  Visibility="Collapsed">
                                        <StackPanel x:Name="TranscriptPanel"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
