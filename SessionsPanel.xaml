<UserControl x:Class="InterviewCopilot.SessionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <!--
        Sessions, hosted inside the main window instead of floating in one of
        its own.

        It was a second top-level window: a second taskbar entry, a second thing
        to lose behind other apps, and - the reason that actually decided it -
        a second window that has to be hidden from screen capture. Stealth
        covers every window today, but the fewer windows exist, the less there
        is to protect, and this app is used while a screen is being shared.

        Living here also removes the sizing problem a separate window had: it
        can never be larger than the app it belongs to, because it is drawn
        inside it.
    -->

    <UserControl.Resources>
            <!-- ═══ palette, shared with MainWindow ═══ -->
            <SolidColorBrush x:Key="Surface"      Color="#D10A0F17"/>
            <SolidColorBrush x:Key="SurfaceRaise" Color="#B8121A26"/>
            <SolidColorBrush x:Key="SurfaceSunk"  Color="#A6080D14"/>
            <SolidColorBrush x:Key="Line"         Color="#26384F"/>
            <SolidColorBrush x:Key="LineStrong"   Color="#3B536F"/>
            <SolidColorBrush x:Key="TextHi"       Color="#F4F7FB"/>
            <SolidColorBrush x:Key="TextMid"      Color="#C5D1E0"/>
            <SolidColorBrush x:Key="TextLow"      Color="#8292A8"/>
            <SolidColorBrush x:Key="Accent"       Color="#35E58C"/>
            <SolidColorBrush x:Key="AccentSoft"   Color="#7CB6FF"/>
    
            <Style x:Key="GhostBtn" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ActionGraphiteSurface}"/>
                <Setter Property="Foreground" Value="#CFE2FA"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ActionGraphiteStroke}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassButtonHoverSurface}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassButtonHoverStroke}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassButtonPressedSurface}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
    
            <Style x:Key="DangerBtn" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource GlassButtonDangerSurface}"/>
                <Setter Property="Foreground" Value="#F8A3AC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GlassButtonDangerStroke}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassButtonDangerHoverSurface}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassButtonDangerStroke}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
    
            <!-- A session row. The accent rail on the left is the brand green when
                 selected and a quiet line otherwise, so the selected row is
                 identifiable at a glance without the harsh white bar this used
                 to draw on every row equally. -->
            <Style x:Key="SessionItemStyle" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,7"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBd" Background="#8A111925"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="11" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Rail" Grid.Column="0" Background="#35465C"
                                            CornerRadius="2" VerticalAlignment="Stretch"/>
                                    <ContentPresenter Grid.Column="2"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background" Value="#B3182433"/>
                                    <Setter TargetName="ItemBd" Property="BorderBrush" Value="#426080"/>
                                    <Setter TargetName="Rail" Property="Background" Value="#7593B8"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background" Value="#B1122B25"/>
                                    <Setter TargetName="ItemBd" Property="BorderBrush" Value="#357B5A"/>
                                    <Setter TargetName="Rail" Property="Background" Value="{StaticResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </UserControl.Resources>

    <!--
        Fills the content area rather than floating in the middle of it.

        As a centred card with its own rounded border, shadow and title bar, it
        read as a second window drawn inside the first - the exact thing moving
        it here was meant to stop. A view that replaces the content, keeping the
        app's own toolbar above it, is what makes this feel like part of the app
        rather than something on top of it.
    -->
    <Grid Background="Transparent">
        <Border x:Name="SessionsCard" Background="{StaticResource Surface}" BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Product-level title bar: one identity, one exit action. -->
                <Border Grid.Row="0" Background="#0AFFFFFF"
                        BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                    <Grid Margin="16,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,11,0"
                                    Background="#1C35E58C" BorderBrush="#3B35E58C" BorderThickness="1">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Past sessions" Foreground="{StaticResource TextHi}"
                                           FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="SubtitleLabel" Text="Loading your interviews..."
                                           Foreground="{StaticResource TextLow}" FontSize="10.5"
                                           FontFamily="Segoe UI" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Click="CloseBtn_Click" Style="{StaticResource GhostBtn}"
                                ToolTip="Return to the interview" Padding="10,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Interview" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="248"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Compact archive rail. -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceSunk}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <Grid Margin="13,0,10,0">
                                    <TextBlock Text="INTERVIEWS" Foreground="{StaticResource TextLow}"
                                               FontSize="9.5" FontWeight="Bold" FontFamily="Segoe UI"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1">
                                <StackPanel x:Name="EmptyState" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" Visibility="Collapsed">
                                    <Border Width="46" Height="46" CornerRadius="14" Background="#121D2A"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,12">
                                        <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                   Foreground="{StaticResource TextLow}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="No sessions yet" Foreground="{StaticResource TextMid}"
                                               FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Finished interviews appear here"
                                               Foreground="{StaticResource TextLow}" FontSize="10"
                                               FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ListBox x:Name="SessionsList" Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource SessionItemStyle}"
                                         SelectionChanged="SessionsList_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="8">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Padding="{TemplateBinding Padding}">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding DisplayTitle}"
                                                           Foreground="{StaticResource TextHi}" FontSize="12"
                                                           FontWeight="SemiBold" FontFamily="Segoe UI"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="1" Text="{Binding DisplayDate}"
                                                           Foreground="{StaticResource TextLow}" FontSize="9.5"
                                                           FontFamily="Segoe UI" Margin="0,3,0,6"/>
                                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                    <Border Background="#1B7CB6FF" CornerRadius="5" Padding="6,2"
                                                            BorderBrush="#304E6B" BorderThickness="1" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding DisplayStats}" Foreground="#9BCBFF"
                                                                   FontSize="9" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayModel}"
                                                               Foreground="{StaticResource TextLow}" FontSize="9"
                                                               FontFamily="Segoe UI" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="95"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Focused transcript workspace. -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="DetailHeader" Grid.Row="0" Background="{StaticResource SurfaceRaise}"
                                CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                Padding="14,11" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock x:Name="DetailTitle" Foreground="{StaticResource TextHi}"
                                               FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="DetailMeta" Foreground="{StaticResource TextLow}"
                                               FontSize="10" FontFamily="Segoe UI" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ItemsControl x:Name="SessionStats" Margin="0,7,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="CopyTranscriptBtn" Style="{StaticResource GhostBtn}"
                                            Click="CopyTranscriptBtn_Click" Padding="9,6" Margin="0,0,6,0"
                                            ToolTip="Copy full transcript">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copy" FontSize="10.5"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ExportBtn" Style="{StaticResource GhostBtn}"
                                            Click="ExportBtn_Click" Padding="9,6" Margin="0,0,6,0"
                                            ToolTip="Export transcript as a text file">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Export" FontSize="10.5"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DeleteBtn" Style="{StaticResource DangerBtn}"
                                            Click="DeleteBtn_Click" Padding="9,6" Visibility="Collapsed"
                                            ToolTip="Delete this device's local copy">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="{StaticResource SurfaceSunk}" CornerRadius="14"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <Grid>
                                <StackPanel x:Name="NoSelectionState" VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <Border Width="52" Height="52" CornerRadius="16" Background="#121D2A"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                                            HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                   Foreground="{StaticResource TextLow}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Choose an interview" Foreground="{StaticResource TextMid}"
                                               FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Questions and AI suggestions will appear here"
                                               Foreground="{StaticResource TextLow}" FontSize="10.5"
                                               FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Padding="16,14"
                                              Visibility="Collapsed">
                                    <StackPanel x:Name="TranscriptPanel"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
