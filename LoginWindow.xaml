<Window x:Class="InterviewCopilot.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoopilotX — Sign In"
        Height="560" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border Background="#0d1117" CornerRadius="16" BorderBrush="#21262d" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR / DRAG -->
            <Border Grid.Row="0" Background="Transparent" Padding="0,12,16,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="✕" Click="CloseBtn_Click"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#6b7280" FontSize="16" Cursor="Hand" Padding="6,2"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- MAIN CONTENT -->
            <StackPanel Grid.Row="1" Margin="40,0,40,40">

                <!-- LOGO + BRAND -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                    <Border CornerRadius="16" Width="64" Height="64"
                            HorizontalAlignment="Center" Margin="0,0,0,14"
                            Background="#1e3a5f">
                        <TextBlock Text="CX" Foreground="#38BDF8" FontSize="22"
                                   FontWeight="Black" FontFamily="Segoe UI"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CoopilotX" Foreground="White" FontSize="22"
                               FontWeight="Bold" FontFamily="Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Interview Copilot" Foreground="#4b5563" FontSize="12"
                               FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- ERROR BANNER -->
                <Border x:Name="ErrorBanner" Background="#2a0a0a" CornerRadius="8"
                        Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed"
                        BorderBrush="#6b1a1a" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" Foreground="#ef4444" FontSize="13"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ErrorText" Foreground="#ef4444" FontSize="12"
                                   FontFamily="Segoe UI" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- SUCCESS BANNER -->
                <Border x:Name="SuccessBanner" Background="#0f2a1a" CornerRadius="8"
                        Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed"
                        BorderBrush="#1a6b3a" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Foreground="#4ade80" FontSize="13"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SuccessText" Foreground="#4ade80"
                                   FontSize="12" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>

                <!-- EMAIL LABEL -->
                <TextBlock Text="EMAIL" Foreground="#6b7280" FontSize="10"
                           FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,6"/>

                <!-- EMAIL INPUT -->
                <Border x:Name="EmailBorder" Background="#161b22" CornerRadius="8"
                        BorderBrush="#30363d" BorderThickness="1" Margin="0,0,0,14">
                    <TextBox x:Name="EmailBox"
                             Background="Transparent" Foreground="#e6edf3"
                             BorderThickness="0" Padding="14,11"
                             FontSize="13" FontFamily="Segoe UI"
                             CaretBrush="#38BDF8"
                             GotFocus="EmailBox_GotFocus"
                             LostFocus="EmailBox_LostFocus"
                             KeyDown="Input_KeyDown"/>
                </Border>

                <!-- PASSWORD LABEL -->
                <TextBlock Text="PASSWORD" Foreground="#6b7280" FontSize="10"
                           FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,6"/>

                <!-- PASSWORD INPUT -->
                <Border x:Name="PasswordBorder" Background="#161b22" CornerRadius="8"
                        BorderBrush="#30363d" BorderThickness="1" Margin="0,0,0,6">
                    <PasswordBox x:Name="PasswordBox"
                                 Background="Transparent" Foreground="#e6edf3"
                                 BorderThickness="0" Padding="14,11"
                                 FontSize="13" FontFamily="Segoe UI"
                                 CaretBrush="#38BDF8"
                                 GotFocus="PasswordBox_GotFocus"
                                 LostFocus="PasswordBox_LostFocus"
                                 KeyDown="Input_KeyDown"/>
                </Border>

                <!-- FORGOT PASSWORD -->
                <TextBlock HorizontalAlignment="Right" Margin="0,6,0,22">
                    <Hyperlink x:Name="ForgotLink" Click="ForgotLink_Click"
                               Foreground="#38BDF8" TextDecorations="None"
                               FontSize="11" FontFamily="Segoe UI">
                        Forgot password?
                    </Hyperlink>
                </TextBlock>

                <!-- SIGN IN BUTTON -->
                <Button x:Name="SignInBtn" Click="SignInBtn_Click"
                        Height="44" Cursor="Hand" Margin="0,0,0,16">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Background="#1d6ae5">
                                <Grid>
                                    <TextBlock x:Name="BtnText" Text="Sign In"
                                               Foreground="White" FontSize="14"
                                               FontWeight="SemiBold" FontFamily="Segoe UI"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <StackPanel x:Name="LoadingPanel" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <TextBlock x:Name="LoadingDots" Text="Signing in..."
                                                   Foreground="White" FontSize="13"
                                                   FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2563eb"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#1a2535"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- DIVIDER -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="1" Background="#21262d" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="or" Foreground="#4b5563"
                               FontSize="11" FontFamily="Segoe UI" Margin="12,0"/>
                    <Border Grid.Column="2" Height="1" Background="#21262d" VerticalAlignment="Center"/>
                </Grid>

                <!-- REGISTER LINK -->
                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI" FontSize="12">
                    <Run Text="Don't have an account? " Foreground="#6b7280"/>
                    <Hyperlink Click="RegisterLink_Click" Foreground="#38BDF8" TextDecorations="None">
                        Create one at coopilotxai.com
                    </Hyperlink>
                </TextBlock>

            </StackPanel>
        </Grid>
    </Border>
</Window>
