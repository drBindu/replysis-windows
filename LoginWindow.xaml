<Window x:Class="InterviewCopilot.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replysis AI Sign In"
        Icon="pack://siteoforigin:,,,/Assets/replysis-icon-1024.png"
        Height="600" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="#FEFEFC" WindowStyle="None" AllowsTransparency="False"
        ResizeMode="NoResize" ShowInTaskbar="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Border x:Name="RootGlass" Background="#FEFEFC" BorderBrush="#E4E8E0" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Product panel — same palette as replysis.com: a light, warm
                 green-tinted gradient rather than the app's own dark glass
                 theme, so the first thing anyone signing in sees matches the
                 site they just downloaded from. -->
            <Border Grid.Column="0" BorderBrush="#DCE4D8" BorderThickness="0,0,1,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F6F8F3" Offset="0"/>
                        <GradientStop Color="#F1F5EE" Offset="0.55"/>
                        <GradientStop Color="#EAF3EC" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="48,42,44,40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="11"
                                Background="White" BorderBrush="#D8E3D6" BorderThickness="1">
                            <Image Source="pack://siteoforigin:,,,/Assets/replysis-icon-1024.png"
                                   Width="40" Height="40" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
                            <TextBlock Text="REPLYSIS" Foreground="#16150F" FontSize="15"
                                       FontWeight="Bold"/>
                            <TextBlock Text="AI INTERVIEW COPILOT" Foreground="#7A8177" FontSize="8.5"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0">
                        <Border HorizontalAlignment="Left" Background="#1421924A" BorderBrush="#3421924A"
                                BorderThickness="1" CornerRadius="12" Padding="10,5" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="#21924A" Margin="0,0,7,0"/>
                                <TextBlock Text="YOUR INTERVIEW, IN FOCUS" Foreground="#1C7A3E"
                                           FontSize="9" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Be ready for the&#x0a;question that matters."
                                   Foreground="#16150F" FontSize="27" FontWeight="SemiBold" LineHeight="35"/>
                        <TextBlock Text="Replysis listens, understands the role and grounds every response in your real experience."
                                   Foreground="#5A5F55" FontSize="12.5" TextWrapping="Wrap"
                                   LineHeight="19" Margin="0,12,8,0"/>

                        <!-- Layered live-product preview. Small independent motion creates
                             depth without turning an enterprise sign-in page into a demo reel. -->
                        <Grid Height="174" Margin="0,18,0,0" ClipToBounds="False">
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="QuestionFloat"
                                                             Storyboard.TargetProperty="Y"
                                                             From="1" To="-4" Duration="0:0:2.8">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="AnswerFloat"
                                                             Storyboard.TargetProperty="Y"
                                                             From="-1" To="4" Duration="0:0:3.4">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="LivePulse"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.35" To="1" Duration="0:0:1.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>

                            <Border Width="285" Height="62" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="7,7,0,0" CornerRadius="10" Background="White"
                                    BorderBrush="#E3E8E0" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="-1.5"/>
                                        <TranslateTransform x:Name="QuestionFloat"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Border.Effect><DropShadowEffect Color="#16150F" BlurRadius="18" ShadowDepth="8" Opacity="0.14"/></Border.Effect>
                                <Grid Margin="13,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#F0F2EE" VerticalAlignment="Top">
                                        <TextBlock Text="IN" Foreground="#5A5F55" FontSize="8" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="INTERVIEWER" Foreground="#8A9086" FontSize="8" FontWeight="Bold"/>
                                        <TextBlock Text="Tell me about a project you led."
                                                   Foreground="#16150F" FontSize="11.5" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Width="302" Height="82" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,2,5" CornerRadius="11" Background="#EEF7EF"
                                    BorderBrush="#BFDFC7" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="1.2"/>
                                        <TranslateTransform x:Name="AnswerFloat"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Border.Effect><DropShadowEffect Color="#1C7A3E" BlurRadius="22" ShadowDepth="10" Opacity="0.18"/></Border.Effect>
                                <Grid Margin="14,11">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="18" CornerRadius="5" Background="#2221924A">
                                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Foreground="#1C7A3E"
                                                           FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="REPLYSIS ANSWER" Foreground="#1C7A3E" FontSize="8.5"
                                                       FontWeight="Bold" Margin="7,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse x:Name="LivePulse" Width="5" Height="5" Fill="#21924A" Margin="0,0,5,0"/>
                                            <TextBlock Text="RESUME GROUNDED" Foreground="#4F8A62" FontSize="7.5" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="I led the migration by splitting delivery into safe phases, reducing deployment risk while keeping the service available."
                                               Foreground="#2B3A2E" FontSize="10.5" TextWrapping="Wrap"
                                               LineHeight="15" Margin="0,7,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" Background="White" BorderBrush="#DCE4D8"
                            BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="100" Foreground="#1C7A3E" FontSize="22"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="FREE WELCOME CREDITS" Foreground="#16150F"
                                           FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="Included with every new account" Foreground="#7A8177"
                                           FontSize="9.5" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" CornerRadius="9" Background="#F0F2EE"
                                    BorderBrush="#DCE4D8" BorderThickness="1" Padding="7,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="NO CARD" Foreground="#5A5F55" FontSize="7.5" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Authentication panel -->
            <Grid Grid.Column="1" Background="White">
                <!-- Not PremiumIconButton: that style's hover state turns the icon
                     white for the app's dark glass windows, which disappears
                     against this page's white background. A small local
                     template keeps the same shape without the mismatch. -->
                <Button Click="CloseBtn_Click" Width="32" Height="32" Cursor="Hand"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,16,0" ToolTip="Close"
                        FocusVisualStyle="{StaticResource KeyboardFocus}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseSurface" CornerRadius="6" Background="#F0F2EE" BorderBrush="#DCE4D8" BorderThickness="1">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#5A5F55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseSurface" Property="Background" Value="#FDF1F1"/>
                                    <Setter TargetName="CloseSurface" Property="BorderBrush" Value="#F3C6C6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Width="390" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="AuthTitle" Text="Welcome back" Foreground="#16150F"
                               FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LoginSubtitle" Text="Sign in to continue to your workspace"
                               Foreground="#7A8177" FontSize="12.5" Margin="0,5,0,24"/>

                    <Border x:Name="ErrorBanner" Background="#FDF1F1" CornerRadius="8"
                            Padding="11,9" Margin="0,0,0,12" Visibility="Collapsed"
                            BorderBrush="#F3C6C6" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" Foreground="#C0392B"
                                       FontSize="11" Margin="0,1,8,0" VerticalAlignment="Top"/>
                            <TextBlock x:Name="ErrorText" Foreground="#9A2E24" FontSize="11.5"
                                       TextWrapping="Wrap" MaxWidth="335"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SuccessBanner" Background="#EEF7EF" CornerRadius="8"
                            Padding="11,9" Margin="0,0,0,12" Visibility="Collapsed"
                            BorderBrush="#BFDFC7" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets" Foreground="#21924A"
                                       FontSize="11" Margin="0,1,8,0" VerticalAlignment="Top"/>
                            <TextBlock x:Name="SuccessText" Foreground="#1C7A3E" FontSize="11.5"
                                       TextWrapping="Wrap" MaxWidth="335"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Email address" Foreground="#5A5F55" FontSize="11"
                               FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <Border x:Name="EmailBorder" Background="#F9FAF8" CornerRadius="7"
                            BorderBrush="#DCE4D8" BorderThickness="1" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" Foreground="#8A9086"
                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="EmailBox" Background="Transparent" Foreground="#16150F"
                                     BorderThickness="0" Padding="2,10,13,10" FontSize="13" CaretBrush="#1C7A3E"
                                     GotFocus="EmailBox_GotFocus" LostFocus="EmailBox_LostFocus" KeyDown="Input_KeyDown"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Password" Foreground="#5A5F55" FontSize="11"
                               FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <Border x:Name="PasswordBorder" Background="#F9FAF8" CornerRadius="7"
                            BorderBrush="#DCE4D8" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#8A9086"
                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <PasswordBox Grid.Column="1" x:Name="PasswordBox" Background="Transparent" Foreground="#16150F"
                                         BorderThickness="0" Padding="2,10" FontSize="13" CaretBrush="#1C7A3E"
                                         GotFocus="PasswordBox_GotFocus" LostFocus="PasswordBox_LostFocus" KeyDown="Input_KeyDown"/>
                            <TextBox Grid.Column="1" x:Name="PasswordPlainBox" Visibility="Collapsed" Background="Transparent"
                                     Foreground="#16150F" BorderThickness="0" Padding="2,10" FontSize="13"
                                     CaretBrush="#1C7A3E" GotFocus="PasswordBox_GotFocus"
                                     LostFocus="PasswordBox_LostFocus" KeyDown="Input_KeyDown"/>
                            <Button Grid.Column="2" x:Name="RevealPasswordBtn" Click="RevealPasswordBtn_Click"
                                    Width="36" Height="32" Margin="0,0,4,0" Cursor="Hand"
                                    VerticalAlignment="Center" ToolTip="Show password"
                                    FocusVisualStyle="{StaticResource KeyboardFocus}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="RevealSurface" CornerRadius="6" Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RevealSurface" Property="Background" Value="#F0F2EE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="RevealPasswordIcon" Text="&#xE7B3;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#8A9086"/>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ForgotPasswordRow" HorizontalAlignment="Right" Margin="0,8,0,18">
                        <Hyperlink x:Name="ForgotLink" Click="ForgotLink_Click" Foreground="#1C7A3E"
                                   TextDecorations="None" FontSize="11">Forgot password?</Hyperlink>
                    </TextBlock>

                    <Button x:Name="SignInBtn" Click="SignInBtn_Click" Height="43" Cursor="Hand"
                            Margin="0,0,0,14" FocusVisualStyle="{StaticResource KeyboardFocus}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="7" BorderBrush="#1C7A3E" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1C7A3E" Offset="0"/>
                                            <GradientStop Color="#21924A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <TextBlock x:Name="BtnText" Text="Sign In" Foreground="White" FontSize="13"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <StackPanel x:Name="LoadingPanel" Orientation="Horizontal"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="LoadingDots" Text="Signing in..." Foreground="White" FontSize="12.5"/>
                                        </StackPanel>
                                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" Foreground="#CDEBD8"
                                                   FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,14,0"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Height="1" Background="#E4E8E0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="OR" Foreground="#8A9086" FontSize="9" FontWeight="Bold" Margin="12,0"/>
                        <Border Grid.Column="2" Height="1" Background="#E4E8E0" VerticalAlignment="Center"/>
                    </Grid>

                    <Button x:Name="GoogleSignInBtn" Click="GoogleSignIn_Click" Height="43"
                            Cursor="Hand" Margin="0,0,0,16" FocusVisualStyle="{StaticResource KeyboardFocus}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="GoogleBd" CornerRadius="7" Background="White"
                                        BorderBrush="#DCE4D8" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#4285F4" Data="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                                <Path Fill="#34A853" Data="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                                <Path Fill="#FBBC05" Data="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
                                                <Path Fill="#EA4335" Data="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="GoogleBtnText" Text="Continue with Google"
                                                   Foreground="#16150F" FontSize="12.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="GoogleBd" Property="Background" Value="#F6F8F3"/>
                                        <Setter TargetName="GoogleBd" Property="BorderBrush" Value="#C7D4C4"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="GoogleBd" Property="Opacity" Value="0.45"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock x:Name="RegisterPrompt" HorizontalAlignment="Center" FontSize="11.5">
                        <Run x:Name="RegisterPromptText" Text="New to Replysis? " Foreground="#7A8177"/><Hyperlink
                            x:Name="RegisterLink" Click="RegisterLink_Click" Foreground="#1C7A3E"
                            TextDecorations="None">Create an account</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
