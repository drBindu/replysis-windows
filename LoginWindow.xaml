<Window x:Class="InterviewCopilot.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoopilotX — Sign In"
        Height="626" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Background="#08091A" CornerRadius="20" BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR / DRAG -->
            <Border Grid.Row="0" Background="Transparent" Padding="0,12,16,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="✕" Click="CloseBtn_Click"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#6b7280" FontSize="16" Cursor="Hand" Padding="6,2"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- MAIN CONTENT -->
            <StackPanel Grid.Row="1" Margin="40,0,40,40">

                <!-- LOGO + BRAND -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Border CornerRadius="18" Width="68" Height="68"
                            HorizontalAlignment="Center" Margin="0,0,0,14"
                            Background="#12142A" BorderBrush="#50FFFFFF" BorderThickness="1">
                        <TextBlock Text="CX" Foreground="#C7E2FF" FontSize="22"
                                   FontWeight="Black" FontFamily="Segoe UI"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CoopilotX" Foreground="#F4F7FB" FontSize="23"
                               FontWeight="Bold" FontFamily="Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Interview Copilot" Foreground="#4b5563" FontSize="12"
                               FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- ERROR BANNER -->
                <Border x:Name="ErrorBanner" Background="#35171D" CornerRadius="10"
                        Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed"
                        BorderBrush="#91424B" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" Foreground="#ef4444" FontSize="13"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ErrorText" Foreground="#ef4444" FontSize="12"
                                   FontFamily="Segoe UI" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- SUCCESS BANNER -->
                <Border x:Name="SuccessBanner" Background="#102A22" CornerRadius="10"
                        Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed"
                        BorderBrush="#2F8A62" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Foreground="#4ade80" FontSize="13"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SuccessText" Foreground="#4ade80"
                                   FontSize="12" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>

                <!-- EMAIL LABEL -->
                <TextBlock Text="EMAIL ADDRESS" Foreground="#93A4BA" FontSize="10"
                           FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,6"/>

                <!-- EMAIL INPUT -->
                <Border x:Name="EmailBorder" Background="#0C0E1E" CornerRadius="10"
                        BorderBrush="#28FFFFFF" BorderThickness="1" Margin="0,0,0,14">
                    <TextBox x:Name="EmailBox"
                             Background="Transparent" Foreground="#EAF2FF"
                             BorderThickness="0" Padding="14,11"
                             FontSize="13" FontFamily="Segoe UI"
                             CaretBrush="#38BDF8"
                             GotFocus="EmailBox_GotFocus"
                             LostFocus="EmailBox_LostFocus"
                             KeyDown="Input_KeyDown"/>
                </Border>

                <!-- PASSWORD LABEL -->
                <TextBlock Text="PASSWORD" Foreground="#93A4BA" FontSize="10"
                           FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,6"/>

                <!-- PASSWORD INPUT -->
                <Border x:Name="PasswordBorder" Background="#0C0E1E" CornerRadius="10"
                        BorderBrush="#28FFFFFF" BorderThickness="1" Margin="0,0,0,6">
                    <PasswordBox x:Name="PasswordBox"
                                 Background="Transparent" Foreground="#EAF2FF"
                                 BorderThickness="0" Padding="14,11"
                                 FontSize="13" FontFamily="Segoe UI"
                                 CaretBrush="#38BDF8"
                                 GotFocus="PasswordBox_GotFocus"
                                 LostFocus="PasswordBox_LostFocus"
                                 KeyDown="Input_KeyDown"/>
                </Border>

                <!-- FORGOT PASSWORD -->
                <TextBlock HorizontalAlignment="Right" Margin="0,6,0,22">
                    <Hyperlink x:Name="ForgotLink" Click="ForgotLink_Click"
                               Foreground="#38BDF8" TextDecorations="None"
                               FontSize="11" FontFamily="Segoe UI">
                        Forgot password?
                    </Hyperlink>
                </TextBlock>

                <!-- SIGN IN BUTTON -->
                <Button x:Name="SignInBtn" Click="SignInBtn_Click"
                        Height="46" Cursor="Hand" Margin="0,0,0,16" FocusVisualStyle="{StaticResource KeyboardFocus}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="10" Background="#246BC1" BorderBrush="#6FAEFF" BorderThickness="1">
                                <Grid>
                                    <TextBlock x:Name="BtnText" Text="Sign In"
                                               Foreground="White" FontSize="14"
                                               FontWeight="SemiBold" FontFamily="Segoe UI"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <StackPanel x:Name="LoadingPanel" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <TextBlock x:Name="LoadingDots" Text="Signing in..."
                                                   Foreground="White" FontSize="13"
                                                   FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#347DDA"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#1a2535"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- DIVIDER -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="1" Background="#21262d" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="or" Foreground="#4b5563"
                               FontSize="11" FontFamily="Segoe UI" Margin="12,0"/>
                    <Border Grid.Column="2" Height="1" Background="#21262d" VerticalAlignment="Center"/>
                </Grid>

                <!-- GOOGLE SIGN-IN BUTTON -->
                <Button x:Name="GoogleSignInBtn" Click="GoogleSignIn_Click"
                        Height="46" Cursor="Hand" Margin="0,0,0,16" FocusVisualStyle="{StaticResource KeyboardFocus}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="GoogleBd" CornerRadius="10" Background="#0C0E1E"
                                    BorderBrush="#28FFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Margin="0,0,0,0">
                                    <TextBlock Text="G" Foreground="#EA4335" FontSize="16"
                                               FontWeight="Bold" FontFamily="Segoe UI"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="GoogleBtnText" Text="Sign in with Google"
                                                Foreground="#EAF2FF" FontSize="13"
                                               FontWeight="SemiBold" FontFamily="Segoe UI"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GoogleBd" Property="Background" Value="#18263A"/>
                                    <Setter TargetName="GoogleBd" Property="BorderBrush" Value="#4A6F99"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="GoogleBd" Property="Background" Value="#0d1117"/>
                                    <Setter TargetName="GoogleBtnText" Property="Foreground" Value="#4b5563"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- REGISTER LINK -->
                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI" FontSize="12">
                    <Run Text="Don't have an account? " Foreground="#6b7280"/>
                    <Hyperlink Click="RegisterLink_Click" Foreground="#38BDF8" TextDecorations="None">
                        Create one at coopilotxai.com
                    </Hyperlink>
                </TextBlock>

            </StackPanel>
        </Grid>
    </Border>
</Window>
