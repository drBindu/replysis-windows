<Window x:Class="InterviewCopilot.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replysis AI Sign In"
        Icon="pack://siteoforigin:,,,/Assets/replysis-icon-1024.png"
        Height="626" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Background="#080B12" CornerRadius="20" BorderBrush="#27374E" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR / DRAG -->
            <Border Grid.Row="0" Background="Transparent" Padding="0,12,16,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Click="CloseBtn_Click" Background="Transparent" BorderThickness="0"
                                Foreground="#7F93AB" Cursor="Hand" Padding="7,3" ToolTip="Close">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- MAIN CONTENT -->
            <StackPanel Grid.Row="1" Margin="40,0,40,40">

                <!-- LOGO + BRAND -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Border CornerRadius="18" Width="68" Height="68"
                            HorizontalAlignment="Center" Margin="0,0,0,14"
                            Background="#0E1524" BorderBrush="#27374E" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.4" Color="#34E08A"/>
                        </Border.Effect>
                        <Image Source="pack://siteoforigin:,,,/Assets/replysis-icon-1024.png"
                               Width="66" Height="66" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               SnapsToDevicePixels="True"/>
                    </Border>
                    <TextBlock Text="Replysis AI" Foreground="#F4F7FB" FontSize="23"
                               FontWeight="Bold" FontFamily="Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Sign in to start your interview" Foreground="#7F93AB" FontSize="12"
                               FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- ERROR BANNER -->
                <Border x:Name="ErrorBanner" Background="#2A1418" CornerRadius="10"
                        Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed"
                        BorderBrush="#7E3843" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="#F87171" FontSize="12"
                                   Margin="0,1,9,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" FontSize="12"
                                   FontFamily="Segoe UI" TextWrapping="Wrap" MaxWidth="290"/>
                    </StackPanel>
                </Border>

                <!-- SUCCESS BANNER -->
                <Border x:Name="SuccessBanner" Background="#102A1D" CornerRadius="10"
                        Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed"
                        BorderBrush="#285D42" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="#34E08A" FontSize="12"
                                   Margin="0,1,9,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="SuccessText" Foreground="#AEEFCF"
                                   FontSize="12" FontFamily="Segoe UI"
                                   TextWrapping="Wrap" MaxWidth="290"/>
                    </StackPanel>
                </Border>

                <!-- EMAIL LABEL -->
                <TextBlock Text="EMAIL ADDRESS" Foreground="#6F8198" FontSize="9.5"
                           FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,6"/>

                <!-- EMAIL INPUT -->
                <Border x:Name="EmailBorder" Background="#0B131F" CornerRadius="10"
                        BorderBrush="#26364C" BorderThickness="1" Margin="0,0,0,14">
                    <TextBox x:Name="EmailBox"
                             Background="Transparent" Foreground="#EAF2FF"
                             BorderThickness="0" Padding="14,11"
                             FontSize="13" FontFamily="Segoe UI"
                             CaretBrush="#34E08A"
                             GotFocus="EmailBox_GotFocus"
                             LostFocus="EmailBox_LostFocus"
                             KeyDown="Input_KeyDown"/>
                </Border>

                <!-- PASSWORD LABEL -->
                <TextBlock Text="PASSWORD" Foreground="#6F8198" FontSize="9.5"
                           FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,6"/>

                <!-- PASSWORD INPUT
                     PasswordBox cannot render its own text, so the reveal state
                     swaps in a plain TextBox. PasswordBox stays authoritative:
                     see CurrentPassword in the code-behind. -->
                <Border x:Name="PasswordBorder" Background="#0B131F" CornerRadius="10"
                        BorderBrush="#26364C" BorderThickness="1" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PasswordBox"
                                     Background="Transparent" Foreground="#EAF2FF"
                                     BorderThickness="0" Padding="14,11"
                                     FontSize="13" FontFamily="Segoe UI"
                                     CaretBrush="#34E08A"
                                     GotFocus="PasswordBox_GotFocus"
                                     LostFocus="PasswordBox_LostFocus"
                                     KeyDown="Input_KeyDown"/>
                        <TextBox x:Name="PasswordPlainBox" Visibility="Collapsed"
                                 Background="Transparent" Foreground="#EAF2FF"
                                 BorderThickness="0" Padding="14,11"
                                 FontSize="13" FontFamily="Segoe UI"
                                 CaretBrush="#34E08A"
                                 GotFocus="PasswordBox_GotFocus"
                                 LostFocus="PasswordBox_LostFocus"
                                 KeyDown="Input_KeyDown"/>
                        <Button Grid.Column="1" x:Name="RevealPasswordBtn"
                                Click="RevealPasswordBtn_Click"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Padding="12,0" VerticalAlignment="Center"
                                ToolTip="Show password">
                            <TextBlock x:Name="RevealPasswordIcon" Text="&#xE7B3;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="#6F8198"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- FORGOT PASSWORD -->
                <TextBlock HorizontalAlignment="Right" Margin="0,6,0,22">
                    <Hyperlink x:Name="ForgotLink" Click="ForgotLink_Click"
                               Foreground="#84E7B6" TextDecorations="None"
                               FontSize="11" FontFamily="Segoe UI">
                        Forgot password?
                    </Hyperlink>
                </TextBlock>

                <!-- SIGN IN BUTTON -->
                <Button x:Name="SignInBtn" Click="SignInBtn_Click"
                        Height="46" Cursor="Hand" Margin="0,0,0,16" FocusVisualStyle="{StaticResource KeyboardFocus}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="10" Background="#1E9E63" BorderBrush="#34E08A" BorderThickness="1">
                                <Grid>
                                    <TextBlock x:Name="BtnText" Text="Sign In"
                                               Foreground="White" FontSize="14"
                                               FontWeight="SemiBold" FontFamily="Segoe UI"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <StackPanel x:Name="LoadingPanel" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <TextBlock x:Name="LoadingDots" Text="Signing in..."
                                                   Foreground="White" FontSize="13"
                                                   FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#24B672"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#16281F"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#26364C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- DIVIDER -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="1" Background="#1B2A3C" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="or" Foreground="#6F8198"
                               FontSize="11" FontFamily="Segoe UI" Margin="12,0"/>
                    <Border Grid.Column="2" Height="1" Background="#1B2A3C" VerticalAlignment="Center"/>
                </Grid>

                <!-- GOOGLE SIGN-IN BUTTON -->
                <Button x:Name="GoogleSignInBtn" Click="GoogleSignIn_Click"
                        Height="46" Cursor="Hand" Margin="0,0,0,16" FocusVisualStyle="{StaticResource KeyboardFocus}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="GoogleBd" CornerRadius="10" Background="#0B131F"
                                    BorderBrush="#26364C" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <!-- The official mark, drawn as vectors. A red letter "G"
                                         in the UI font was the giveaway that this was a mock-up. -->
                                    <Viewbox Width="17" Height="17" Margin="0,0,11,0"
                                             VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#4285F4" Data="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                            <Path Fill="#34A853" Data="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                            <Path Fill="#FBBC05" Data="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
                                            <Path Fill="#EA4335" Data="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="GoogleBtnText" Text="Continue with Google"
                                               Foreground="#EAF2FF" FontSize="13"
                                               FontWeight="SemiBold" FontFamily="Segoe UI"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GoogleBd" Property="Background" Value="#152337"/>
                                    <Setter TargetName="GoogleBd" Property="BorderBrush" Value="#3A4D68"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="GoogleBd" Property="Background" Value="#0A0F18"/>
                                    <Setter TargetName="GoogleBtnText" Property="Foreground" Value="#4C5A6C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- REGISTER LINK -->
                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                           TextAlignment="Center" TextWrapping="Wrap">
                    <Run Text="New here? " Foreground="#7F93AB"/><Hyperlink
                        Click="RegisterLink_Click" Foreground="#84E7B6" TextDecorations="None">Create
                        an account</Hyperlink>
                </TextBlock>

            </StackPanel>
        </Grid>
    </Border>
</Window>
