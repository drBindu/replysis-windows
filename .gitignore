# Build output
bin/
obj/

# MSIX packaging output. The directory Visual Studio actually writes is
# AppPackages/ — the old AppxPackages/ rule never matched anything.
AppPackages/
AppxPackages/
BundleArtifacts/
*.assets.cache

# Python bytecode
__pycache__/
*.py[cod]

# Visual Studio
.vs/
*.user

# Temp key — never commit real certs
*.pfx

# Large binaries
*.msixbundle
*.msix
*.appxbundle

# Local runtime configuration
.env
.env.*
!.env.example

# PyInstaller engine build output (built by tools/build-engine.ps1)
engine-dist/
build/
publish_test/

# Written by tools/build-engine.ps1 at build time; never committed.
engine_build_info.py
