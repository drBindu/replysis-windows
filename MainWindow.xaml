            <!-- ═══════════════════════════════════════════════════════════════
                 IN-APP ALERT
                 A Win32 MessageBox is a separate window, so it never receives the
                 WDA_EXCLUDEFROMCAPTURE flag that hides this app from screen
                 sharing. Any dialog raised mid-interview was therefore visible to
                 the interviewer. This banner lives inside the stealthed window,
                 and it does not block the UI thread the way a modal does.
                 ═══════════════════════════════════════════════════════════════ -->
            <Border x:Name="InAppAlert" Visibility="Collapsed" Panel.ZIndex="300"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,74,0,0" MaxWidth="560" CornerRadius="12"
                    Background="#131C2B" BorderBrush="#3A4D68" BorderThickness="1"
                    Padding="16,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="7" Opacity="0.6" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="InAppAlertIcon" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                               FontSize="15" Foreground="#F5B83D" VerticalAlignment="Top"
                               Margin="0,1,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="InAppAlertTitle" Text="" Foreground="#EEF4FB"
                                   FontSize="12.5" FontWeight="Bold" FontFamily="Segoe UI"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="InAppAlertBody" Text="" Foreground="#A9B6C8"
                                   FontSize="11.5" FontFamily="Segoe UI" TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="InAppAlertAction" Visibility="Collapsed"
                                Style="{StaticResource PrimaryActionBtn}" Padding="12,4"
                                Margin="12,0,0,0" Click="InAppAlertAction_Click"/>
                        <Button Style="{StaticResource GhostBtn}" Padding="7,2"
                                Margin="8,0,0,0" VerticalAlignment="Top"
                                Click="InAppAlertDismiss_Click" ToolTip="Dismiss">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 FIRST-RUN ONBOARDING  (shown once; reopen via the ? button)
                 ═══════════════════════════════════════════════════════════════ -->
            <Grid x:Name="OnboardingOverlay" Visibility="Collapsed" Panel.ZIndex="200">
                <Rectangle Fill="#DA05070C"/>
