<Window x:Class="InterviewCopilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoopilotX | Interview Copilot"
        Height="580" Width="880"
        MinHeight="460" MinWidth="760"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        ShowInTaskbar="True"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Opacity="1"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="Background" Value="#147A54"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2AB97D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A9264"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#106443"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RedBtn" TargetType="Button">
            <Setter Property="Background" Value="#8F2833"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7525D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B73745"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#701E27"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#252525"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A1A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#777777"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A0A0A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BlueBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383838"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CCCCCC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1E1E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MicBtnStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Outer state ring -->
                            <Border x:Name="Ring" CornerRadius="25"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="2" Background="Transparent"/>
                            <!-- Inner gradient circle -->
                            <Border x:Name="Bd" CornerRadius="22" Margin="3">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.2" RadiusX="0.85" RadiusY="0.85">
                                        <GradientStop Color="#1A1A1A" Offset="0"/>
                                        <GradientStop Color="#0A0A0A" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.2" RadiusX="0.85" RadiusY="0.85">
                                            <GradientStop Color="#303030" Offset="0"/>
                                            <GradientStop Color="#141414" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.2" RadiusX="0.85" RadiusY="0.85">
                                            <GradientStop Color="#141414" Offset="0"/>
                                            <GradientStop Color="#080808" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ArrowToggleBtn" TargetType="Button">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A1A"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainAppBorder" CornerRadius="18"
            BorderBrush="#40FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Background>
            <SolidColorBrush Color="#22060810"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.55" Color="#04040E"/>
        </Border.Effect>
        <Grid>
            <Grid x:Name="NormalModeGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="68"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Border Grid.Row="0" Background="#A0060810" CornerRadius="18,18,0,0"
                        BorderBrush="#30FFFFFF" BorderThickness="0,0,0,1">
                    <Grid Margin="22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Logo -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#222222" CornerRadius="10" Width="38" Height="38" Margin="0,0,11,0"
                                    BorderBrush="#AAAAAA" BorderThickness="1">
                                <TextBlock Text="CX" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CoopilotX" Foreground="#F4F7FB" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="INTERVIEW INTELLIGENCE" Foreground="#888888" FontSize="8" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- CENTER: Mic -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="MicBtn" Style="{StaticResource MicBtnStyle}"
                                    Click="MicBtn_Click" Margin="0,0,16,0">
                                <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"/>
                                <Button.Effect>
                                    <DropShadowEffect x:Name="MicGlow" Color="#ef4444" BlurRadius="0" ShadowDepth="0"/>
                                </Button.Effect>
                            </Button>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="MicIndicator" Width="9" Height="9" Fill="#57D68D" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="MicIndicatorText" Text="READY"
                                               Foreground="#EAF2FF" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- REC badge — kept for code compat; hidden (timer shows recording state) -->
                            <Border x:Name="RecordingBadge" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- RIGHT cluster — matches Mac order: Analyze | Camera | Sessions | Settings | Timer | Credits | Profile | Min | Close -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,4,0">

                            <!-- Analyze (F9) -->
                            <Button x:Name="ScreenAnalyzeBtn"
                                    Style="{StaticResource GhostBtn}"
                                    Click="ScreenAnalyzeBtn_Click"
                                    Padding="10,6" Margin="0,0,6,0"
                                    ToolTip="Analyze screen for an instant AI answer (F8 / F9)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="AnalyzeIcon" Text="🔍" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AnalyzeLabel" Text="Analyze" FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    <Border Background="#1A1A1A" CornerRadius="4" Padding="4,2" Margin="5,0,0,0">
                                        <TextBlock Text="F9" Foreground="#DDDDDD" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI Mono"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Camera / Eye toggle -->
                            <Button Style="{StaticResource GhostBtn}"
                                    Click="CameraMode_Click" Padding="9,6" Margin="0,0,6,0"
                                    ToolTip="Camera overlay — hides main window, shows a tiny floating answer bar for in-person interviews">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👁" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Overlay" FontSize="10" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Stealth mode toggle — default ON -->
                            <Button x:Name="StealthBtn"
                                    Style="{StaticResource GhostBtn}"
                                    Click="StealthBtn_Click"
                                    Padding="9,6" Margin="0,0,6,0"
                                    ToolTip="Stealth mode: hides app from OBS, Teams, Meet, and screen recorders. ON by default for security.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StealthIcon" Text="🛡" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StealthLabel" Text="Stealth ON" FontSize="10"
                                               FontFamily="Segoe UI" VerticalAlignment="Center" Foreground="#4ade80"/>
                                </StackPanel>
                            </Button>

                            <!-- My Sessions (icon only) — visible when logged in -->
                            <Button x:Name="SessionsBtn"
                                    Style="{StaticResource GhostBtn}"
                                    Click="SessionsBtn_Click"
                                    Padding="9,6" Margin="0,0,6,0"
                                    Visibility="Collapsed"
                                    ToolTip="My Sessions — past interview recordings">
                                <TextBlock Text="📋" FontSize="13"/>
                            </Button>

                            <!-- Session Timer — visible while a session is active -->
                            <Border x:Name="SessionTimerBadge" Background="#0D0D0D" CornerRadius="8"
                                    Padding="9,5" Margin="0,0,6,0" VerticalAlignment="Center"
                                    BorderBrush="#1A1A1A" BorderThickness="1"
                                    Visibility="Collapsed" ToolTip="Session duration">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#ef4444" Margin="0,0,5,0"
                                             VerticalAlignment="Center">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.2" Duration="0:0:0.8"
                                                                         AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <TextBlock x:Name="SessionTimerLabel" Text="0:00"
                                               Foreground="#DDDDDD" FontSize="11"
                                               FontWeight="Bold" FontFamily="Segoe UI Mono"/>
                                </StackPanel>
                            </Border>

                            <!-- Credits Badge — always visible, opens profile dropdown -->
                            <Border x:Name="CreditsBadge" CornerRadius="20"
                                    Padding="10,5" Margin="0,0,6,0" VerticalAlignment="Center"
                                    BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonDown="CreditsBadge_Click"
                                    ToolTip="Credits · Click for account menu">
                                <Border.Background>
                                    <SolidColorBrush x:Name="CreditsBadgeBg" Color="#08080E"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush x:Name="CreditsBadgeBorder" Color="#202028"/>
                                </Border.BorderBrush>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="CreditsIcon" Text="⚡" FontSize="10"
                                               Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CreditsLabel" Text="55"
                                               Foreground="#4ade80" FontSize="11"
                                               FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="CreditsPlanLabel" Text=" left"
                                               Foreground="#4ade80" FontSize="11"
                                               FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Border>

                            <!-- Profile Badge — always visible (GU = Guest User when not signed in) -->
                            <Border x:Name="ProfileBadge" CornerRadius="20" Padding="8,5"
                                    Margin="0,0,6,0" VerticalAlignment="Center"
                                    Background="#0F0F0F" BorderBrush="#1A1A1A" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonDown="ProfileBadge_Click"
                                    ToolTip="Account menu">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#1A1A1A" Margin="0,0,6,0">
                                        <TextBlock x:Name="AvatarInitials" Text="GU"
                                                   Foreground="#DDDDDD" FontSize="9" FontWeight="Bold"
                                                   FontFamily="Segoe UI" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="ProfileNameLabel" Text=""
                                               Foreground="White" FontSize="11" FontWeight="SemiBold"
                                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    <TextBlock Text=" ▾" Foreground="#3d4d5f" FontSize="10"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Sign In btn (hidden — only kept for code compat) -->
                            <Button x:Name="SignInHeaderBtn" Visibility="Collapsed"
                                    Click="SignInHeaderBtn_Click" Style="{StaticResource BlueBtn}"
                                    Content="Sign In" Padding="10,6" Margin="0,0,6,0"/>

                            <!-- Window controls -->
                            <Button Content="–" Foreground="#555" Background="Transparent"
                                    BorderThickness="0" Click="MinimizeBtn_Click"
                                    FontSize="18" ToolTip="Minimize" Cursor="Hand"
                                    Padding="6,0" Margin="0,0,2,0"/>
                            <Button Content="✕" Foreground="#666" Background="Transparent"
                                    BorderThickness="0" Click="CloseBtn_Click"
                                    ToolTip="Close" Cursor="Hand" Padding="6,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- BODY -->
                <Grid Grid.Row="1" Margin="18,16,18,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ResumeColumn" Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="ResumePanel" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="ContentRow" Height="*"/>
                            <RowDefinition x:Name="AskGuideRow" Height="170"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ── TAB BAR + ACTION BUTTONS ─────────────────────── -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Tabs -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="ResumeTabBorder"
                                        Background="#A0060810" CornerRadius="8"
                                        BorderBrush="#55FFFFFF" BorderThickness="1"
                                        Cursor="Hand" MouseLeftButtonDown="ResumeTabBtn_Click"
                                        Padding="11,5" Margin="0,0,4,0">
                                    <TextBlock x:Name="ResumeTabLabel" Text="Resume" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#DDDDDD" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="JobTabBorder"
                                        Background="#80060810" CornerRadius="8"
                                        BorderBrush="#20FFFFFF" BorderThickness="1"
                                        Cursor="Hand" MouseLeftButtonDown="JobTabBtn_Click"
                                        Padding="11,5">
                                    <TextBlock x:Name="JobTabLabel" Text="Target Role" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#4b6070" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <!-- Action buttons — icon-only to keep tab bar compact -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="6,0,0,0">
                                <Button x:Name="SavedResumesBtn" Style="{StaticResource GhostBtn}"
                                        Click="SavedResumesBtn_Click" Padding="6,4" Margin="0,0,3,0"
                                        Visibility="Collapsed" ToolTip="Load a saved resume">
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="#94A3B8"/>
                                </Button>
                                <Button x:Name="ResumeUploadBtn" Style="{StaticResource GhostBtn}"
                                        Click="ResumeUploadBtn_Click" Padding="6,4"
                                        ToolTip="Upload a PDF, DOCX or TXT resume">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="#94A3B8"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ── RESUME TAB CONTENT ────────────────────────────── -->
                        <Grid x:Name="ResumeTabPanel" Grid.Row="1">
                            <Border x:Name="ResumeDropBorder" Background="#B0060810" CornerRadius="14"
                                    BorderBrush="#28FFFFFF" BorderThickness="1"
                                    AllowDrop="True"
                                    DragEnter="ResumeDropBorder_DragEnter"
                                    DragOver="ResumeDropBorder_DragOver"
                                    DragLeave="ResumeDropBorder_DragLeave"
                                    Drop="ResumeDropBorder_Drop">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" Color="Black"/>
                                </Border.Effect>
                                <Grid>
                                    <TextBox x:Name="ResumeTextBox" TextWrapping="Wrap" AcceptsReturn="True"
                                              Background="Transparent" Foreground="#D7E2F0" BorderThickness="0"
                                             Padding="14" VerticalScrollBarVisibility="Auto"
                                             FontFamily="Segoe UI" FontSize="12"
                                             TextChanged="ResumeTextBox_TextChanged"/>
                                    <TextBlock x:Name="ResumeWatermark"
                                               Foreground="#6E849F" FontSize="12" TextWrapping="Wrap"
                                               Margin="14,14,14,14" VerticalAlignment="Top"
                                               IsHitTestVisible="False" FontStyle="Italic" FontFamily="Segoe UI">
                                        Paste your resume here, or drag &amp; drop a PDF / DOCX / TXT — or click Upload.&#x0a;&#x0a;With it, every answer is tailored to your exact experience and skills.
                                    </TextBlock>
                                    <!-- Drag-over overlay -->
                                    <Border x:Name="ResumeDragOverlay" CornerRadius="14"
                                            Background="#40FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="2"
                                            Visibility="Collapsed" IsHitTestVisible="False">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="⬇" FontSize="28" Foreground="#CCCCCC"
                                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="Drop to load resume" Foreground="White"
                                                       FontSize="12" FontWeight="Bold" FontFamily="Segoe UI"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Interview lock overlay -->
                                    <Border x:Name="ResumeLockOverlay" CornerRadius="14"
                                            Background="#CC030712" Visibility="Collapsed"
                                            IsHitTestVisible="False">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="Locked during interview" Foreground="#f59e0b"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" FontFamily="Segoe UI"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Text="Use ASK or GUIDE below ↓" Foreground="#57534e"
                                                       FontSize="10" HorizontalAlignment="Center"
                                                       FontFamily="Segoe UI"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ── TARGET ROLE TAB CONTENT (hidden by default) ────── -->
                        <Grid x:Name="JobTabPanel" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Company name -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="COMPANY" Foreground="#3d4d5f" FontSize="8"
                                           FontWeight="Bold" FontFamily="Segoe UI" Margin="2,0,0,4"/>
                                <Border Grid.Row="1" Background="#CC08080E" CornerRadius="8"
                                        BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <TextBox x:Name="CompanyNameBox" Background="Transparent"
                                                 Foreground="White" BorderThickness="0"
                                                 Padding="10,8" FontSize="13" FontFamily="Segoe UI"
                                                 CaretBrush="White"
                                                 TextChanged="CompanyNameBox_TextChanged"/>
                                        <TextBlock x:Name="CompanyNameWatermark" Text="e.g.  Stripe, Google, Citi…"
                                                   Foreground="#1A1A1A" FontSize="12" FontStyle="Italic"
                                                   Margin="10,8,10,8" FontFamily="Segoe UI"
                                                   IsHitTestVisible="False" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <!-- Job description -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="JOB DESCRIPTION" Foreground="#3d4d5f" FontSize="8"
                                           FontWeight="Bold" FontFamily="Segoe UI" Margin="2,0,0,4"/>
                                <Border Grid.Row="1" Background="#B0060810" CornerRadius="14"
                                        BorderBrush="#28FFFFFF" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.16" Color="Black"/>
                                    </Border.Effect>
                                    <Grid>
                                        <TextBox x:Name="JobDescBox" TextWrapping="Wrap" AcceptsReturn="True"
                                                  Background="Transparent" Foreground="#D7E2F0" BorderThickness="0"
                                                 Padding="13" VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Segoe UI" FontSize="12"
                                                 TextChanged="JobDescBox_TextChanged"/>
                                        <TextBlock x:Name="JobDescWatermark" Foreground="#6E849F" FontSize="12"
                                                   TextWrapping="Wrap" Margin="13,13,13,13" VerticalAlignment="Top"
                                                   IsHitTestVisible="False" FontStyle="Italic" FontFamily="Segoe UI">
                                            Paste the job description — role, required skills, tech stack.&#x0a;&#x0a;The AI will tailor every answer to exactly what this company needs.
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ── RESUME LOADED BADGE (shown when content is auto-collapsed) ── -->
                        <Border x:Name="ResumeLoadedBadge" Grid.Row="1"
                                Background="#08080E" CornerRadius="8"
                                BorderBrush="#202028" BorderThickness="1"
                                Visibility="Collapsed" Padding="12,9" Margin="0,4,0,6"
                                Cursor="Hand" MouseLeftButtonDown="ResumeLoadedBadge_Click"
                                ToolTip="Click to expand and edit resume">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" Foreground="#4ade80" FontSize="11" FontWeight="Bold"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Resume loaded" Foreground="#DDDDDD" FontSize="10"
                                           FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <TextBlock Text="  — tap to edit" Foreground="#2a4a5a" FontSize="10"
                                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- ── ASK or GUIDE ──────────────────────────────────── -->
                        <Border Grid.Row="2" Background="#B0060810" CornerRadius="12"
                                BorderBrush="#28FFFFFF" BorderThickness="1" Margin="0,10,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.28" Color="Black"/>
                            </Border.Effect>
                            <Grid Margin="12,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,7">
                                    <TextBlock Text="⚡" FontSize="10" Foreground="#fbbf24"
                                               Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ASK or GUIDE" FontSize="10" FontWeight="Bold"
                                               Foreground="#c79a3c" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    <TextBlock Text="  · pin to remember" FontSize="9" Foreground="#6b5630"
                                               FontStyle="Italic" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Input -->
                                <Border Grid.Row="1" Background="#80060810" CornerRadius="8"
                                        BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <TextBox x:Name="AskBox" TextWrapping="Wrap" AcceptsReturn="True"
                                                 Background="Transparent" Foreground="#E4ECF8"
                                                 BorderThickness="0" Padding="10,8"
                                                 FontFamily="Segoe UI" FontSize="12"
                                                 VerticalScrollBarVisibility="Auto"
                                                 CaretBrush="#fbbf24"
                                                 TextChanged="AskBox_TextChanged"
                                                 PreviewKeyDown="AskBox_PreviewKeyDown"/>
                                        <TextBlock x:Name="AskBoxWatermark"
                                                   Foreground="#7589A5" FontSize="11" TextWrapping="Wrap"
                                                   Margin="10,9,10,9" VerticalAlignment="Top"
                                                   IsHitTestVisible="False" FontStyle="Italic" FontFamily="Segoe UI">
                                            Ask a question for an instant answer, or add context the AI should remember…
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Pinned hints display -->
                                <Border x:Name="PinnedHintsBar" Grid.Row="2" Visibility="Collapsed"
                                        Background="#fbbf2412" CornerRadius="6"
                                        Margin="0,6,0,0" Padding="8,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📌" FontSize="9"
                                                   Foreground="#b08930" Margin="0,1,5,0"
                                                   VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" x:Name="PinnedHintsText"
                                                   Foreground="#cbb06a" FontSize="10" TextWrapping="Wrap"
                                                   MaxHeight="44" VerticalAlignment="Top"
                                                   FontFamily="Segoe UI"/>
                                        <Button Grid.Column="2" Content="✕"
                                                Click="ClearHintsBtn_Click"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#6b7280" FontSize="10" Cursor="Hand"
                                                Padding="4,1" VerticalAlignment="Top"
                                                ToolTip="Clear pinned context"/>
                                    </Grid>
                                </Border>

                                <!-- Pin + Ask buttons -->
                                <Grid Grid.Row="3" Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="PinBtn"
                                            Style="{StaticResource GhostBtn}"
                                            Click="PinBtn_Click" Padding="10,7" Margin="0,0,6,0"
                                            ToolTip="Pin as persistent context that steers every AI answer">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📌" FontSize="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="Pin" FontSize="11" FontFamily="Segoe UI"
                                                       Foreground="#fbbf24"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" x:Name="AskSubmitBtn"
                                            Style="{StaticResource BlueBtn}"
                                            Click="AskSubmitBtn_Click" Padding="10,7"
                                            ToolTip="Get an AI answer for this question right now (Ctrl+Enter)">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="Ask" FontSize="12" FontWeight="Bold"
                                                       FontFamily="Segoe UI" Margin="0,0,5,0"/>
                                            <TextBlock Text="→" FontSize="12" FontFamily="Segoe UI"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ── Save path ─────────────────────────────────────── -->
                        <Border Grid.Row="3" Margin="0,8,0,0" Background="#20060810"
                                CornerRadius="10" Padding="10,8">
                            <TextBlock x:Name="SavePathLabel" Foreground="#2a3a4a"
                                       FontSize="9" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                    <Button x:Name="ResumeToggleBtn" Grid.Column="1" Content="◀"
                            Style="{StaticResource ArrowToggleBtn}"
                            Click="ResumeToggleBtn_Click" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>

                        <!-- AI Answer Box — top panel, larger -->
                        <Border Grid.Row="0" Background="#B0060810" CornerRadius="14"
                                BorderBrush="#28FFFFFF" BorderThickness="1" Padding="22,18" Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- ACTION TOOLBAR: Copy · Clear · New Session -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <Border Background="#080808" CornerRadius="6" Padding="8,4">
                                            <TextBlock Text="🤖  AI Answer" Foreground="#DDDDDD"
                                                       FontSize="9" FontWeight="Bold" FontFamily="Segoe UI"/>
                                        </Border>
                                        <Border x:Name="StarBadge" Visibility="Collapsed"
                                                Background="#78350f" CornerRadius="6" Padding="7,3"
                                                Margin="6,0,0,0"
                                                ToolTip="Behavioral question — use STAR: Situation · Task · Action · Result">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⭐" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="STAR" Foreground="#fbbf24" FontSize="9"
                                                           FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button x:Name="CopyAnswerBtn" Content="📋 Copy"
                                                Click="CopyAnswerBtn_Click"
                                                Style="{StaticResource GhostBtn}"
                                                Padding="10,5" Margin="0,0,6,0"
                                                ToolTip="Copy answer to clipboard"/>
                                        <Button x:Name="ClearAnswerBtn" Content="✕ Clear"
                                                Click="ClearAnswerBtn_Click"
                                                Style="{StaticResource GhostBtn}"
                                                Padding="10,5" Margin="0,0,6,0"
                                                ToolTip="Clear current transcript and answer"/>
                                        <Button x:Name="NewSessionBtn" Content="＋ New Session"
                                                Click="NewSessionBtn_Click"
                                                Style="{StaticResource GreenBtn}"
                                                Padding="10,5"
                                                ToolTip="Start a fresh interview session"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- THINKING INDICATOR -->
                                <StackPanel x:Name="ThinkingPanel" Grid.Row="1" Orientation="Horizontal"
                                            Visibility="Collapsed" Margin="0,0,0,10">
                                    <TextBlock x:Name="ThinkingLabel" Text="Thinking..."
                                               Foreground="#DDDDDD" FontSize="12" FontStyle="Italic"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ThinkingHintLabel" Text=" · F8 all screens  ·  F9 primary"
                                               Foreground="#334466" FontSize="11"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>

                                <!-- ANSWER -->
                                <ScrollViewer Grid.Row="2">
                                    <Grid>
                                        <TextBox x:Name="AiAnswerBox"
                                                 Text=""
                                                 Background="Transparent" Foreground="#E2E8F0"
                                                 BorderThickness="0" FontSize="15"
                                                 FontFamily="Segoe UI"
                                                 TextWrapping="Wrap" IsReadOnly="True"
                                                 TextChanged="AiAnswerBox_TextChanged"/>
                                        <TextBlock x:Name="AiAnswerHint"
                                                   Text="Ready. Press SPACE to start listening, then SPACE again to get your answer."
                                                   Foreground="#E2E8F0" FontSize="15" Opacity="0.5"
                                                   FontFamily="Segoe UI"
                                                   TextWrapping="Wrap" IsHitTestVisible="False"
                                                   VerticalAlignment="Top" HorizontalAlignment="Left"
                                                   Visibility="Visible"/>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Transcript Box — bottom panel, smaller -->
                        <Border Grid.Row="1" Background="#B0060810" CornerRadius="14"
                                BorderBrush="#28FFFFFF" BorderThickness="1" Padding="22,18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Hotkey bar + section label -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="INTERVIEWER" Foreground="#2A4A6A" FontSize="9"
                                               FontWeight="Bold" FontFamily="Segoe UI"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Border Background="#0D0D0D" CornerRadius="5" Padding="8,3" Margin="0,0,6,0">
                                            <TextBlock Text="SPACE · listen → answer" Foreground="#DDDDDD"
                                                       FontSize="9" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                        </Border>
                                        <Border Background="#08080E" CornerRadius="5" Padding="8,3" Margin="0,0,6,0">
                                            <TextBlock Text="F8 · all screens" Foreground="#4ade80"
                                                       FontSize="9" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                        </Border>
                                        <Border Background="#08080E" CornerRadius="5" Padding="8,3" Margin="0,0,6,0">
                                            <TextBlock Text="F9 · primary" Foreground="#86efac"
                                                       FontSize="9" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                        </Border>
                                        <Border Background="#08080E" CornerRadius="5" Padding="8,3">
                                            <TextBlock Text="F12 · debug" Foreground="#DDDDDD"
                                                       FontSize="9" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <!-- Transcript scroll + hint -->
                                <Grid Grid.Row="1">
                                    <ScrollViewer x:Name="TranscriptScroll">
                                        <TextBlock x:Name="TranscriptTextBlock" Foreground="White"
                                                   FontSize="15" FontFamily="Segoe UI"
                                                   LineHeight="24" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                    <StackPanel x:Name="TranscriptHint"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                IsHitTestVisible="False" Visibility="Visible">
                                        <Border Width="44" Height="44" CornerRadius="22"
                                                Background="#0D0D0D" BorderBrush="#222222" BorderThickness="1"
                                                HorizontalAlignment="Center" Margin="0,0,0,14">
                                            <TextBlock Text="🎙" FontSize="18" Foreground="#DDDDDD"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Ready when you are" Foreground="#666666" FontSize="14"
                                                       FontWeight="SemiBold" FontFamily="Segoe UI"
                                                       HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                            <TextBlock Text="Your conversation will appear here" Foreground="#303030"
                                                       FontSize="11" FontFamily="Segoe UI"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- CAMERA MODE -->
            <Grid x:Name="CameraModeGrid" Visibility="Collapsed" VerticalAlignment="Top" Height="110">
                <Border Background="#E606080E" CornerRadius="0,0,14,14" BorderBrush="#55FFFFFF" BorderThickness="0,0,0,1">
                    <Grid Margin="20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource MicBtnStyle}" Click="MicBtn_Click" Width="40" Height="40"/>
                        <ScrollViewer Grid.Column="1" Margin="20,0">
                            <TextBlock x:Name="CamAnswerBox" Text="Ready..." Foreground="White"
                                       FontSize="18" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
                        </ScrollViewer>
                        <Button Grid.Column="2" Content="Exit" Style="{StaticResource GhostBtn}"
                                Click="ExitCameraMode_Click" Padding="10,5"/>
                    </Grid>
                </Border>
            </Grid>


            <!-- ══ SAVED RESUMES POPUP ═════════════════════════════════════ -->
            <Popup x:Name="SavedResumesPopup"
                   Placement="Bottom" StaysOpen="True"
                   AllowsTransparency="True" PopupAnimation="Fade"
                   VerticalOffset="4">
                <Border Background="#111111" BorderBrush="#1C1C1C" BorderThickness="1"
                        CornerRadius="12" MinWidth="224" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.55" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Save action -->
                        <Border x:Name="SaveResumePopupItem" Padding="14,10" Cursor="Hand"
                                MouseLeftButtonDown="SaveResumePopupItem_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1C1C1C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="#DDDDDD" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save current resume" Foreground="#e6edf3"
                                           FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="#1C1C1C"/>

                        <!-- Dynamic saved resume entries -->
                        <StackPanel x:Name="SavedResumesListPanel"/>

                        <Border Height="1" Background="#1C1C1C" x:Name="ClearSeparator" Visibility="Collapsed"/>

                        <!-- Clear action -->
                        <Border x:Name="ClearResumesPopupItem" Padding="14,10" Cursor="Hand"
                                Visibility="Collapsed" MouseLeftButtonDown="ClearResumesPopupItem_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#200a0a"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="#ef4444" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Clear saved resumes" Foreground="#ef4444"
                                           FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- ══ PROFILE DROPDOWN POPUP ══════════════════════════════════ -->
            <Popup x:Name="ProfileDropdownPopup"
                   Placement="Bottom" StaysOpen="True"
                   AllowsTransparency="True" PopupAnimation="Fade"
                   HorizontalOffset="-200" VerticalOffset="6">
                <Border Background="#111111" BorderBrush="#303030" BorderThickness="1"
                        CornerRadius="12" Width="296" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>

                        <!-- User info -->
                        <Grid Margin="16,14,16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="23"
                                    Background="#1A1A1A" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PopupAvatarInitials" Text="GU" Foreground="#DDDDDD"
                                           FontSize="16" FontWeight="Bold" FontFamily="Segoe UI"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="PopupProfileName" Text="Guest"
                                           Foreground="White" FontSize="14" FontWeight="SemiBold"
                                           FontFamily="Segoe UI"/>
                                <TextBlock x:Name="PopupProfileStatus" Text="Free trial — not signed in"
                                           Foreground="#6b7280" FontSize="11" FontFamily="Segoe UI"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#303030"/>

                        <!-- Credits card -->
                        <Border x:Name="PopupCreditsCard" Margin="12,10,12,10" CornerRadius="8"
                                BorderThickness="1" Padding="12,10">
                            <Border.Background>
                                <SolidColorBrush x:Name="PopupCreditsBg" Color="#08080E"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="PopupCreditsBorder" Color="#202028"/>
                            </Border.BorderBrush>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PopupCreditsAmount" Text="55 credits"
                                                   Foreground="#4ade80" FontSize="14"
                                                   FontWeight="Bold" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PopupCreditsPlan" Text="Free trial"
                                               Foreground="#4b5563" FontSize="11"
                                               FontFamily="Segoe UI" Margin="0,3,0,0"/>
                                </StackPanel>
                                <!-- Sign In button inside credits card (shown when guest) -->
                                <Button Grid.Column="1" x:Name="PopupSignInCardBtn"
                                        Click="PopupSignIn_Click" Cursor="Hand"
                                        Foreground="White" FontSize="12" FontFamily="Segoe UI"
                                        FontWeight="SemiBold" Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="#2A2A2A" CornerRadius="6" Padding="12,6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#383838"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="Sign In" FontSize="12" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="#303030"/>

                        <!-- Window + Eye mode opacity (shared) -->
                        <StackPanel Margin="16,12,16,10">
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◐" FontSize="13" Margin="0,0,8,0"
                                               Foreground="#94a3b8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Both windows opacity" Foreground="#94a3b8"
                                               FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="PopupOpacityLabel" Text="80%"
                                           Foreground="#DDDDDD" FontSize="13" FontWeight="Bold"
                                           FontFamily="Segoe UI" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="PopupOpacitySlider" Minimum="1" Maximum="100" Value="50"
                                    ValueChanged="PopupOpacitySlider_ValueChanged"/>
                        </StackPanel>

                        <Border Height="1" Background="#303030"/>

                        <!-- Settings row -->
                        <Border Cursor="Hand" MouseLeftButtonDown="PopupSettings_Click" Padding="16,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1C1C1C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="15" Margin="0,0,12,0"
                                           Foreground="#6b7280" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Settings" Foreground="White" FontSize="13"
                                               FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="AI model · audio · appearance" Foreground="#4b5563"
                                               FontSize="11" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="#303030" Margin="16,0"/>

                        <!-- Past Sessions row -->
                        <Border Cursor="Hand" MouseLeftButtonDown="PopupSessions_Click" Padding="16,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1C1C1C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕒" FontSize="15" Margin="0,0,12,0"
                                           Foreground="#6b7280" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Past Sessions" Foreground="White" FontSize="13"
                                               FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Review previous interviews" Foreground="#4b5563"
                                               FontSize="11" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="#303030" Margin="16,0"/>

                        <!-- Sign In row (guest) -->
                        <Border x:Name="PopupSignInRow" Cursor="Hand"
                                MouseLeftButtonDown="PopupSignIn_Click" Padding="16,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1C1C1C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" FontSize="15" Margin="0,0,12,0"
                                           Foreground="#6b7280" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Sign In" Foreground="White" FontSize="13"
                                               FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Save your progress &amp; unlock more credits"
                                               Foreground="#4b5563" FontSize="11" FontFamily="Segoe UI"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Sign Out row (signed in only) -->
                        <Border x:Name="PopupSignOutRow" Visibility="Collapsed"
                                Cursor="Hand" MouseLeftButtonDown="PopupSignOut_Click" Padding="16,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1e0a0a"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↩" FontSize="15" Margin="0,0,12,0"
                                           Foreground="#ef4444" VerticalAlignment="Center"/>
                                <TextBlock Text="Sign Out" Foreground="#ef4444" FontSize="13"
                                           FontWeight="SemiBold" FontFamily="Segoe UI"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
            </Popup>

        </Grid>
    </Border>
</Window>
