            <!-- ================= LISTENING MODE POPUP ================= -->
            <!-- ================= SAVED RESUMES POPUP ================= -->
            <Popup x:Name="SavedResumesPopup" Placement="Bottom" StaysOpen="True"
                   AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="7">
                <!-- Outer margin leaves room for the drop shadow so it isn't clipped -->
                <Border Padding="0,0,0,14">
                    <Border Background="#F00A1220" BorderBrush="#33FFFFFF" BorderThickness="1"
                            CornerRadius="14" MinWidth="268" Padding="6">
                        <!-- A menu floats above the app, so unlike the panels inside
                             it this one stays nearly opaque: text over a moving
                             desktop is hard to read, and a menu is only on screen
                             for a moment. The lift comes from the shadow instead. -->
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.72" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Header -->
                            <!-- Letter-spaced and dimmer than the content it labels. A
                                 heading that competes with the list under it is the
                                 commonest way a small menu starts to feel cluttered. -->
                            <TextBlock Text="SAVED RESUMES" Foreground="#63758C"
                                       FontSize="8.5" FontWeight="Bold" FontFamily="Segoe UI"
                                       Margin="12,9,10,9"/>

                            <!-- Save current resume -->
                            <Border x:Name="SaveResumePopupItem" Padding="11,10" Cursor="Hand"
                                    CornerRadius="8" Margin="1,0" MouseLeftButtonDown="SaveResumePopupItem_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <!-- The one thing in this menu that creates something,
                                     carrying the accent so it is not mistaken for one
                                     more row of history. -->
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="24" Height="24" CornerRadius="7" Background="#2634E08A"
                                            BorderBrush="#4D34E08A" BorderThickness="1" Margin="0,0,11,0">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"
                                                   Foreground="#34E08A" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Save current resume" Foreground="#EAF1F8"
                                               FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="#1B2A3C" Margin="10,6,10,8"/>

                            <StackPanel x:Name="SavedResumesListPanel"/>

                            <!-- Kept named and in place: the code shows and hides this
                                 with the Clear row. Spacing alone separates the
                                 destructive action now, so the rule stays invisible. -->
                            <Border Height="1" Background="Transparent" Margin="0,6,0,0"
                                    x:Name="ClearSeparator" Visibility="Collapsed"/>

                            <!-- Clear saved resumes -->
                            <Border x:Name="ClearResumesPopupItem" Padding="11,10" Cursor="Hand"
                                    CornerRadius="8" Margin="1,0" Visibility="Collapsed"
                                    MouseLeftButtonDown="ClearResumesPopupItem_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2A1518"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="#3A1A1E"
                                            Margin="0,0,11,0">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="#F98A90" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Clear saved resumes" Foreground="#F98A90"
                                               FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Border>
            </Popup>

