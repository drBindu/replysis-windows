                                <TextBlock Text="Your live interview workspace. Here's how it works."
                                           Foreground="#A6B8D2" FontSize="12.5" FontWeight="SemiBold"
                                           FontFamily="Segoe UI" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Steps -->
                        <StackPanel Margin="26,20,26,4">
                            <!-- 1. Resume -->
                            <Grid Margin="0,0,0,17">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                        Background="#2C3A54" Margin="0,0,15,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="#C6D4E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Upload your resume" Foreground="#EAF1F8"
                                               FontSize="13.5" FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Tailors every answer to your real experience, projects and tools."
                                               Foreground="#93A9C4" FontSize="11.5" FontWeight="SemiBold"
                                               FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 2. Company -->
                            <Grid Margin="0,0,0,17">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                        Background="#2C3A54" Margin="0,0,15,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="#C6D4E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Add the company &amp; role" Foreground="#EAF1F8"
                                               FontSize="13.5" FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Gives sharper, role-specific answers for the exact job you're interviewing for."
                                               Foreground="#93A9C4" FontSize="11.5" FontWeight="SemiBold"
                                               FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 3. Stealth -->
                            <Grid Margin="0,0,0,17">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                        Background="#33280F" Margin="0,0,15,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="#F3C64D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Check capture protection before the call" Foreground="#EAF1F8"
                                               FontSize="13.5" FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Stealth mode applies Windows capture exclusion. Support varies, so use Setup Check and verify it in your meeting app."
                                               Foreground="#93A9C4" FontSize="11.5" FontWeight="SemiBold"
                                               FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 4. Space (last — the action you take in the interview) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                        Background="#2C3A54" Margin="0,0,15,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                               Foreground="#C6D4E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Then press SPACE for an instant answer" Foreground="#EAF1F8"
                                               FontSize="13.5" FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="In the interview: tap once to start listening, tap again to get your AI answer. Works from any app."
                                               Foreground="#93A9C4" FontSize="11.5" FontWeight="SemiBold"
                                               FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Footer -->
                        <Border BorderBrush="#1B2A3E" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="26,16,26,20">
                            <Grid>
                                <TextBlock Text="Reopen anytime from the ? button" Foreground="#5E7288"
                                           FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Button x:Name="OnboardingCloseBtn" Click="OnboardingClose_Click"
                                        HorizontalAlignment="Right" Cursor="Hand" Padding="0" BorderThickness="0" Background="Transparent">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Pb" CornerRadius="10" Padding="26,10"
                                                    Background="#1E9E63">
                                                <TextBlock Text="Get Started" Foreground="#FFFFFF" FontSize="13"
                                                           FontWeight="Bold" FontFamily="Segoe UI"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Pb" Property="Background" Value="#24B672"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Pb" Property="Background" Value="#158B58"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
