<Window x:Class="InterviewCopilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replysis AI"
        Icon="pack://siteoforigin:,,,/Assets/replysis-icon-1024.png"
        Height="600" Width="980"
        MinHeight="500" MinWidth="820"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        ShowInTaskbar="True"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Opacity="1"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>

        <!-- PRIMARY. Was an indigo-to-blue gradient despite the name, which is
             why the primary button read as purple against an otherwise emerald
             product. Now matches the brand and its own name. -->
        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#8034E08A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#25B978" Offset="0"/>
                        <GradientStop Color="#158B58" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#34E08A" Offset="0"/>
                                            <GradientStop Color="#1E9E63" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#84E7B6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DANGER (rose crimson gradient) -->
        <Style x:Key="RedBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#80EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#DC2626" Offset="0"/>
                        <GradientStop Color="#991B1B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FCA5A5"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#EF4444" Offset="0"/>
                                            <GradientStop Color="#B91C1C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GHOST (soft slate blue glass) -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#5685B8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#38495F" Offset="0"/>
                        <GradientStop Color="#2A3B4E" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BdScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BdScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.045" Duration="0:0:0.13">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="BdScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.045" Duration="0:0:0.13">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BdScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.17"/>
                                            <DoubleAnimation Storyboard.TargetName="BdScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.17"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3A4E64" Offset="0"/>
                                            <GradientStop Color="#2A3D50" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#79A9DA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════
             TOOLBAR PILL SYSTEM
             The top bar had been hand-tuned pill by pill, so adjacent controls
             carried three corner radii (11 / 9 / 7), three paddings and three
             label sizes, and one label was sentence case among small caps. These
             styles are the single definition, so the row lines up by
             construction instead of by matching numbers across the file.
             ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="ToolbarPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#101827"/>
            <Setter Property="BorderBrush" Value="#26364C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Same geometry, no pointer: read-only status such as the timer. -->
        <Style x:Key="ToolbarBadge" TargetType="Border" BasedOn="{StaticResource ToolbarPill}">
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#16FFFFFF"/>
        </Style>

        <Style x:Key="ToolbarPillLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#A9B6C8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolbarPillIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#84E7B6"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolbarPillChevron" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE70D;"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="#6F8198"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Segmented group: related actions share one outline so the row carries
             fewer objects than it does controls. -->
        <Style x:Key="ToolbarGroup" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#101827"/>
            <Setter Property="BorderBrush" Value="#26364C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- One action inside a group. Carries no outline of its own; the hover
             tint is what tells you the halves are separately clickable. -->
        <Style x:Key="ToolbarSegment" TargetType="Border">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#182438"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarSegmentDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Background" Value="#22344A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Separates the row into what you do, how you appear, and who you are,
             so nine controls read as three short groups rather than one run. -->
        <Style x:Key="ToolbarDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="#22344A"/>
            <Setter Property="Margin" Value="3,0,9,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- MIC (circular gradient glass) -->
        <!-- Premium circular mic button. The accent RING + outer glow are recolored
             by state in UpdateMicUi (via BorderBrush); the body stays a refined dark
             slate so the state color reads cleanly against it. -->
        <Style x:Key="MicBtnStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="1.6"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <!-- Main body: soft radial gradient for depth -->
                            <Ellipse x:Name="Body" Margin="2">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.35,0.28" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                        <GradientStop Color="#1E293B" Offset="0"/>
                                        <GradientStop Color="#0B1220" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Glassy top highlight for a premium sheen -->
                            <Ellipse x:Name="Gloss" Margin="7,5,7,22" Opacity="0.22">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Accent ring (state color, driven by BorderBrush) -->
                            <Ellipse x:Name="Ring"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{TemplateBinding BorderThickness}"/>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Fill">
                                    <Setter.Value>
                                        <RadialGradientBrush GradientOrigin="0.35,0.28" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                            <GradientStop Color="#293548" Offset="0"/>
                                            <GradientStop Color="#111A2B" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.07" ScaleY="1.07"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Gloss" Property="Opacity" Value="0.32"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PANEL TOGGLE -->
        <Style x:Key="ArrowToggleBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="2,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SECTION CAPTION -->
        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

    </Window.Resources>

    <!-- ====================================================================
         MAIN CONTAINER  &#183;  pure glass on near-black
    ===================================================================== -->
    <Border x:Name="MainAppBorder" CornerRadius="16"
            BorderBrush="#1AFFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Background>
            <SolidColorBrush Color="#090B12"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" ShadowDepth="16" Opacity="0.80" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid x:Name="NormalModeGrid">
                <Grid.RowDefinitions>
                    <!-- 60 left the mic short of room: the button is 46 and its glow
                         blurs out past that, so the ring and halo were sliced flat by
                         the window edge. 72 clears the button plus its widest pulse. -->
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->
                <Border Grid.Row="0" CornerRadius="16,16,0,0"
                        BorderBrush="#1E2C40" BorderThickness="0,0,0,1"
                        Background="#0AFFFFFF">
                    <Grid Margin="18,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Brand -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Width="35" Height="35" Margin="0,0,12,0"
                                   Source="pack://siteoforigin:,,,/Assets/replysis-icon-1024.png"
                                   Stretch="Uniform" SnapsToDevicePixels="True"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Replysis AI" Foreground="#F5F8FC" FontSize="14.5"
                                           FontWeight="Bold" FontFamily="Segoe UI"/>
                                <TextBlock Text="I N T E R V I E W   I N T E L L I G E N C E" Foreground="#8598B4"
                                           FontSize="7.5" FontWeight="Bold" FontFamily="Segoe UI" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Mic + status -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="MicBtn" Style="{StaticResource MicBtnStyle}"
                                    Click="MicBtn_Click" Margin="0,0,13,0">
                                <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#F1F5F9"/>
                                <Button.Effect>
                                    <DropShadowEffect x:Name="MicGlow" Color="#10B981"
                                                      BlurRadius="8" ShadowDepth="0"/>
                                </Button.Effect>
                            </Button>
                            <!-- The mic already carries its state in the ring colour and
                                 glow, so boxing the same state in a bordered pill beside
                                 it counted twice and added another button to the row.
                                 The label reads as part of the mic now. The pill and its
                                 glow keep their names because UpdateMicUi drives them. -->
                            <Border x:Name="MicStatusPill" Background="Transparent"
                                    BorderThickness="0" Padding="0" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="MicPillGlow" BlurRadius="11" ShadowDepth="0"
                                                      Opacity="0" Color="#10B981"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="MicIndicator" Width="7" Height="7"
                                             Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MicIndicatorText" Text="READY"
                                               Foreground="#EAF1F8" FontWeight="Bold" FontSize="10.5"
                                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- One compact selector keeps Manual and both hands-free modes organized. -->
                            <Border x:Name="AutoModePill" Style="{StaticResource ToolbarPill}"
                                    Margin="8,0,0,0"
                                    MouseLeftButtonDown="AutoModePill_Click"
                                    ToolTip="Choose Manual, Interview Auto or Practice Auto">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="AutoModeGlow" BlurRadius="11" ShadowDepth="0"
                                                      Opacity="0" Color="#34E08A"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="AutoModeDot" Width="6" Height="6" Fill="#607086"
                                             Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AutoModeLabel" Text="MANUAL"
                                               Style="{StaticResource ToolbarPillLabel}"/>
                                    <TextBlock x:Name="AutoModeChevron"
                                               Style="{StaticResource ToolbarPillChevron}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- keeps the old AnalyzeLabel name alive off-screen for code that sets it -->
                            <TextBlock x:Name="AnalyzeLabel" Visibility="Collapsed"/>

                            <!-- Screen AI and region select were unlabeled icon buttons a new user
                                 could not tell apart without a tooltip. One labeled pill, same
                                 pattern as the mode selector below, opens a menu naming each
                                 option. F8/F9 keep working unchanged. Compact overlay used to sit
                                 in this menu, but it is a display mode rather than a way to read
                                 the screen, so it has its own pill and is no longer hidden here. -->
                            <!-- Analyze and Compact share one outline instead of floating as
                                 two more separate pills. Same two actions, one object in the
                                 row, which is what stops the bar reading as a wall of
                                 buttons. Compact stays out here rather than inside the
                                 Analyze menu: it was the least-discovered feature in the app
                                 and it is not a way of reading the screen. -->
                            <Border Style="{StaticResource ToolbarGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- A switch, not a menu. It held one item, so the
                                         chevron promised a choice that was not there and cost
                                         two clicks and a read to reach a thing that is either
                                         on or off. -->
                                    <Border x:Name="AnalyzePill" Style="{StaticResource ToolbarSegment}"
                                            MouseLeftButtonDown="WatchScreenOption_Click"
                                            ToolTip="Turn on while the interviewer is sharing their screen: every question is then answered from what is on screen.  &#183;  Any time without this: F8 reads this screen once, F9 your main screen, F7 drags a box around one part.">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="WatchScreenIcon" Text="&#xE7F4;"
                                                       Style="{StaticResource ToolbarPillIcon}"/>
                                            <TextBlock x:Name="WatchScreenPillLabel" Text="WATCH SCREEN"
                                                       Style="{StaticResource ToolbarPillLabel}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ToolbarSegmentDivider}"/>

                                    <Border x:Name="CompactOverlayPill" Style="{StaticResource ToolbarSegment}"
                                            MouseLeftButtonDown="CompactOverlayPill_Click"
                                            ToolTip="Shrink to a slim bar at the top of your screen for in-person interviews  &#183;  the full window comes back when you exit">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE890;" Style="{StaticResource ToolbarPillIcon}"/>
                                            <TextBlock Text="COMPACT" Style="{StaticResource ToolbarPillLabel}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Stealth lives in Settings only. It was a pill here as well,
                                 spending toolbar width on a setting almost nobody changes
                                 mid-interview, and stealth is on by default. -->

                            <!-- Help moved into the profile menu ("How it works") to declutter -->

                            <!-- Session timer -->
                            <Border x:Name="SessionTimerBadge" Style="{StaticResource ToolbarBadge}"
                                    Visibility="Collapsed" ToolTip="Session duration">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Fill="#F87171" Margin="0,0,6,0"
                                             VerticalAlignment="Center">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.2" Duration="0:0:0.9"
                                                                         AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <TextBlock x:Name="SessionTimerLabel" Text="0:00"
                                               Foreground="#FFFFFF" FontSize="11"
                                               FontWeight="Bold" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>

                            <!-- Credits — hidden from the top bar to declutter; still shown in the profile menu -->
                            <Border x:Name="CreditsBadge" CornerRadius="18" Padding="10,4" Margin="0,0,4,0"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonDown="CreditsBadge_Click"
                                    ToolTip="Credits  &#183;  click to refresh or view pricing">
                                <Border.Background>
                                    <SolidColorBrush x:Name="CreditsBadgeBg" Color="#0DFFFFFF"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush x:Name="CreditsBadgeBorder" Color="#1AFFFFFF"/>
                                </Border.BorderBrush>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="CreditsIcon" Text="" FontSize="10"
                                               Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CreditsLabel" Text="&#x26A1; 70"
                                               Foreground="#FFFFFF" FontSize="11"
                                               FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="CreditsPlanLabel" Text=" left"
                                               Foreground="#A0A0A4" FontSize="11" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ToolbarDivider}"/>

                            <!-- Profile -->
                            <Border x:Name="ProfileBadge" CornerRadius="18" Padding="7,4" Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonDown="ProfileBadge_Click"
                                    ToolTip="Account menu">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="11"
                                            Background="#22FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                            Margin="0,0,6,0">
                                        <Grid>
                                            <TextBlock x:Name="AvatarInitials" Text="GU"
                                                       Foreground="White" FontSize="8.5" FontWeight="Bold"
                                                       FontFamily="Segoe UI" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Ellipse x:Name="AvatarPhoto" Width="22" Height="22"
                                                     Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="ProfileNameLabel" Text=""
                                               Foreground="#E0E0E4" FontSize="11" FontWeight="Medium"
                                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="#59FFFFFF" FontSize="8"
                                               Margin="5,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="SignInHeaderBtn" Visibility="Collapsed"
                                    Click="SignInHeaderBtn_Click" Style="{StaticResource GhostBtn}"
                                    Content="Sign In" Padding="10,5" Margin="0,0,4,0"/>

                            <!-- Window controls -->
                            <Button Click="MinimizeBtn_Click" ToolTip="Minimize" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Padding="7,0" Margin="2,0,0,0">
                                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="#66FFFFFF"/>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Cursor="Hand" ToolTip="Close" Padding="7,0" Click="CloseBtn_Click"
                                    Background="Transparent" BorderThickness="0">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#66FFFFFF"/>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#22F87171"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= BODY ================= -->
                <Grid Grid.Row="1" Margin="14,12,14,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ResumeColumn" Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- =========================================================
                         SIDE PANEL  &#183;  Interview Setup (tab-less, no dead space)
                    ========================================================== -->
                    <Border x:Name="ResumePanel" Grid.Column="0"
                            CornerRadius="12" BorderBrush="#22FFFFFF" BorderThickness="1"
                            Background="#10FFFFFF" Padding="14,13" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1.15*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>

                            <!-- Title -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#66FFFFFF" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="INTERVIEW SETUP" Style="{StaticResource SectionCaption}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Resume label -->
                            <Grid Grid.Row="1" Margin="0,0,0,7">
                                <TextBlock Text="RESUME" Foreground="#B4B4BA" FontSize="10.5"
                                           FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Premium upload / drop zone. A real Button so click-to-browse
                                 fires reliably; the ResumeTextBox is kept only as a hidden
                                 backing store for the extracted resume text. -->
                            <Button x:Name="ResumeDropBorder" Grid.Row="2" Cursor="Hand"
                                    Click="ResumeCard_Click" AllowDrop="True"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    DragEnter="ResumeDropBorder_DragEnter"
                                    DragOver="ResumeDropBorder_DragOver"
                                    DragLeave="ResumeDropBorder_DragLeave"
                                    Drop="ResumeDropBorder_Drop">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CardBd" CornerRadius="12" BorderBrush="#26FFFFFF"
                                                BorderThickness="1.2" MinHeight="158" Background="#10FFFFFF">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBd" Property="BorderBrush" Value="#3E5A82"/>
                                                <Setter TargetName="CardBd" Property="Background" Value="#16FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CardBd" Property="Background" Value="#1FFFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <TextBox x:Name="ResumeTextBox" Visibility="Collapsed"
                                             TextChanged="ResumeTextBox_TextChanged"/>

                                    <!-- Empty state: upload prompt -->
                                    <StackPanel x:Name="ResumeEmptyState" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" Margin="18" IsHitTestVisible="False">
                                        <Border Width="48" Height="48" CornerRadius="24" Background="#1E2B40"
                                                HorizontalAlignment="Center" Margin="0,0,0,13">
                                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                                                       Foreground="#7FA8E0" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Drop your resume here" Foreground="#E8EEF6" FontSize="13"
                                                   FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                        <TextBlock Text="or click to browse" Foreground="#7E90A8" FontSize="11"
                                                   FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,3,0,11"/>
                                        <Border Background="#16FFFFFF" CornerRadius="6" Padding="9,3" HorizontalAlignment="Center">
                                            <TextBlock Text="PDF  &#183;  DOCX  &#183;  TXT" Foreground="#93A4BA"
                                                       FontSize="9.5" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Loaded state -->
                                    <StackPanel x:Name="ResumeLoadedState" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" Margin="18" Visibility="Collapsed"
                                                IsHitTestVisible="False">
                                        <Border Width="48" Height="48" CornerRadius="24" Background="#13331F"
                                                HorizontalAlignment="Center" Margin="0,0,0,13">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                                                       Foreground="#4ED88F" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="ResumeLoadedName" Text="Resume loaded" Foreground="#E8EEF6"
                                                   FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="235" TextAlignment="Center"/>
                                        <TextBlock Text="click to replace" Foreground="#7E90A8" FontSize="11"
                                                   FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Drag-over overlay -->
                                    <Border x:Name="ResumeDragOverlay" CornerRadius="12"
                                            Background="#12331F" BorderBrush="#34E08A"
                                            BorderThickness="1.5" Visibility="Collapsed"
                                            IsHitTestVisible="False">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="24" Foreground="#BBD6FF"
                                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="Drop to load" Foreground="#FFFFFF"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Previously uploaded resumes (shown only when some exist) -->
                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Button x:Name="SavedResumesBtn" Style="{StaticResource GhostBtn}"
                                        Click="SavedResumesBtn_Click" Padding="0,8"
                                        Visibility="Collapsed" ToolTip="Previously uploaded resumes">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="#93A4BA" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Previous resumes" FontSize="11" FontFamily="Segoe UI"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Divider -->
                            <Border Grid.Row="4" Height="1" Background="#10FFFFFF" Margin="0,14,0,12"/>

                            <!-- Target role label -->
                            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,7">
                                <TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="#66FFFFFF" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="TARGET ROLE" Foreground="#B4B4BA" FontSize="10.5"
                                           FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <TextBlock Text="  tailors every answer" Foreground="#40FFFFFF"
                                           FontSize="9.5" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Company -->
                            <Border Grid.Row="6" Background="#1AFFFFFF" CornerRadius="8"
                                    BorderBrush="#22FFFFFF" BorderThickness="1" Margin="0,0,0,8">
                                <Grid>
                                    <TextBox x:Name="CompanyNameBox" Background="Transparent"
                                             Foreground="#F0F0F2" BorderThickness="0"
                                             Padding="10,8" FontSize="12" FontFamily="Segoe UI" FontWeight="SemiBold"
                                             CaretBrush="#AAAAAA" TextChanged="CompanyNameBox_TextChanged"/>
                                    <TextBlock x:Name="CompanyNameWatermark"
                                               Text="Company  (e.g. Google, Stripe, Amazon)"
                                               Foreground="#66FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="10,8"
                                               FontFamily="Segoe UI" IsHitTestVisible="False"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Job description -->
                            <Border Grid.Row="7" Background="#1AFFFFFF" CornerRadius="10"
                                    BorderBrush="#22FFFFFF" BorderThickness="1">
                                <Grid>
                                    <TextBox x:Name="JobDescBox" TextWrapping="Wrap" AcceptsReturn="True"
                                             Background="Transparent" Foreground="#F0F0F2"
                                             BorderThickness="0" Padding="11"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" CaretBrush="#AAAAAA"
                                             TextChanged="JobDescBox_TextChanged"/>
                                    <TextBlock x:Name="JobDescWatermark" Foreground="#66FFFFFF"
                                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="11"
                                               VerticalAlignment="Top" IsHitTestVisible="False"
                                               FontFamily="Segoe UI"
                                               Text="Paste the role &amp; requirements: title, must-have skills, tech stack, seniority."/>
                                </Grid>
                            </Border>

                            <!-- Hidden ASK/GUIDE + SavePath (kept for code-behind) -->
                            <Grid Grid.Row="7" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBox x:Name="AskBox" TextChanged="AskBox_TextChanged"
                                             PreviewKeyDown="AskBox_PreviewKeyDown"/>
                                    <TextBlock x:Name="AskBoxWatermark"/>
                                    <Border x:Name="PinnedHintsBar" Visibility="Collapsed">
                                        <TextBlock x:Name="PinnedHintsText"/>
                                    </Border>
                                    <Button x:Name="PinBtn" Click="PinBtn_Click"/>
                                    <Button x:Name="AskSubmitBtn" Click="AskSubmitBtn_Click"/>
                                    <Button Click="ClearHintsBtn_Click"/>
                                    <TextBlock x:Name="SavePathLabel"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Panel toggle -->
                    <Button x:Name="ResumeToggleBtn" Grid.Column="1" Content="&#xE76B;"
                            Style="{StaticResource ArrowToggleBtn}"
                            Click="ResumeToggleBtn_Click"
                            VerticalAlignment="Center" Margin="8,0,8,0"/>

                    <!-- =========================================================
                         MAIN CONTENT
                    ========================================================== -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4.2*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="1.4*"/>
                        </Grid.RowDefinitions>

                        <!-- AI ANSWER -->
                        <Border Grid.Row="0" CornerRadius="15"
                                BorderBrush="#2A3A52" BorderThickness="1" Background="#13FFFFFF">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="26" ShadowDepth="7" Opacity="0.42" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#16FFFFFF" CornerRadius="15,15,0,0"
                                        BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1" Padding="16,11">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                                    VerticalAlignment="Center">
                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="8,3"
                                                    Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEA80;" FontFamily="Segoe MDL2 Assets"
                                                               Foreground="#BBBBBF" FontSize="9"
                                                               Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="A I   A N S W E R" Foreground="#9DB1CC"
                                                               FontSize="9" FontWeight="Bold" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="StarBadge" Visibility="Collapsed"
                                                    Background="#14FFFFFF" CornerRadius="6" Padding="7,3">
                                                <TextBlock Text="STAR METHOD" Foreground="#C4C4C8" FontSize="9"
                                                           FontWeight="Bold" FontFamily="Segoe UI"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                                    HorizontalAlignment="Right">
                                            <Button x:Name="CopyAnswerBtn" Style="{StaticResource GhostBtn}"
                                                    Click="CopyAnswerBtn_Click" Padding="9,4" Margin="0,0,5,0"
                                                    ToolTip="Copy answer">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Copy" FontSize="11" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ClearAnswerBtn" Style="{StaticResource GhostBtn}"
                                                    Click="ClearAnswerBtn_Click" Padding="9,4" Margin="0,0,5,0"
                                                    ToolTip="Clear the screen and conversation memory &#183; stays in this session">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Clear" FontSize="11" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="NewSessionBtn" Style="{StaticResource GreenBtn}"
                                                    Click="NewSessionBtn_Click" Padding="12,4"
                                                    ToolTip="Saves this session automatically, then starts a new one with your resume and role still loaded">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="New Session" FontSize="11"/>
                                                    </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="16,8,16,0">
                                    <StackPanel x:Name="ThinkingPanel" Orientation="Horizontal" Visibility="Collapsed">
                                        <Ellipse Width="5" Height="5" Fill="#AAAAAA" Margin="0,0,7,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1" To="0.2" Duration="0:0:0.5"
                                                                             AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <TextBlock x:Name="ThinkingLabel" Text="Thinking..."
                                                   Foreground="#C4C4C8" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ThinkingHintLabel"
                                               Text="F8  this screen    &#183;    F9  main screen    &#183;    SPACE  listen / answer"
                                               Foreground="#94A3B8" FontSize="10" FontWeight="Bold"
                                               VerticalAlignment="Center" FontFamily="Segoe UI" Visibility="Visible"/>
                                </Grid>

                                <ScrollViewer Grid.Row="2" Padding="16,12,16,14">
                                    <Grid>
                                        <TextBox x:Name="AiAnswerBox" Text=""
                                                 Background="Transparent" Foreground="#F1F5F9"
                                                 BorderThickness="0" FontSize="14" FontFamily="Segoe UI"
                                                 FontWeight="SemiBold"
                                                 TextWrapping="Wrap" IsReadOnly="True"
                                                 SelectionBrush="#55FFFFFF"
                                                 TextChanged="AiAnswerBox_TextChanged"/>
                                        <TextBlock x:Name="AiAnswerHint" Foreground="#94A3B8" FontSize="14"
                                                   FontFamily="Segoe UI" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   IsHitTestVisible="False" VerticalAlignment="Top"
                                                   HorizontalAlignment="Left" Visibility="Visible">
                                            Press <Run FontWeight="Bold" Foreground="#FFFFFF">SPACE</Run> to start listening, then <Run FontWeight="Bold" Foreground="#FFFFFF">SPACE</Run> again to get your answer.
                                        </TextBlock>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1"/>

                        <!-- TRANSCRIPT -->
                        <Border Grid.Row="2" CornerRadius="15"
                                BorderBrush="#2A3A52" BorderThickness="1" Background="#13FFFFFF">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="26" ShadowDepth="7" Opacity="0.42" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#16FFFFFF" CornerRadius="15,15,0,0"
                                        BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1" Padding="16,9">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                                    VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="#7F93AB" Margin="0,0,7,0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="I N T E R V I E W E R" Foreground="#9DB1CC" FontSize="9"
                                                       FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="16,10,16,10">
                                    <ScrollViewer x:Name="TranscriptScroll">
                                        <TextBlock x:Name="TranscriptTextBlock" Foreground="#FFFFFF"
                                                   FontSize="12.5" FontFamily="Segoe UI" FontWeight="Bold"
                                                   LineHeight="19" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                    <StackPanel x:Name="TranscriptHint" VerticalAlignment="Center"
                                                HorizontalAlignment="Center" IsHitTestVisible="False"
                                                Visibility="Visible">
                                        <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                   Foreground="#33FFFFFF" HorizontalAlignment="Center"
                                                   Margin="0,0,0,9"/>
                                        <TextBlock Text="Conversation will appear here" Foreground="#44FFFFFF"
                                                   FontSize="12" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================= CAMERA / OVERLAY ================= -->
            <Grid x:Name="CameraModeGrid" Visibility="Collapsed" VerticalAlignment="Top" Height="90">
                <Border CornerRadius="0,0,12,12" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1"
                        Background="#0AFFFFFF">
                    <Grid Margin="18,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource MicBtnStyle}"
                                Click="MicBtn_Click" Width="36" Height="36"/>
                        <ScrollViewer Grid.Column="1" Margin="14,0">
                            <TextBlock x:Name="CamAnswerBox" Text="Ready..." Foreground="#FFFFFF"
                                       FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                       TextAlignment="Center" FontFamily="Segoe UI"/>
                        </ScrollViewer>
                        <Button Grid.Column="2" Content="Exit" Style="{StaticResource GhostBtn}"
                                Click="ExitCameraMode_Click" Padding="9,5"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= LISTENING MODE POPUP ================= -->
            <Popup x:Name="ListeningModePopup" Placement="Bottom" StaysOpen="True"
                   AllowsTransparency="True" PopupAnimation="Fade"
                   HorizontalOffset="-178" VerticalOffset="7">
                <Border Padding="0,0,0,14">
                    <Border Background="#0B131F" BorderBrush="#2A3A4F" BorderThickness="1"
                            CornerRadius="15" Width="304" Padding="7">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.62" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="11,8,10,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LISTENING MODE" Foreground="#6F8198" FontSize="9.5"
                                               FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Choose how each question starts"
                                               Foreground="#C6D4E8" FontSize="11.5" FontWeight="SemiBold"
                                               FontFamily="Segoe UI" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="24" Height="24" CornerRadius="8"
                                        Background="#132235" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="#7F93AB" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Border Height="1" Background="#1B2A3C" Margin="8,0,8,6"/>

