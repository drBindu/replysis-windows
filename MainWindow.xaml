<Window x:Class="InterviewCopilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InterviewCopilot"
        Title="Replysis AI"
        Icon="pack://siteoforigin:,,,/Assets/replysis-icon-1024.png"
        Height="590" Width="980"
        MinHeight="540" MinWidth="880"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        ShowInTaskbar="True"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Opacity="1"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>

        <!-- Silver primary action; green is reserved for live status indicators. -->
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#F4F7FC"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ScreenActionStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="{DynamicResource ActionSilverSurface}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScreenActionHoverSurface}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassButtonHoverStroke}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassButtonPressedSurface}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Destructive actions retain their red cue on translucent glass. -->
        <Style x:Key="RedBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassButtonDangerStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource GlassButtonDangerSurface}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FCA5A5"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassButtonDangerHoverSurface}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Graphite secondary actions with a quiet outline and stationary hover. -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#DDDDE3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ActionGraphiteStroke}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="{DynamicResource ActionGraphiteSurface}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassButtonHoverSurface}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassButtonHoverStroke}"/>
                                <Setter Property="Foreground" Value="#F4F6FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassButtonPressedSurface}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B4C0D0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietActionBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Background" Value="{DynamicResource ActionGraphiteSurface}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#BCBCC6"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════
             TOOLBAR PILL SYSTEM
             The top bar had been hand-tuned pill by pill, so adjacent controls
             carried three corner radii (11 / 9 / 7), three paddings and three
             label sizes, and one label was sentence case among small caps. These
             styles are the single definition, so the row lines up by
             construction instead of by matching numbers across the file.
             ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="ToolbarPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#101827"/>
            <Setter Property="BorderBrush" Value="#26364C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Same geometry, no pointer: read-only status such as the timer. -->
        <Style x:Key="ToolbarBadge" TargetType="Border" BasedOn="{StaticResource ToolbarPill}">
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#16FFFFFF"/>
        </Style>

        <Style x:Key="ToolbarPillLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#A9B6C8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolbarPillIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#84E7B6"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolbarPillChevron" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE70D;"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="#6F8198"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Segmented group: related actions share one outline so the row carries
             fewer objects than it does controls. -->
        <Style x:Key="ToolbarGroup" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#101827"/>
            <Setter Property="BorderBrush" Value="#26364C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- One action inside a group. Carries no outline of its own; the hover
             tint is what tells you the halves are separately clickable. -->
        <Style x:Key="ToolbarSegment" TargetType="Border">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#182438"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarSegmentDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Background" Value="#22344A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Separates the row into what you do, how you appear, and who you are,
             so nine controls read as three short groups rather than one run. -->
        <Style x:Key="ToolbarDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="#22344A"/>
            <Setter Property="Margin" Value="3,0,9,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- MIC (circular gradient glass) -->
        <!-- Premium circular mic button. The accent RING + outer glow are recolored
             by state in UpdateMicUi (via BorderBrush); the body stays a refined dark
             slate so the state color reads cleanly against it. -->
        <Style x:Key="MicBtnStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="1.6"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <!-- Main body: soft radial gradient for depth -->
                            <Ellipse x:Name="Body" Margin="2" Fill="{DynamicResource ActionGraphiteSurface}"/>

                            <!-- Collapsed: a shiny bubble on flat glass read as dated rather than premium.
                                 Kept rather than deleted because hover triggers may name it. -->
                            <Ellipse x:Name="Gloss" Margin="7,5,7,22" Opacity="0.22" Visibility="Collapsed">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Accent ring (state color, driven by BorderBrush) -->
                            <Ellipse x:Name="Ring"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{TemplateBinding BorderThickness}"/>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Fill" Value="{DynamicResource GlassButtonHoverSurface}"/>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.07" ScaleY="1.07"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Gloss" Property="Opacity" Value="0.32"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PANEL TOGGLE -->
        <Style x:Key="ArrowToggleBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="2,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassButtonHoverSurface}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SECTION CAPTION -->
        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- A keyboard shortcut drawn as a key cap. -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A3A50"/>
            <Setter Property="Background" Value="#111A28"/>
            <Setter Property="Padding" Value="5,1,5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KeyCapText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
        </Style>
        <Style x:Key="KeyCapLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#8A97AA"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <!-- ====================================================================
         MAIN CONTAINER  &#183;  pure glass on near-black
    ===================================================================== -->
    <Border x:Name="MainAppBorder" CornerRadius="18"
            BorderBrush="#28384E" BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0F17" Offset="0"/>
                <GradientStop Color="#0A0D14" Offset="0.58"/>
                <GradientStop Color="#070A10" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" ShadowDepth="16" Opacity="0.80" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid x:Name="NormalModeGrid">
                <Grid.RowDefinitions>
                    <!-- 60 left the mic short of room: the button is 46 and its glow
                         blurs out past that, so the ring and halo were sliced flat by
                         the window edge. 72 clears the button plus its widest pulse. -->
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ================= HEADER ================= -->
                <Border Grid.Row="0" CornerRadius="18,18,0,0"
                        BorderBrush="#26364A" BorderThickness="0,0,0,1"
                        Background="#08FFFFFF">
                    <Grid Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Brand -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Width="34" Height="34" Margin="0,0,9,0"
                                   Source="pack://siteoforigin:,,,/Assets/replysis-icon-1024.png"
                                   Stretch="Uniform" SnapsToDevicePixels="True"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Replysis AI" Foreground="#F5F8FC" FontSize="14.5"
                                           FontWeight="Bold" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Mic + status - an Interview-step control, so hidden
                             while Setup fills the page ("this page no interview").
                             See EnterSetupStep / EnterInterviewStep. -->
                        <StackPanel x:Name="HeaderMicArea" Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Button x:Name="MicBtn" Style="{StaticResource MicBtnStyle}"
                                    Click="MicBtn_Click" Margin="0,0,9,0">
                                <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#F1F5F9"/>
                                <Button.Effect>
                                    <DropShadowEffect x:Name="MicGlow" Color="#10B981"
                                                      BlurRadius="8" ShadowDepth="0"/>
                                </Button.Effect>
                            </Button>
                            <!-- The mic already carries its state in the ring colour and
                                 glow, so boxing the same state in a bordered pill beside
                                 it counted twice and added another button to the row.
                                 The label reads as part of the mic now. The pill and its
                                 glow keep their names because UpdateMicUi drives them. -->
                            <Border x:Name="MicStatusPill" Background="Transparent"
                                    BorderThickness="0" Padding="0" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="MicPillGlow" BlurRadius="11" ShadowDepth="0"
                                                      Opacity="0" Color="#10B981"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="MicIndicator" Width="7" Height="7"
                                             Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MicIndicatorText" Text="READY"
                                               Foreground="#EAF1F8" FontWeight="Bold" FontSize="10.5"
                                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- One control, one question: when should it answer.
                                 There is no Practice/Interview choice any more.
                                 The app listens to the microphone AND the
                                 computer's sound at the same time, so a question
                                 is answered whichever it arrives on, and there
                                 is nothing left to get wrong. What used to be
                                 two modes differed only in which of those two
                                 sources was open.

                                 A switch rather than a menu: a menu hides the
                                 state until it is opened, and this is state a
                                 user needs to see at a glance during an
                                 interview. -->
                            <Border x:Name="ModeSegments" Margin="9,0,0,0"
                                    Background="{DynamicResource ActionGraphiteSurface}" BorderBrush="{DynamicResource ActionGraphiteStroke}"
                                    BorderThickness="1" CornerRadius="6" Padding="3"
                                    VerticalAlignment="Center">
                                <Grid x:Name="ModeSegmentsLayer" SizeChanged="ModeSegmentsLayer_SizeChanged" Loaded="ModeSegmentsLayer_Loaded">
                                <!-- The raised thumbs. One per group, behind the labels, SLIDING to the chosen segment like a macOS
                                     segmented control instead of the highlight jumping. Positioned in code (PlaceHeaderThumb). -->
                                <Canvas IsHitTestVisible="False">
                                    <Border x:Name="ThumbMode" Visibility="Collapsed" CornerRadius="4"
                                            Background="{DynamicResource GlassButtonSelectedSurface}"/>
                                    <Border x:Name="ThumbSource" Visibility="Collapsed" CornerRadius="4"
                                            Background="{DynamicResource GlassButtonSelectedSurface}"/>
                                </Canvas>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Group 1: when to answer. Group 2, past the hairline: what to hear. -->
                                    <Border x:Name="SegAuto" CornerRadius="4" Padding="6,5" Cursor="Hand"
                                            MouseLeftButtonDown="SegAuto_Click"
                                            ToolTip="Auto. Answers as soon as the question ends.">
                                        <TextBlock x:Name="SegAutoText" Text="Auto" FontSize="10" FontWeight="SemiBold"
                                                   Style="{StaticResource ToolbarPillLabel}"/>
                                    </Border>
                                    <Border x:Name="SegManual" CornerRadius="4" Padding="6,5" Cursor="Hand"
                                            MouseLeftButtonDown="SegManual_Click"
                                            ToolTip="Manual. Press Space in Replysis, or Ctrl+Alt+Space in another app, to listen and again to answer.">
                                        <TextBlock x:Name="SegManualText" Text="Manual" FontSize="10" FontWeight="SemiBold"
                                                   Style="{StaticResource ToolbarPillLabel}"/>
                                    </Border>
                                    <!-- What the app listens to. This was a checkbox in Settings
                                         called "microphone", and people left it on in real interviews,
                                         so the app heard the candidate's own answers and took them as
                                         new questions. Named for the situation, beside the mode it
                                         belongs with, and read before the call starts. -->
                                    <Border x:Name="AudioSegments" Width="1" Height="18" Margin="4,0,4,0"
                                            Background="{DynamicResource ActionGraphiteStroke}"
                                            VerticalAlignment="Center"/>
                                    <Border x:Name="SegInterview" CornerRadius="4" Padding="5,5" Cursor="Hand"
                                            MouseLeftButtonDown="SegInterview_Click"
                                            ToolTip="Interview. Hears the meeting only, so your own answers are never taken as questions. Use this for real interviews in Zoom, Meet or Teams.">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="SegInterviewIcon" Text="&#xE7F5;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SegInterviewText" Text="Interview" FontSize="10" FontWeight="SemiBold"
                                                       Style="{StaticResource ToolbarPillLabel}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="SegPractice" CornerRadius="4" Padding="5,5" Cursor="Hand"
                                            MouseLeftButtonDown="SegPractice_Click"
                                            ToolTip="Practice. Hears the meeting and your microphone, for practising on your own or with someone in the room.">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="SegPracticeIcon" Text="&#xE720;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SegPracticeText" Text="Practice" FontSize="10" FontWeight="SemiBold"
                                                       Style="{StaticResource ToolbarPillLabel}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Status messages stand in for the switch for a few seconds, the
                                         way they replaced the old pill's label. A tooltip is not a
                                         substitute: nobody hovers it. See ShowListeningModeNotice. -->
                                    <TextBlock x:Name="ModeNoticeText" Visibility="Collapsed"
                                               FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#E6EDF5" VerticalAlignment="Center"
                                               Margin="10,5,10,5"/>
                                </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>

                        <!-- Right controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- keeps the old AnalyzeLabel name alive off-screen for code that sets it -->
                            <TextBlock x:Name="AnalyzeLabel" Visibility="Collapsed"/>

                            <!-- Screen AI and region select were unlabeled icon buttons a new user
                                 could not tell apart without a tooltip. One labeled pill, same
                                 pattern as the mode selector below, opens a menu naming each
                                 option. F8/F9 keep working unchanged. Compact overlay used to sit
                                 in this menu, but it is a display mode rather than a way to read
                                 the screen, so it has its own pill and is no longer hidden here. -->
                            <!-- Setup has no screen to read yet, so this slot shows the
                                 credits/time balance instead of leaving it empty - the
                                 same numbers CreditsLabel already tracks, just bound
                                 straight through rather than duplicated in code. -->
                            <Border x:Name="SetupCreditsSummary" Style="{StaticResource ToolbarBadge}"
                                    Margin="0,0,6,0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#x26A1;" FontSize="12" Foreground="#54D99A"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Text, ElementName=CreditsLabel}" Foreground="#FFFFFF"
                                               FontSize="12" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Text, ElementName=CreditsPlanLabel}" Foreground="#93A4BA"
                                               FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Screen reading is the featured action; Compact is a quieter
                                 companion with the same height and corner geometry. Both are
                                 Interview-step tools, so hidden on Setup - see EnterSetupStep. -->
                                <!-- Icon-only: the labeled version needed ~180px between the
                                     two buttons, which is what was pushing Interview/Practice
                                     and the credits/timer/profile cluster into each other at
                                     this window's width. The label lives in the tooltip now,
                                     same as every other icon button in this header. -->
                                <StackPanel x:Name="HeaderScreenToolsArea" Orientation="Horizontal" Margin="0,0,6,0">
                                    <Button x:Name="AnalyzePill" Style="{StaticResource ScreenActionButton}"
                                            Click="ReadScreenPill_Click" Margin="0,0,6,0" Padding="9,0"
                                            ToolTip="Read the screen and answer from it (F8 this window, F9 main screen, F7 a part you select).">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="WatchScreenIcon" Width="13" Height="13" Margin="0,0,5,0"
                                                  Data="M1,5 V1 H5 M9,1 H13 V5 M13,9 V13 H9 M5,13 H1 V9 M4,7 H10"
                                                  Stroke="#F4F7FC" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  VerticalAlignment="Center"/>
                                            <!-- Kept for code-behind, which still toggles this text when
                                                 switching between "Read screen" and an analyzing/cancel state -
                                                 shortened so the button fits, unlike its old "Read screen". -->
                                            <TextBlock x:Name="WatchScreenPillLabel" Text="Screen" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="CompactOverlayPill" Style="{StaticResource QuietActionBtn}"
                                            Click="CompactOverlayPill_Click" Height="34" Padding="9,0"
                                            ToolTip="Shrink to a slim bar for in-person interviews.">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"
                                                  Data="M1,1 H13 V13 H1 Z M7,7 H11 V11 H7 Z"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25"/>
                                            <TextBlock Text="Compact" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                            <!-- Stealth lives in Settings only. It was a pill here as well,
                                 spending toolbar width on a setting almost nobody changes
                                 mid-interview, and stealth is on by default. -->

                            <!-- Help moved into the profile menu ("How it works") to declutter -->

                            <!-- Session timer -->
                            <Border x:Name="SessionTimerBadge" Style="{StaticResource ToolbarBadge}"
                                    Visibility="Collapsed" ToolTip="Session duration">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Static, and it has to stay static.
                                         This window sets AllowsTransparency, which makes
                                         Windows render it in software and push the whole
                                         2170x1050 surface on every frame. So an animation
                                         anywhere in it costs about one percent of a CPU
                                         core per frame per second, whatever it is animating.
                                         Measured on this dot alone: pulsing at 60fps cost
                                         21% of a core for as long as the app was open, at
                                         10fps 10%, and not at all 1.7%. A decorative pulse
                                         is not worth a fifth of a core on a laptop two
                                         hours into an interview. -->
                                    <Ellipse Width="5" Height="5" Fill="#F87171" Margin="0,0,6,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SessionTimerLabel" Text="0:00"
                                               Foreground="#FFFFFF" FontSize="11"
                                               FontWeight="Bold" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>

                            <!-- Credits — hidden from the top bar to declutter; still shown in the profile menu -->
                            <Border x:Name="CreditsBadge" CornerRadius="18" Padding="10,4" Margin="0,0,4,0"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonDown="CreditsBadge_Click"
                                    ToolTip="Answers left. Click to refresh or see your options.">
                                <Border.Background>
                                    <SolidColorBrush x:Name="CreditsBadgeBg" Color="#0DFFFFFF"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush x:Name="CreditsBadgeBorder" Color="#1AFFFFFF"/>
                                </Border.BorderBrush>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="CreditsIcon" Text="" FontSize="10"
                                               Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CreditsLabel" Text="Answers"
                                               Foreground="#FFFFFF" FontSize="11"
                                               FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="CreditsPlanLabel" Text=""
                                               Foreground="#A0A0A4" FontSize="11" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ToolbarDivider}"/>

                            <!-- Profile -->
                            <Border x:Name="ProfileBadge" CornerRadius="18" Padding="7,4" Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonDown="ProfileBadge_Click"
                                    ToolTip="Account menu">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="11"
                                            Background="#22FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                            Margin="0,0,6,0">
                                        <Grid>
                                            <TextBlock x:Name="AvatarInitials" Text="GU"
                                                       Foreground="White" FontSize="8.5" FontWeight="Bold"
                                                       FontFamily="Segoe UI" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Ellipse x:Name="AvatarPhoto" Width="22" Height="22"
                                                     Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="ProfileNameLabel" Text="" MaxWidth="48" TextTrimming="CharacterEllipsis"
                                               Foreground="#EAF1F8" FontSize="11" FontWeight="Medium"
                                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="#59FFFFFF" FontSize="8"
                                               Margin="5,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="SignInHeaderBtn" Visibility="Collapsed"
                                    Click="SignInHeaderBtn_Click" Style="{StaticResource GhostBtn}"
                                    Content="Sign In" Padding="10,5" Margin="0,0,4,0"/>

                            <!-- Window controls -->
                            <Button x:Name="PinWindowBtn" Click="PinWindowBtn_Click" Cursor="Hand"
                                    ToolTip="Pinned: stays in front of other windows. Click to unpin."
                                    Background="Transparent" BorderThickness="0" Padding="7,0" Margin="2,0,0,0">
                                <TextBlock x:Name="PinWindowIcon" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#EAF1F8"/>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassButtonHoverSurface}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Click="MinimizeBtn_Click" ToolTip="Minimize. Press Ctrl+Alt+R to bring Replysis back." Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Padding="7,0" Margin="2,0,0,0">
                                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="#66FFFFFF"/>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassButtonHoverSurface}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Cursor="Hand" ToolTip="Close" Padding="7,0" Click="CloseBtn_Click"
                                    Background="Transparent" BorderThickness="0">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#66FFFFFF"/>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassButtonDangerHoverSurface}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= BODY ================= -->
                <Grid x:Name="InterviewContent" Grid.Row="1" Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ResumeColumn" Width="230"/>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Also Star, same as ResumeColumn, during Setup: two
                             Star columns split the width between them, and
                             MainContentArea is empty then, so that split showed
                             as a dead gap on the right. Collapsed to 0 in
                             EnterSetupStep and restored in EnterInterviewStep. -->
                        <ColumnDefinition x:Name="MainContentColumn" Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- =========================================================
                         SIDE PANEL  &#183;  Interview Setup (tab-less, no dead space)
                    ========================================================== -->
                    <Border x:Name="ResumePanel" Grid.Column="0"
                            CornerRadius="16" BorderBrush="#26364A" BorderThickness="1"
                            Background="#D90F141E" Padding="14" ClipToBounds="True">
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Two halves while Setup fills the page: resume and job
                             details on the left, the explained listening choices on
                             the right - not stacked one under the other. Once
                             Interview starts this collapses back to the left half
                             only, at the narrow sidebar width production has always
                             used; see EnterSetupStep / EnterInterviewStep. -->
                        <Grid x:Name="SetupTwoColumn" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="SetupDividerCol" Width="28"/>
                                <ColumnDefinition x:Name="SetupRightCol" Width="1.1*"/>
                            </Grid.ColumnDefinitions>

                        <ScrollViewer x:Name="SetupLeftScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly" Padding="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>

                            <!-- Title - a real page title, not a small caps label. The
                                 repeated icon-chip-plus-label header three sections in a
                                 row was the "generated template" tell; one confident
                                 heading up top, then a plain accent rule per section
                                 below, reads as designed rather than assembled. -->
                            <!-- Setup-only: this sidebar is reused, narrowed, as the
                                 Interview-step resume panel, where a page title makes
                                 no sense - you're already in the interview. Collapsed
                                 there by EnterInterviewStep. -->
                            <StackPanel x:Name="SetupPageTitle" Grid.Row="0" Margin="1,0,0,12">
                                <TextBlock Text="Interview setup" Foreground="#FAFBFD" FontSize="19"
                                           FontWeight="Bold" FontFamily="Segoe UI"/>
                                <TextBlock Text="Prepare your context once. Replysis keeps it available throughout the interview." Foreground="#8294AB"
                                           FontSize="11" FontFamily="Segoe UI" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- RESUME - its own elevated card, not just a labeled row,
                                 so it reads as the primary action on the page rather
                                 than one field among several. -->
                            <Border Grid.Row="1" Grid.RowSpan="3" CornerRadius="12"
                                    Background="#111823" BorderBrush="#253449" BorderThickness="1"
                                    Padding="13,12" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="7" Opacity="0.28"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="3" Height="14" CornerRadius="2" Background="#34E08A" Margin="0,0,9,0"/>
                                        <TextBlock Text="Resume" Foreground="#E6EDF5" FontSize="13.5"
                                                   FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Premium upload / drop zone. A real Button so click-to-browse
                                         fires reliably; the ResumeTextBox is kept only as a hidden
                                         backing store for the extracted resume text. -->
                                    <Button x:Name="ResumeDropBorder" Grid.Row="1" Cursor="Hand"
                                            Click="ResumeCard_Click" AllowDrop="True"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            DragEnter="ResumeDropBorder_DragEnter"
                                            DragOver="ResumeDropBorder_DragOver"
                                            DragLeave="ResumeDropBorder_DragLeave"
                                            Drop="ResumeDropBorder_Drop">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CardBd" CornerRadius="10" BorderBrush="#26384F"
                                                        BorderThickness="1" MinHeight="120" Background="#0CFFFFFF">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CardBd" Property="BorderBrush" Value="#3021924A"/>
                                                        <Setter TargetName="CardBd" Property="Background" Value="#0F21924A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="CardBd" Property="Background" Value="#1621924A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <TextBox x:Name="ResumeTextBox" Visibility="Collapsed"
                                                     TextChanged="ResumeTextBox_TextChanged"/>

                                            <!-- Empty state: upload prompt -->
                                            <StackPanel x:Name="ResumeEmptyState" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" Margin="18" IsHitTestVisible="False">
                                                <Border Width="42" Height="42" CornerRadius="21" Background="#14FFFFFF"
                                                        BorderBrush="#22FFFFFF" BorderThickness="1"
                                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                               Foreground="#C7D4E5" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Drop your resume here" Foreground="#F4F7FC" FontSize="13.5"
                                                           FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                                <TextBlock Text="or click to browse" Foreground="#8393A8" FontSize="10.5"
                                                           FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                                <Border Background="#14FFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1"
                                                        CornerRadius="6" Padding="10,4" HorizontalAlignment="Center">
                                                    <TextBlock Text="PDF, DOCX or TXT" Foreground="#9FB0C7"
                                                               FontSize="9.5" FontWeight="Bold" FontFamily="Segoe UI"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Loaded state -->
                                            <StackPanel x:Name="ResumeLoadedState" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" Margin="18" Visibility="Collapsed"
                                                        IsHitTestVisible="False">
                                                <Border Width="50" Height="50" CornerRadius="25" Background="#1621924A"
                                                        BorderBrush="#3821924A" BorderThickness="1"
                                                        HorizontalAlignment="Center" Margin="0,0,0,14">
                                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                               Foreground="#54D99A" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock x:Name="ResumeLoadedName" Text="Resume loaded" Foreground="#F4F7FC"
                                                           FontSize="13.5" FontWeight="SemiBold" FontFamily="Segoe UI"
                                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="235" TextAlignment="Center"/>
                                                <Border Background="#0FFFFFFF" CornerRadius="6" Padding="9,3"
                                                        HorizontalAlignment="Center" Margin="0,6,0,0">
                                                    <TextBlock Text="click to replace" Foreground="#8393A8" FontSize="10.5"
                                                               FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Drag-over overlay -->
                                            <Border x:Name="ResumeDragOverlay" CornerRadius="12"
                                                    Background="#1A21924A" BorderBrush="#54D99A"
                                                    BorderThickness="1.5" Visibility="Collapsed"
                                                    IsHitTestVisible="False">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="24" Foreground="#8FE8B9"
                                                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                    <TextBlock Text="Drop to load" Foreground="#FFFFFF"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- Previously uploaded resumes (shown only when some exist) -->
                                    <Grid Grid.Row="2" Margin="0,10,0,0">
                                        <Button x:Name="SavedResumesBtn" Style="{StaticResource GhostBtn}"
                                                Click="SavedResumesBtn_Click" Padding="0,8"
                                                Visibility="Collapsed" ToolTip="Previously uploaded resumes">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="#93A4BA" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Previous resumes" FontSize="11" FontFamily="Segoe UI"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- TARGET ROLE - its own card, same treatment as Resume. -->
                            <Border Grid.Row="4" Grid.RowSpan="4" CornerRadius="12"
                                    Background="#111823" BorderBrush="#253449" BorderThickness="1"
                                    Padding="13" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="7" Opacity="0.28"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="3" Height="14" CornerRadius="2" Background="#34E08A" Margin="0,0,9,0"/>
                                        <TextBlock Text="Target role" Foreground="#E6EDF5" FontSize="13.5"
                                                   FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                        <TextBlock Text="  optional" Foreground="#3EFFFFFF"
                                                   FontSize="10" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="COMPANY" Foreground="#7E90A8" FontSize="9.5"
                                               FontWeight="Bold" FontFamily="Segoe UI" Margin="2,0,0,5"/>
                                    <Border Grid.Row="1" Margin="0,17,0,0" Background="#0DFFFFFF" CornerRadius="9"
                                            BorderBrush="#1AFFFFFF" BorderThickness="1" Height="38">
                                        <Grid>
                                            <TextBox x:Name="CompanyNameBox" Background="Transparent"
                                                     Foreground="#F0F0F2" BorderThickness="0"
                                                     Padding="12,0" FontSize="12.5" FontFamily="Segoe UI"
                                                     VerticalContentAlignment="Center"
                                                     CaretBrush="#8FE8B9" TextChanged="CompanyNameBox_TextChanged"/>
                                            <TextBlock x:Name="CompanyNameWatermark"
                                                       Text="e.g. Google, Stripe, Amazon"
                                                       Foreground="#52FFFFFF" FontSize="12.5" Margin="12,0"
                                                       FontFamily="Segoe UI" IsHitTestVisible="False"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="2" Text="JOB DESCRIPTION" Foreground="#7E90A8" FontSize="9.5"
                                               FontWeight="Bold" FontFamily="Segoe UI" Margin="2,14,0,5"/>
                                    <Border Grid.Row="3" Background="#0DFFFFFF" CornerRadius="10"
                                            BorderBrush="#1AFFFFFF" BorderThickness="1">
                                        <Grid>
                                            <TextBox x:Name="JobDescBox" TextWrapping="Wrap" AcceptsReturn="True"
                                                     MinHeight="68" MaxHeight="170"
                                                     Background="Transparent" Foreground="#F0F0F2"
                                                     BorderThickness="0" Padding="12,10"
                                                     VerticalScrollBarVisibility="Auto"
                                                     FontFamily="Segoe UI" FontSize="12.5" CaretBrush="#8FE8B9"
                                                     TextChanged="JobDescBox_TextChanged"/>
                                            <TextBlock x:Name="JobDescWatermark" Foreground="#52FFFFFF"
                                                       FontSize="12.5" TextWrapping="Wrap" Margin="12,10"
                                                       VerticalAlignment="Top" IsHitTestVisible="False"
                                                       FontFamily="Segoe UI"
                                                       Text="Paste the title, must-have skills, tech stack and seniority."/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- WHAT YOU WANT - same card treatment again, so all three
                                 sections read as one consistent system rather than three
                                 different attempts at a layout. -->
                            <Border Grid.Row="8" CornerRadius="12"
                                    Background="#111823" BorderBrush="#253449" BorderThickness="1"
                                    Padding="13">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="7" Opacity="0.28"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="3" Height="14" CornerRadius="2" Background="#34E08A" Margin="0,0,9,0"/>
                                        <TextBlock Text="What you want" Foreground="#E6EDF5" FontSize="13.5"
                                                   FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                        <TextBlock Text="  the screening questions" Foreground="#3EFFFFFF"
                                                   FontSize="10" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="WORK TYPE" Foreground="#7E90A8" FontSize="9.5"
                                                       FontWeight="Bold" FontFamily="Segoe UI" Margin="2,0,0,5"/>
                                            <ComboBox x:Name="WorkTypeCombo" Style="{StaticResource DarkComboBox}"
                                                      SelectionChanged="ScreeningPref_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="WORK AUTHORIZATION" Foreground="#7E90A8" FontSize="9.5"
                                                       FontWeight="Bold" FontFamily="Segoe UI" Margin="2,0,0,5"/>
                                            <ComboBox x:Name="WorkAuthCombo" Style="{StaticResource DarkComboBox}"
                                                      SelectionChanged="ScreeningPref_Changed"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="CAN START" Foreground="#7E90A8" FontSize="9.5"
                                                       FontWeight="Bold" FontFamily="Segoe UI" Margin="2,0,0,5"/>
                                            <ComboBox x:Name="AvailabilityCombo" Style="{StaticResource DarkComboBox}"
                                                      SelectionChanged="ScreeningPref_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="WHERE" Foreground="#7E90A8" FontSize="9.5"
                                                       FontWeight="Bold" FontFamily="Segoe UI" Margin="2,0,0,5"/>
                                            <ComboBox x:Name="WorkLocationCombo" Style="{StaticResource DarkComboBox}"
                                                      SelectionChanged="ScreeningPref_Changed"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="PAY" Foreground="#7E90A8" FontSize="9.5"
                                               FontWeight="Bold" FontFamily="Segoe UI" Margin="2,0,0,5"/>
                                    <Border Background="#0DFFFFFF" CornerRadius="9"
                                            BorderBrush="#1AFFFFFF" BorderThickness="1" Height="38">
                                        <Grid>
                                            <TextBox x:Name="PayExpectationBox" Background="Transparent"
                                                     Foreground="#F0F0F2" BorderThickness="0"
                                                     Padding="12,0" FontSize="12.5" FontFamily="Segoe UI"
                                                     VerticalContentAlignment="Center"
                                                     CaretBrush="#8FE8B9" TextChanged="PayExpectationBox_TextChanged"/>
                                            <TextBlock x:Name="PayExpectationWatermark"
                                                       Text="e.g. $65/hr on C2C, or $140k base"
                                                       Foreground="#52FFFFFF" FontSize="12.5" Margin="12,0"
                                                       FontFamily="Segoe UI" IsHitTestVisible="False"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="Left blank, the app stays vague instead of guessing a number for you."
                                               Foreground="#5A6A7E" FontSize="9.5" FontFamily="Segoe UI"
                                               TextWrapping="Wrap" Margin="2,7,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Hidden ASK/GUIDE + SavePath (kept for code-behind) -->
                            <Grid Grid.Row="7" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBox x:Name="AskBox" TextChanged="AskBox_TextChanged"
                                             PreviewKeyDown="AskBox_PreviewKeyDown"/>
                                    <TextBlock x:Name="AskBoxWatermark"/>
                                    <Border x:Name="PinnedHintsBar" Visibility="Collapsed">
                                        <TextBlock x:Name="PinnedHintsText"/>
                                    </Border>
                                    <Button x:Name="PinBtn" Click="PinBtn_Click"/>
                                    <Button x:Name="AskSubmitBtn" Click="AskSubmitBtn_Click"/>
                                    <Button Click="ClearHintsBtn_Click"/>
                                    <TextBlock x:Name="SavePathLabel"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        </ScrollViewer>

                        <Border x:Name="SetupRightDivider" Grid.Column="1" Width="1" Background="#18FFFFFF" Margin="0,6"/>

                        <!-- Same choices as the toolbar's Auto/Manual/Interview/Practice
                             switch, explained here in full sentences instead of a
                             tooltip nobody hovers, and settable before the interview
                             starts. Both places write the same state (SelectListeningMode /
                             SelectAudioSource), so picking here or picking in the toolbar
                             mid-interview are the same action from two places. -->
                        <ScrollViewer x:Name="SetupRightScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                                      Padding="8,0,2,0">
                            <StackPanel Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Width="3" Height="16" CornerRadius="2" Background="#34E08A" Margin="0,0,9,0"/>
                                    <TextBlock Text="Listening controls" Foreground="#FAFBFD" FontSize="17"
                                               FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Choose how answers trigger and which audio Replysis should hear. You can change both later."
                                           Foreground="#8393A8" FontSize="11" FontFamily="Segoe UI"
                                           TextWrapping="Wrap" Margin="12,0,0,14"/>

                                <!-- Compact macOS-style segmented choices. These keep the
                                     existing named borders and click handlers, so this is a
                                     presentation-only change: all settings behave exactly as
                                     they did when the options were large cards. -->
                                <!-- Compact preference rows. The options stay small and
                                     aligned to the right, like a native Mac settings pane,
                                     rather than expanding into full-width feature cards. -->
                                <Border Background="#13FFFFFF" BorderBrush="#2A3A52" BorderThickness="1"
                                        CornerRadius="11" Padding="13,11" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="214"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Answer trigger" Foreground="#E2E8F0" FontSize="12"
                                                       FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                            <TextBlock x:Name="SetupTriggerHint" Text="Automatically, or when you press Space"
                                                       Foreground="#8A97A8" FontSize="10.5" FontFamily="Segoe UI"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="14"/>
                                        </StackPanel>
                                        <local:MacSegmented x:Name="SetupTrigger" Grid.Column="1" VerticalAlignment="Center" LeftText="Auto" RightText="Manual"
                                                            SelectionRequested="SetupTrigger_Requested"/>
                                    </Grid>
                                </Border>

                                <Border Background="#13FFFFFF" BorderBrush="#2A3A52" BorderThickness="1"
                                        CornerRadius="11" Padding="13,11" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="214"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Audio source" Foreground="#E2E8F0" FontSize="12"
                                                       FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                            <TextBlock x:Name="SetupSourceHint" Text="Meeting only, or meeting plus microphone"
                                                       Foreground="#8A97A8" FontSize="10.5" FontFamily="Segoe UI"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="14"/>
                                        </StackPanel>
                                        <local:MacSegmented x:Name="SetupSource" Grid.Column="1" VerticalAlignment="Center" LeftText="Interview" RightText="Practice"
                                                            SelectionRequested="SetupSource_Requested"/>
                                    </Grid>
                                </Border>

                                <Border Background="#13FFFFFF" BorderBrush="#2A3A52" BorderThickness="1"
                                        CornerRadius="11" Padding="13,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="214"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Answer length" Foreground="#E2E8F0" FontSize="12"
                                                       FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                            <TextBlock x:Name="SetupLengthHint" Text="Adaptive and concise, or more detailed"
                                                       Foreground="#8A97A8" FontSize="10.5" FontFamily="Segoe UI"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="14"/>
                                        </StackPanel>
                                        <local:MacSegmented x:Name="SetupLength" Grid.Column="1" VerticalAlignment="Center" LeftText="Short" RightText="Detailed"
                                                            SelectionRequested="SetupLength_Requested"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        </Grid>

                        <!-- Pinned CTA - bottom-right of the panel, always in the
                             same place, never inside the scroll area. Setup can
                             be as long as the resume/job fields make it; this
                             never moves with that content. -->
                        <Border x:Name="StartInterviewPin" Grid.Row="1" HorizontalAlignment="Stretch"
                                Margin="0,14,0,0" Padding="0,13,0,0" Panel.ZIndex="10"
                                BorderBrush="#253449" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Ready for the interview?" Foreground="#E9EFF7" FontSize="12.5"
                                               FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="StartInterviewHint" Text="Your setup stays available if you need to come back."
                                               Foreground="#718298" FontSize="10" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="StartInterviewBtn" Grid.Column="1" Height="42" MinWidth="176" Padding="18,0"
                                        Cursor="Hand" Click="StartInterviewStep_Click"
                                        FocusVisualStyle="{StaticResource KeyboardFocus}">
                                    <Button.Effect>
                                        <DropShadowEffect Color="#16150F" Direction="270" ShadowDepth="5" BlurRadius="14" Opacity="0.32"/>
                                    </Button.Effect>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="StartBd" CornerRadius="10" BorderBrush="#32A864" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#1D8A4B" Offset="0"/>
                                                        <GradientStop Color="#27A85C" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="Start interview" Foreground="White" FontSize="12"
                                                               FontWeight="Bold" FontFamily="Segoe UI"/>
                                                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" Foreground="#CDEBD8"
                                                               FontSize="9.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StartBd" Property="Opacity" Value="0.9"/></Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="StartBd" Property="Opacity" Value="0.78"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        </Grid>
                    </Border>

                    <!-- Panel toggle -->
                    <Button x:Name="ResumeToggleBtn" Grid.Column="1" Content="&#xE76B;"
                            Style="{StaticResource ArrowToggleBtn}"
                            Click="ResumeToggleBtn_Click"
                            VerticalAlignment="Center" Margin="8,0,8,0"/>

                    <!-- =========================================================
                         MAIN CONTENT - the Interview step. Hidden and faded out
                         while Setup is showing; slid and faded in once "Start
                         Interview" is pressed. See EnterInterviewStep /
                         EnterSetupStep in the code-behind.
                    ========================================================== -->
                    <Grid x:Name="MainContentArea" Grid.Column="2" Opacity="0" Visibility="Collapsed"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="MainContentShift" X="36"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4.2*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="1.4*"/>
                        </Grid.RowDefinitions>

                        <!-- AI ANSWER -->
                        <Border Grid.Row="0" CornerRadius="15"
                                BorderBrush="#2A3A52" BorderThickness="1" Background="#13FFFFFF">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="26" ShadowDepth="7" Opacity="0.42" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#16FFFFFF" CornerRadius="15,15,0,0"
                                        BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1" Padding="16,11">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="BackToSetupBtn"
                                                    Style="{StaticResource QuietActionBtn}"
                                                    Click="BackToSetupStep_Click" ToolTip="Return to interview setup"
                                                    Padding="8,3" Margin="0,0,8,0" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Setup" FontFamily="Segoe UI" FontSize="10"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="8,3"
                                                    Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEA80;" FontFamily="Segoe MDL2 Assets"
                                                               Foreground="#BBBBBF" FontSize="9"
                                                               Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="AI ANSWER" Foreground="#9DB1CC"
                                                               FontSize="9" FontWeight="Bold" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="StarBadge" Visibility="Collapsed"
                                                    Background="#14FFFFFF" CornerRadius="6" Padding="7,3">
                                                <TextBlock Text="STAR METHOD" Foreground="#A9B6C8" FontSize="9"
                                                           FontWeight="Bold" FontFamily="Segoe UI"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                                    HorizontalAlignment="Right">
                                            <Button x:Name="CopyAnswerBtn" Style="{StaticResource QuietActionBtn}"
                                                    Click="CopyAnswerBtn_Click" Padding="11,4" Margin="0,0,7,0"
                                                    ToolTip="Copy answer">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Copy" FontSize="11" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ClearAnswerBtn" Style="{StaticResource QuietActionBtn}"
                                                    Click="ClearAnswerBtn_Click" Padding="11,4" Margin="0,0,10,0"
                                                    ToolTip="Clear the screen and conversation memory. You stay in this session.">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Clear" FontSize="11" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="FinishInterviewBtn" Style="{StaticResource PrimaryActionBtn}"
                                                    Click="FinishInterviewBtn_Click" Padding="11,4" Margin="0,0,7,0"
                                                    ToolTip="Finish, save, and review this interview in Past Sessions.">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Finish" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="NewSessionBtn" Style="{StaticResource QuietActionBtn}"
                                                    Click="NewSessionBtn_Click" Padding="10,4" MinWidth="92"
                                                    ToolTip="Save this session and start a new one. Your resume and role stay loaded.">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="New" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="16,8,16,0">
                                    <StackPanel x:Name="ThinkingPanel" Orientation="Horizontal" Visibility="Collapsed">
                                        <!-- Static for the same reason as the session dot
                                             above. This one is only on screen for the second
                                             or two an answer takes, so it cost little, but
                                             the rule is the rule. -->
                                        <Ellipse Width="5" Height="5" Fill="#AAAAAA" Margin="0,0,7,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ThinkingLabel" Text="Thinking..."
                                                   Foreground="#A9B6C8" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                    <!-- Shortcuts as key caps rather than a sentence joined by dots. Space is not
                                         repeated: the line underneath already explains it. -->
                                    <StackPanel x:Name="ThinkingHintLabel" Orientation="Horizontal"
                                                VerticalAlignment="Center" Visibility="Visible">
                                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="F8" Style="{StaticResource KeyCapText}"/></Border>
                                        <TextBlock Text="Read this window" Style="{StaticResource KeyCapLabel}"/>
                                        <Border Style="{StaticResource KeyCap}" Margin="18,0,0,0"><TextBlock Text="F9" Style="{StaticResource KeyCapText}"/></Border>
                                        <TextBlock Text="Read main screen" Style="{StaticResource KeyCapLabel}"/>
                                    </StackPanel>

                                    <!-- Walking back through this session's answers.
                                         Hidden until there is a second answer to move
                                         between, so it never appears as a control with
                                         nothing behind it. -->
                                    <StackPanel x:Name="HistoryNav" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <Border x:Name="HistoryNewerBadge" Background="#1A34E08A"
                                                BorderBrush="#3334E08A" BorderThickness="1"
                                                CornerRadius="9" Padding="7,1" Margin="0,0,8,0"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="HistoryNewerText" Foreground="#34E08A"
                                                       FontSize="10" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                                        </Border>
                                        <Button x:Name="HistoryBackBtn" Style="{StaticResource QuietActionBtn}"
                                                Click="HistoryBackBtn_Click" Padding="8,3"
                                                ToolTip="Previous answer (Ctrl+Alt+Left)">
                                            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                                        </Button>
                                        <Button x:Name="HistoryLabelBtn" Style="{StaticResource QuietActionBtn}"
                                                Click="HistoryLabelBtn_Click" Padding="9,3" Margin="4,0"
                                                ToolTip="Back to the newest answer">
                                            <TextBlock x:Name="HistoryLabel" FontSize="11" FontFamily="Segoe UI"/>
                                        </Button>
                                        <Button x:Name="HistoryForwardBtn" Style="{StaticResource QuietActionBtn}"
                                                Click="HistoryForwardBtn_Click" Padding="8,3"
                                                ToolTip="Next answer (Ctrl+Alt+Right)">
                                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="2" Padding="16,12,16,14">
                                    <Grid>
                                        <TextBox x:Name="AiAnswerBox" Text=""
                                                 Background="Transparent" Foreground="#F1F5F9"
                                                 BorderThickness="0" FontSize="14" FontFamily="Segoe UI"
                                                 FontWeight="SemiBold"
                                                 TextWrapping="Wrap" IsReadOnly="True"
                                                 SelectionBrush="#55FFFFFF"
                                                 TextChanged="AiAnswerBox_TextChanged"/>
                                        <!-- A hint, not an answer: smaller, lighter and dimmer than the answer text above, so
                                             an empty screen is never mistaken for an answer that has arrived. -->
                                        <TextBlock x:Name="AiAnswerHint" Foreground="#76849A" FontSize="12"
                                                   FontFamily="Segoe UI" FontWeight="Normal" TextWrapping="Wrap"
                                                   IsHitTestVisible="False" VerticalAlignment="Top"
                                                   HorizontalAlignment="Left" Visibility="Visible">
                                            Press <Run FontWeight="SemiBold" Foreground="#B4C0D0">SPACE</Run> to start listening, then <Run FontWeight="SemiBold" Foreground="#B4C0D0">SPACE</Run> again to get your answer.
                                        </TextBlock>
                                    </Grid>
                                </ScrollViewer>

                                <!-- ══════════════════════════════════════════
                                     CODE, IN ITS OWN PLACE

                                     Code was arriving in the same wrapped,
                                     proportional-font box as the spoken answer.
                                     Indentation collapsed, long lines folded
                                     mid-expression, and the thing a candidate has
                                     to read most carefully was the hardest thing
                                     on the screen to read.

                                     It gets a panel: monospace, no wrapping, its
                                     own scrollbars, and a copy button, because
                                     the next thing anyone does with it is paste
                                     it into the editor.
                                ══════════════════════════════════════════ -->
                                <Border x:Name="CodePanel" Grid.Row="3" Visibility="Collapsed"
                                        Background="#0B1220" CornerRadius="10" Margin="16,0,16,14"
                                        BorderBrush="#22344F" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="12,9,10,7">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           Foreground="#5EA9F5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="SOLUTION" Foreground="#BFD4EE" FontSize="10.5"
                                                           FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="CodeLanguageLabel" Text="" Foreground="#6F8DB0"
                                                           FontSize="10" FontWeight="SemiBold" FontFamily="Segoe UI"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button x:Name="CopyCodeBtn" Content="Copy code" Cursor="Hand"
                                                    Style="{StaticResource GhostBtn}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Click="CopyCodeBtn_Click"
                                                    FontSize="10.5" FontWeight="Bold" Padding="9,4"/>
                                        </Grid>

                                        <TextBox x:Name="CodeBox" Grid.Row="1"
                                                 Background="Transparent" Foreground="#DCE9F7"
                                                 BorderThickness="0" Padding="12,0,12,10"
                                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                                 FontSize="12.5" IsReadOnly="True"
                                                 TextWrapping="NoWrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 SelectionBrush="#55FFFFFF"
                                                 MaxHeight="240"/>

                                        <Border x:Name="ComplexityBar" Grid.Row="2" Visibility="Collapsed"
                                                Background="#0E1A2B" CornerRadius="0,0,9,9" Padding="12,7">
                                            <TextBlock x:Name="ComplexityLabel" Text=""
                                                       Foreground="#8FB6E2" FontSize="11" FontWeight="SemiBold"
                                                       FontFamily="Segoe UI" TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1"/>

                        <!-- TRANSCRIPT -->
                        <Border Grid.Row="2" CornerRadius="15"
                                BorderBrush="#2A3A52" BorderThickness="1" Background="#13FFFFFF">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="26" ShadowDepth="7" Opacity="0.42" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#16FFFFFF" CornerRadius="15,15,0,0"
                                        BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1" Padding="16,9">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                                    VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="#7F93AB" Margin="0,0,7,0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="INTERVIEWER" Foreground="#9DB1CC" FontSize="9"
                                                       FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="16,10,16,10">
                                    <ScrollViewer x:Name="TranscriptScroll">
                                        <TextBlock x:Name="TranscriptTextBlock" Foreground="#FFFFFF"
                                                   FontSize="12.5" FontFamily="Segoe UI" FontWeight="Bold"
                                                   LineHeight="19" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                    <StackPanel x:Name="TranscriptHint" VerticalAlignment="Center"
                                                HorizontalAlignment="Center" IsHitTestVisible="False"
                                                Visibility="Visible">
                                        <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                   Foreground="#33FFFFFF" HorizontalAlignment="Center"
                                                   Margin="0,0,0,9"/>
                                        <TextBlock x:Name="TranscriptHintText" Text="Conversation will appear here" Foreground="#66FFFFFF"
                                                   FontSize="12" FontFamily="Segoe UI" HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Sessions replaces the interview content in the same row, with
                     the toolbar above left where it is, so opening it reads as
                     changing view rather than opening another window.
                     Collapsed costs nothing: WPF does not lay out or render a
                     collapsed element, so this is inert until it is opened. -->
                <local:SessionsPanel x:Name="SessionsPanelHost" Grid.Row="1"
                                     Visibility="Collapsed"/>
            </Grid>

            <!-- ================= CAMERA / OVERLAY ================= -->
            <Grid x:Name="CameraModeGrid" Visibility="Collapsed" VerticalAlignment="Top" Height="90">
                <Border CornerRadius="0,0,12,12" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1"
                        Background="#0AFFFFFF">
                    <Grid Margin="18,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource MicBtnStyle}"
                                Click="MicBtn_Click" Width="36" Height="36"/>
                        <ScrollViewer Grid.Column="1" Margin="14,0">
                            <TextBlock x:Name="CamAnswerBox" Text="Ready..." Foreground="#FFFFFF"
                                       FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                       TextAlignment="Center" FontFamily="Segoe UI"/>
                        </ScrollViewer>
