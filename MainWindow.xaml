                    <Border.Effect>
                        <DropShadowEffect BlurRadius="44" ShadowDepth="12" Opacity="0.62" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Header with accent gradient sheen -->
                        <Border CornerRadius="17,17,0,0" Padding="30,26,30,22">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#20437E" Offset="0"/>
                                    <GradientStop Color="#122036" Offset="0.65"/>
                                    <GradientStop Color="#0E1524" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="Welcome to Replysis AI" Foreground="#F5F8FC"
                                           FontSize="21" FontWeight="Bold" FontFamily="Segoe UI"/>
                                <TextBlock Text="Your live interview workspace. Here's how it works."
                                           Foreground="#A6B8D2" FontSize="12.5" FontWeight="SemiBold"
                                           FontFamily="Segoe UI" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Steps -->
                        <StackPanel Margin="26,20,26,4">
                            <!-- 1. Resume -->
                            <Grid Margin="0,0,0,17">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                        Background="#2C3A54" Margin="0,0,15,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="#C6D4E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Upload your resume" Foreground="#EAF1F8"
                                               FontSize="13.5" FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Answers use your real experience, projects and tools."
                                               Foreground="#93A9C4" FontSize="11.5" FontWeight="SemiBold"
                                               FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 2. Company -->
                            <Grid Margin="0,0,0,17">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                        Background="#2C3A54" Margin="0,0,15,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="#C6D4E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Add the company &amp; role" Foreground="#EAF1F8"
                                               FontSize="13.5" FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Tailors answers to this role."
                                               Foreground="#93A9C4" FontSize="11.5" FontWeight="SemiBold"
                                               FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 3. Stealth -->
                            <Grid Margin="0,0,0,17">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                        Background="#33280F" Margin="0,0,15,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="#F3C64D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Check capture protection before the call" Foreground="#EAF1F8"
                                               FontSize="13.5" FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Hides the app from screen sharing. Support varies, so check it in your meeting app first."
                                               Foreground="#93A9C4" FontSize="11.5" FontWeight="SemiBold"
                                               FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 4. Space (last — the action you take in the interview) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                        Background="#2C3A54" Margin="0,0,15,0" VerticalAlignment="Top">
