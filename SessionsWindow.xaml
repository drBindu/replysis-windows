<Window x:Class="InterviewCopilot.SessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Interview Sessions"
        Height="540" Width="840"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="#0C0E1E"/>
            <Setter Property="Foreground" Value="#C3D2E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#28FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14142C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#50FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#35171D"/>
            <Setter Property="Foreground" Value="#FF858C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#91424B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#52212A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SessionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBd" Background="#0C0E1E"
                                BorderBrush="#28FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="14,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#14142C"/>
                                <Setter TargetName="ItemBd" Property="BorderBrush" Value="#50FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#1A1A40"/>
                                <Setter TargetName="ItemBd" Property="BorderBrush" Value="#70FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#08091A" CornerRadius="18"
            BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── HEADER ── -->
            <Border Grid.Row="0" Background="#A0060810" CornerRadius="18,18,0,0"
                    BorderBrush="#28FFFFFF" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: icon + title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#20FFFFFF" CornerRadius="8" Width="32" Height="32" Margin="0,0,12,0">
                            <TextBlock Text="📋" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="My Interview Sessions" Foreground="White"
                                       FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="SubtitleLabel" Text="Loading sessions..."
                                       Foreground="#4b5563" FontSize="10" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: close button -->
                    <Button Grid.Column="2" Content="✕" Click="CloseBtn_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#6b7280" FontSize="16" Cursor="Hand" Padding="8,4"/>
                </Grid>
            </Border>

            <!-- ── BODY ── -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Sessions list -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sessions list -->
                    <Border Grid.Row="0" Background="#0A0C1C" CornerRadius="12"
                            BorderBrush="#28FFFFFF" BorderThickness="1">
                        <Grid>
                            <!-- Empty state -->
                            <StackPanel x:Name="EmptyState" VerticalAlignment="Center"
                                        HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="📭" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="No sessions yet" Foreground="#6b7280"
                                           FontSize="13" FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Sessions are saved automatically" Foreground="#3d4d5f"
                                           FontSize="11" FontFamily="Segoe UI"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- List -->
                            <ListBox x:Name="SessionsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource SessionItemStyle}"
                                     SelectionChanged="SessionsList_SelectionChanged"
                                     Padding="10">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="6"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="4"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <TextBlock Text="🎙" FontSize="12" Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           Foreground="White" FontSize="13"
                                                           FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="2" Text="{Binding DisplayDate}"
                                                       Foreground="#38BDF8" FontSize="11"
                                                       FontFamily="Segoe UI"/>

                                            <StackPanel Grid.Row="4" Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayStats}"
                                                           Foreground="#4ade80" FontSize="10"
                                                           FontFamily="Segoe UI" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding DisplayModel}"
                                                           Foreground="#4b5563" FontSize="10"
                                                           FontFamily="Segoe UI"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Delete button -->
                    <Button x:Name="DeleteBtn" Grid.Row="1"
                            Content="🗑  Delete Session"
                            Style="{StaticResource DangerBtn}"
                            Click="DeleteBtn_Click"
                            Padding="14,8" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            Visibility="Collapsed"/>
                </Grid>

                <!-- Splitter -->
                <Border Grid.Column="1" Width="1" Background="#25FFFFFF" VerticalAlignment="Stretch" Margin="0,4"/>

                <!-- RIGHT: Transcript viewer -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Session detail header -->
                    <Border Grid.Row="0" x:Name="DetailHeader"
                            Background="#0C0E1E" CornerRadius="12"
                            BorderBrush="#28FFFFFF" BorderThickness="1"
                            Padding="16,10" Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="DetailTitle" Text="" Foreground="White"
                                           FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="DetailMeta" Text="" Foreground="#6b7280"
                                           FontSize="11" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="CopyTranscriptBtn"
                                        Content="📋 Copy Text"
                                        Style="{StaticResource GhostBtn}"
                                        Click="CopyTranscriptBtn_Click"
                                        Padding="12,6" Margin="0,0,8,0"/>
                                <Button x:Name="ExportBtn"
                                        Content="⬇ Export .txt"
                                        Style="{StaticResource GhostBtn}"
                                        Click="ExportBtn_Click"
                                        Padding="12,6"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Transcript -->
                    <Border Grid.Row="1" Background="#0A0C1C" CornerRadius="12"
                            BorderBrush="#25FFFFFF" BorderThickness="1">
                        <!-- Grid wrapper — Border can only hold one child -->
                        <Grid>
                            <!-- Placeholder when nothing selected -->
                            <StackPanel x:Name="NoSelectionState"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="←" Foreground="#4b5563" FontSize="32"
                                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="Select a session to view its transcript"
                                           Foreground="#6b7280" FontSize="13"
                                           FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Transcript scroll view -->
                            <ScrollViewer x:Name="TranscriptScroll"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="20,16"
                                          Visibility="Collapsed">
                                <StackPanel x:Name="TranscriptPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
